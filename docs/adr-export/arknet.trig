    <http://purl.org/dc/terms/identifier> "ADR-41";
    <http://www.w3.org/ns/prov#specializationOf> <https://w3id.org/arknet/id/25f15589-6262-4b60-8afe-b8312977b098>;
    <http://www.w3.org/ns/prov#wasGeneratedBy> <https://w3id.org/arknet/activity/0801276a-6f7f-42d4-9ac3-43902b8be20e>;
