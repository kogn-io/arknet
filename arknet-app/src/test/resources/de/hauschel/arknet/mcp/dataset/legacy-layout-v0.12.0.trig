<https://w3id.org/arknet/model/constraints> {
  <https://w3id.org/arknet/id/7cfb887e-9798-4e60-92a6-4bc400a5ead5> a <https://w3id.org/arknet/requirements#RegulatoryConstraint>;
    <http://purl.org/dc/terms/identifier> "RCON-1";
    <http://purl.org/dc/terms/title> "EU hosting"@en;
    <https://w3id.org/arknet/requirements#constraintStatement> "Parcel data must stay in the EU (regulator)."@en .
  
  <https://w3id.org/arknet/id/1ff53391-0470-4266-9816-fb8f30561a39> a <https://w3id.org/arknet/requirements#TechnicalConstraint>;
    <http://purl.org/dc/terms/identifier> "TCON-1";
    <http://purl.org/dc/terms/title> "JVM platform"@en;
    <https://w3id.org/arknet/requirements#constraintStatement> "Must run on the JVM (customer platform standard)."@en .
}

<https://w3id.org/arknet/model/requirements> {
  <https://w3id.org/arknet/id/09da3aaf-57f5-4335-a337-c9e17324ae4c> a <https://w3id.org/arknet/requirements#FunctionalRequirement>;
    <http://purl.org/dc/terms/identifier> "FR-1";
    <http://purl.org/dc/terms/title> "Track parcel"@en;
    <http://purl.org/dc/terms/description> "The system shall show the current location of a parcel."@en;
    <https://w3id.org/arknet/requirements#status> <https://w3id.org/arknet/requirements#Proposed>;
    <https://w3id.org/arknet/requirements#rationale> "So that a recipient can plan to be at home."@en;
    <https://w3id.org/arknet/requirements#priority> <https://w3id.org/arknet/requirements#MustHave>;
    <https://w3id.org/arknet/requirements#usesTerm> <https://w3id.org/arknet/id/75db2185-7cd7-417d-a1e2-6d971906ef27>;
    <https://w3id.org/arknet/requirements#acceptanceCriterion> <https://w3id.org/arknet/id/08687d46-875b-482c-9650-e913b18a6653>,
      <https://w3id.org/arknet/id/65755fab-178c-41cd-b73f-246887e0ea63>;
    <http://open-services.net/ns/rm#constrainedBy> <https://w3id.org/arknet/id/7cfb887e-9798-4e60-92a6-4bc400a5ead5> .
  
  <https://w3id.org/arknet/id/9cce6f3e-92ad-4fe5-bab7-5f1b38e7404a> a <https://w3id.org/arknet/requirements#NonFunctionalRequirement>;
    <http://purl.org/dc/terms/identifier> "NFR-1";
    <http://purl.org/dc/terms/title> "Fast lookup"@en;
    <http://purl.org/dc/terms/description> "The system shall answer a tracking lookup within one second."@en;
    <https://w3id.org/arknet/requirements#status> <https://w3id.org/arknet/requirements#Proposed>;
    <https://w3id.org/arknet/requirements#priority> <https://w3id.org/arknet/requirements#ShouldHave>;
    <https://w3id.org/arknet/requirements#usesTerm> <https://w3id.org/arknet/id/75db2185-7cd7-417d-a1e2-6d971906ef27>,
      <https://w3id.org/arknet/id/2f75031c-504e-40c0-9214-5191a4f70341>;
    <https://w3id.org/arknet/requirements#acceptanceCriterion> <https://w3id.org/arknet/id/70087334-9fb0-422c-b1ea-356ffeafcea6>;
    <https://w3id.org/arknet/requirements#qualityCategory> "performance";
    <http://open-services.net/ns/rm#constrainedBy> <https://w3id.org/arknet/id/1ff53391-0470-4266-9816-fb8f30561a39> .
  
  <https://w3id.org/arknet/id/08687d46-875b-482c-9650-e913b18a6653> a <https://w3id.org/arknet/requirements#AcceptanceCriterion>;
    <https://w3id.org/arknet/requirements#position> 1;
    <https://w3id.org/arknet/requirements#criterionText> "Done when the location is shown within one click."@en .
  
  <https://w3id.org/arknet/id/65755fab-178c-41cd-b73f-246887e0ea63> a <https://w3id.org/arknet/requirements#AcceptanceCriterion>;
    <https://w3id.org/arknet/requirements#position> 2;
    <https://w3id.org/arknet/requirements#criterionText> "Done when an unknown code is reported."@en .
  
  <https://w3id.org/arknet/id/70087334-9fb0-422c-b1ea-356ffeafcea6> a <https://w3id.org/arknet/requirements#AcceptanceCriterion>;
    <https://w3id.org/arknet/requirements#position> 1;
    <https://w3id.org/arknet/requirements#criterionText> "Done when the 95th percentile stays below one second."@en .
}

<https://w3id.org/arknet/model/actors> {
  <https://w3id.org/arknet/id/f385d2ca-0162-436d-a65f-7b31a6f7f728> a <https://w3id.org/arknet/process#HumanActor>;
    <http://purl.org/dc/terms/identifier> "ACTOR-1";
    <https://w3id.org/arknet/core#name> "Recipient"@en;
