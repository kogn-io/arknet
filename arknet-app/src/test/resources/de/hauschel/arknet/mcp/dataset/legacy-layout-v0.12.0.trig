<https://w3id.org/arknet/model/use-cases> {
  <https://w3id.org/arknet/id/f21fa8b7-23f8-4395-9af5-40acf8dbba38> a <https://w3id.org/arknet/requirements#UseCase>;
    <http://purl.org/dc/terms/identifier> "UC1";
    <http://purl.org/dc/terms/title> "Track a parcel"@en;
    <https://w3id.org/arknet/requirements#usesTerm> <https://w3id.org/arknet/id/75db2185-7cd7-417d-a1e2-6d971906ef27>;
    <http://open-services.net/ns/rm#constrainedBy> <https://w3id.org/arknet/id/7cfb887e-9798-4e60-92a6-4bc400a5ead5>;
    <https://w3id.org/arknet/requirements#useCaseGoal> "The recipient learns where the parcel is."@en,
      "Der Empfaenger erfaehrt, wo das Paket ist."@de;
    <https://w3id.org/arknet/requirements#designScope> "Tracking service"@en;
    <https://w3id.org/arknet/requirements#trigger> "The recipient enters a tracking code."@en;
    <https://w3id.org/arknet/requirements#useCasePrecondition> "The parcel has been handed over."@en;
    <https://w3id.org/arknet/requirements#useCasePostcondition> "The location is shown."@en;
    <https://w3id.org/arknet/requirements#primaryRole> <https://w3id.org/arknet/id/cc4c2420-a27b-437f-9109-a964067f92e8>;
    <https://w3id.org/arknet/requirements#supportingRole> <https://w3id.org/arknet/id/a6bc107c-c254-4d3e-b460-fcdb77fe475f>;
    <https://w3id.org/arknet/requirements#mainStep> <https://w3id.org/arknet/id/11fa3957-6d1d-4c7c-b8ae-be2d5d2b17e6>,
      <https://w3id.org/arknet/id/77966b20-3ee5-4da6-91cd-4be9844b2279>;
    <http://open-services.net/ns/rm#satisfies> <https://w3id.org/arknet/id/09da3aaf-57f5-4335-a337-c9e17324ae4c>;
    <https://w3id.org/arknet/requirements#extensionStep> <https://w3id.org/arknet/id/952bdf8b-e8f0-48c7-a0de-63a99b52f55b> .
  
  <https://w3id.org/arknet/id/11fa3957-6d1d-4c7c-b8ae-be2d5d2b17e6> a <https://w3id.org/arknet/requirements#Step>;
    <https://w3id.org/arknet/requirements#position> 1;
    <https://w3id.org/arknet/requirements#stepText> "The recipient enters the tracking code."@en .
  
  <https://w3id.org/arknet/id/77966b20-3ee5-4da6-91cd-4be9844b2279> a <https://w3id.org/arknet/requirements#Step>;
    <https://w3id.org/arknet/requirements#position> 2;
    <https://w3id.org/arknet/requirements#stepText> "The system shows the location."@en;
    <https://w3id.org/arknet/requirements#stepRealises> <https://w3id.org/arknet/id/09da3aaf-57f5-4335-a337-c9e17324ae4c> .
  
  <https://w3id.org/arknet/id/952bdf8b-e8f0-48c7-a0de-63a99b52f55b> a <https://w3id.org/arknet/requirements#Step>;
    <https://w3id.org/arknet/requirements#position> 1;
    <https://w3id.org/arknet/requirements#stepText> "2a. Unknown code -> the system reports it and the use case ends."@en .
}

<https://w3id.org/arknet/model/bounded-context> {
