<https://w3id.org/arknet/model/adr> {
  <https://w3id.org/arknet/id/8ffacc5e-321f-4f8e-b5cf-0bb458f7ee68> a <https://w3id.org/arknet/architecture#ArchitectureDecisionRecord>;
    <http://purl.org/dc/terms/identifier> "ADR-1";
    <https://w3id.org/arknet/core#name> "Store tracking events append-only"@en;
    <https://w3id.org/arknet/architecture#adrStatus> <https://w3id.org/arknet/architecture#Superseded>;
    <https://w3id.org/arknet/architecture#adrContext> "Tracking needs the full event history of a parcel."@en;
    <https://w3id.org/arknet/architecture#adrDecision> "Tracking events are stored append-only."@en;
    <https://w3id.org/arknet/architecture#consequence> <https://w3id.org/arknet/id/004c1512-46ff-43b7-b532-6a9396556640>,
      <https://w3id.org/arknet/id/b230d115-e2e4-44bb-b7c7-88a8cfdd01e2>;
    <https://w3id.org/arknet/architecture#consideredOption> <https://w3id.org/arknet/id/9c1a10cd-757a-4e8c-b924-661756229174>,
      <https://w3id.org/arknet/id/60ac45f6-b35d-44e2-980f-7dc7316027e2>;
    <https://w3id.org/arknet/architecture#addressesRequirement> <https://w3id.org/arknet/id/09da3aaf-57f5-4335-a337-c9e17324ae4c>;
    <https://w3id.org/arknet/architecture#affectsContext> <https://w3id.org/arknet/id/55405968-3663-4518-a1c9-c455c77b19b5>;
    <https://w3id.org/arknet/architecture#usesTerm> <https://w3id.org/arknet/id/75db2185-7cd7-417d-a1e2-6d971906ef27>;
    <https://w3id.org/arknet/architecture#decisionDate> "2026-01-15"^^<http://www.w3.org/2001/XMLSchema#date>;
    <https://w3id.org/arknet/architecture#supersededBy> <https://w3id.org/arknet/id/bd7e8039-0a9b-4403-83c6-90bb2fe3a186> .
  
  <https://w3id.org/arknet/id/dc39b18d-4fe1-445c-b61d-2a19d18df7ed> a <https://w3id.org/arknet/architecture#ArchitectureDecisionRecord>;
    <http://purl.org/dc/terms/identifier> "ADR-2";
    <https://w3id.org/arknet/core#name> "Cache the latest location"@en;
    <https://w3id.org/arknet/architecture#adrStatus> <https://w3id.org/arknet/architecture#Proposed>;
    <https://w3id.org/arknet/architecture#adrContext> "Lookups must answer within one second."@en;
    <https://w3id.org/arknet/architecture#adrDecision> "The latest location of each parcel is cached."@en;
    <https://w3id.org/arknet/architecture#consequence> <https://w3id.org/arknet/id/f757b5b7-06c3-49fa-873b-b16230f420a3>;
    <https://w3id.org/arknet/architecture#addressesRequirement> <https://w3id.org/arknet/id/9cce6f3e-92ad-4fe5-bab7-5f1b38e7404a>;
    <https://w3id.org/arknet/architecture#relatedTo> <https://w3id.org/arknet/id/8ffacc5e-321f-4f8e-b5cf-0bb458f7ee68> .
  
  <https://w3id.org/arknet/id/f757b5b7-06c3-49fa-873b-b16230f420a3> a <https://w3id.org/arknet/architecture#Consequence>;
    <https://w3id.org/arknet/core#position> 1;
    <https://w3id.org/arknet/architecture#consequenceType> <https://w3id.org/arknet/architecture#Positive>;
    <https://w3id.org/arknet/architecture#consequenceStatement> "Lookups are fast."@en .
  
  <https://w3id.org/arknet/id/bd7e8039-0a9b-4403-83c6-90bb2fe3a186> a <https://w3id.org/arknet/architecture#ArchitectureDecisionRecord>;
    <http://purl.org/dc/terms/identifier> "ADR-3";
    <https://w3id.org/arknet/core#name> "Store tracking events in a time-series store"@en;
    <https://w3id.org/arknet/architecture#adrStatus> <https://w3id.org/arknet/architecture#Accepted>;
    <https://w3id.org/arknet/architecture#adrContext> "The append-only store grew too large."@en;
    <https://w3id.org/arknet/architecture#adrDecision> "Tracking events move to a time-series store."@en;
    <https://w3id.org/arknet/architecture#consideredOption> <https://w3id.org/arknet/id/aef5300e-e959-447e-8ca2-de888f22bf57>;
    <https://w3id.org/arknet/architecture#affectsContext> <https://w3id.org/arknet/id/55405968-3663-4518-a1c9-c455c77b19b5>;
    <https://w3id.org/arknet/architecture#decisionDate> "2026-03-01"^^<http://www.w3.org/2001/XMLSchema#date> .
  
  <https://w3id.org/arknet/id/aef5300e-e959-447e-8ca2-de888f22bf57> a <https://w3id.org/arknet/architecture#ConsideredOption>;
    <https://w3id.org/arknet/core#name> "Time-series store"@en;
    <https://w3id.org/arknet/core#position> 1;
    <https://w3id.org/arknet/architecture#optionRationale> "Compacts old events."@en;
    <https://w3id.org/arknet/architecture#optionOutcome> <https://w3id.org/arknet/architecture#Chosen> .
  
  <https://w3id.org/arknet/id/004c1512-46ff-43b7-b532-6a9396556640> a <https://w3id.org/arknet/architecture#Consequence>;
    <https://w3id.org/arknet/core#position> 1;
    <https://w3id.org/arknet/architecture#consequenceType> <https://w3id.org/arknet/architecture#Positive>;
    <https://w3id.org/arknet/architecture#consequenceStatement> "The history is never lost."@en .
  
  <https://w3id.org/arknet/id/b230d115-e2e4-44bb-b7c7-88a8cfdd01e2> a <https://w3id.org/arknet/architecture#Consequence>;
    <https://w3id.org/arknet/core#position> 2;
    <https://w3id.org/arknet/architecture#consequenceType> <https://w3id.org/arknet/architecture#Negative>;
    <https://w3id.org/arknet/architecture#consequenceStatement> "Storage grows without bound."@en .
  
  <https://w3id.org/arknet/id/9c1a10cd-757a-4e8c-b924-661756229174> a <https://w3id.org/arknet/architecture#ConsideredOption>;
    <https://w3id.org/arknet/core#name> "Append-only log"@en;
    <https://w3id.org/arknet/core#position> 1;
    <https://w3id.org/arknet/architecture#optionRationale> "Keeps every event."@en;
    <https://w3id.org/arknet/architecture#optionOutcome> <https://w3id.org/arknet/architecture#Chosen> .
  
  <https://w3id.org/arknet/id/60ac45f6-b35d-44e2-980f-7dc7316027e2> a <https://w3id.org/arknet/architecture#ConsideredOption>;
    <https://w3id.org/arknet/core#name> "Overwrite current state"@en;
    <https://w3id.org/arknet/core#position> 2;
    <https://w3id.org/arknet/architecture#optionRationale> "Loses the history."@en;
    <https://w3id.org/arknet/architecture#optionOutcome> <https://w3id.org/arknet/architecture#OptionRejected> .
}

