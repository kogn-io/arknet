<?xml version="1.0" encoding="UTF-8"?>
<!--
  Long-running daemon (issue #137): logs go to stderr so a foreground/nohup-launched
  process keeps its stdout free for shell redirection, e.g. into a log file.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
