PREFIX arknet: <https://w3id.org/arknet/core#>

SELECT ?ctxUri ?aggName ?rootName ?entityName ?voName ?cmdName ?eventName ?invariantName ?invariantExpr
WHERE {
  ?ctxUri a arknet:BoundedContext ;
          arknet:hasAggregate ?agg .
  ?agg arknet:name ?aggName .
  OPTIONAL { ?agg arknet:aggregateRoot ?root . ?root arknet:name ?rootName . }
  OPTIONAL { ?agg arknet:hasEntity ?ent . ?ent arknet:name ?entityName . }
  OPTIONAL { ?agg arknet:hasValueObject ?vo . ?vo arknet:name ?voName . }
  OPTIONAL { ?agg arknet:hasCommand ?cmd . ?cmd arknet:name ?cmdName . }
  OPTIONAL { ?agg arknet:hasEvent ?evt . ?evt arknet:name ?eventName . }
  OPTIONAL {
    ?agg arknet:hasInvariant ?inv .
    ?inv arknet:name ?invariantName .
    OPTIONAL { ?inv arknet:invariantExpression ?invariantExpr . }
  }
}
ORDER BY ?ctxUri ?aggName
