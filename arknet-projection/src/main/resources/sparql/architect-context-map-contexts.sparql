PREFIX arknet: <https://w3id.org/arknet/core#>

SELECT ?contextName ?domainVision ?subdomainType ?ownedBy ?responsibilities
WHERE {
  ?ctx a arknet:BoundedContext ;
       arknet:name ?contextName ;
       arknet:domainVision ?domainVision .

  OPTIONAL { ?ctx arknet:subdomain ?subdomainType . }
  OPTIONAL { ?ctx arknet:ownedBy ?ownedBy . }
  OPTIONAL { ?ctx arknet:responsibilities ?responsibilities . }
}
ORDER BY ?subdomainType ?contextName
