PREFIX arknet: <https://w3id.org/arknet/core#>

SELECT ?upstreamName ?downstreamName ?relType
WHERE {
  ?rel a arknet:ContextRelationship ;
       arknet:upstream ?up ;
       arknet:downstream ?down ;
       arknet:relationshipType ?relType .

  ?up arknet:name ?upstreamName .
  ?down arknet:name ?downstreamName .
}
ORDER BY ?upstreamName ?downstreamName
