<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.hauschel.arknet</groupId>
        <artifactId>arknet-requirements</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>requirements-adapter-mcp</artifactId>
    <description>In-Adapter (driving): uebersetzt MCP-Tool-Calls auf die requirements-core In-Ports. Liefert Tool-Specs an eine Composition Root (arknet-mcp).</description>

    <!-- Ueberschreibt lokal (nur fuer dieses Modul) zwei Versionen, die arknet-parent auf
         aeltere Werte pinnt (fuer den noch-raw-SDK arknet-mcp, separat spaeter migriert):
         - mcp-core: arknet-parent pinnt 1.1.0 (mcp-sdk.version); spring-ai-mcp-annotations:2.0.0
           ist aber gegen mcp-core:2.0.0 kompiliert (transitiv ueber io.modelcontextprotocol.sdk:mcp).
           Ohne dieses Override wuerde Dependency-Mediation die 1.1.0-API erzwingen -> Risiko von
           NoSuchMethodError zur Laufzeit gegen den 2.0.0-Bytecode von spring-ai-mcp-annotations.
         - jackson-annotations: mcp-core:1.1.0 zieht die veraltete 2.13.5 herein, die noch kein
           JsonSerializeAs kennt; jackson3 (tools.jackson:jackson-databind, von spring-ai-model
           genutzt) braucht >=2.21 (siehe jackson-bom:3.1.4). -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-core</artifactId>
                <version>2.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>2.21</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>requirements-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-mcp-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
