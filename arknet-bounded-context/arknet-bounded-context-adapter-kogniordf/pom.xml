<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.hauschel.arknet</groupId>
        <artifactId>arknet-bounded-context</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>arknet-bounded-context-adapter-kogniordf</artifactId>
    <description>Out-adapter: implements BoundedContextRepository on top of kognio-rdf (embeddable RDF substrate). Bounded contexts are persisted as arknet:BoundedContext.</description>

    <dependencies>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-bounded-context-core</artifactId>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-persistence-support</artifactId>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-ontology</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-terms</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-dataset</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-dataset-rdf4j</artifactId>
        </dependency>
        <!-- DatasetLifecycle/DatasetHandle/DatasetId/DatasetStoreConfig and their RDF4J
             implementation live in these dedicated hosting port/adapter modules since
             kognio-rdf 0.2.x (#173). -->
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-dataset-hosting</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-dataset-hosting-rdf4j</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-shacl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-shacl-rdf4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-rio-turtle</artifactId>
        </dependency>
        <!-- Explizit statt nur transitiv (ueber rdf4j) - #81: WARN-Log bei mehrwertigen,
             stillschweigend auf den ersten Wert reduzierten Feldern (subdomain/ownedBy ohne
             durchsetzbaren sh:maxCount). Version aus dem rdf4j-bom gemanaged. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Test-only: KognioRdfTermLookup hardcodes the ubiquitous-language out-adapter's
             private storage schema (graph IRI, skos:Concept, dcterms:identifier) with no
             compile-time coupling between the two adapter modules. This dependency lets a schema
             test write a term through the ul-BC's actual KognioRdfTermRepository and resolve it
             through this module's actual KognioRdfTermLookup against the same store - the
             substitute regression signal for a future schema drift (mirrors the requirements
             adapter's KognioRdfTermLookupUbiquitousLanguageSchemaTest, issue #109). Transitively
             pulls in arknet-ubiquitous-language-core (compile scope there) as a test-scope
             dependency. -->
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-ubiquitous-language-adapter-kogniordf</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Test-only: the shared DatasetLifecycle/DatasetHandle/DatasetTx decorators
             BoundedContextServiceRealStoreConcurrencyTest uses to pin the interleaving of two
             writers against a real on-disk store (#117). A normal main-scope artifact consumed
             at test scope - this codebase uses no test-jar classifier anywhere. -->
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-persistence-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test-only: no SLF4J binding is otherwise on this module's classpath (WARN calls are
             silent NOP-logger no-ops without it), so the row-multiplication regression test (#158)
             needs a real backend to attach a ListAppender to and assert the WARN was actually
             logged, not merely that the picked value happens to be valid. Version matches
             arknet-mcp's (the only other module pulling logback-classic in). -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.6.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
