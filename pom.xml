<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.hauschel.arknet</groupId>
    <artifactId>arknet-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>arknet - Architecture Knowledge Net</name>
    <description>DDD architectural models that machines can understand.</description>
    <url>https://github.com/kogn-io/arknet</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Fred Hauschel</name>
            <email>info@hauschel.de</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/kogn-io/arknet.git</connection>
        <developerConnection>scm:git:git@github.com:kogn-io/arknet.git</developerConnection>
        <url>https://github.com/kogn-io/arknet</url>
    </scm>

    <properties>
        <revision>0.1.0-SNAPSHOT</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 25 (nicht 21): io.kogn.rdf-Artefakte sind mit Java 25 (Classfile 69) gebaut;
             release 21 kann nicht gegen sie kompilieren. arknet zieht mit (Entscheidung
             2026-07-16, #68). -->
        <maven.compiler.release>25</maven.compiler.release>
        <!-- 6.0.0 (nicht 5.2.2): Voraussetzung fuer io.kogn.rdf:rdf-shacl-rdf4j, das
             gegen RDF4J 6.0.0 gebaut ist (ShaclValidator.builder() existiert erst dort).
             Der Bump ist bewusst als eigener Schritt getrennt vom SHACL-Write-Gate (#38). -->
        <rdf4j.version>6.0.0</rdf4j.version>
        <asciidoctorj.version>3.0.0</asciidoctorj.version>
        <asciidoctorj-diagram.version>3.1.0</asciidoctorj-diagram.version>
        <mustache.version>0.9.14</mustache.version>
        <slf4j.version>2.0.16</slf4j.version>
        <junit.version>6.1.2</junit.version>
        <!-- ArchUnit: nagelt in arknet-architecture-tests die Dependency-Invarianten fest,
             die der Modulschnitt NICHT erzwingen kann (#60). Kein BOM-Artefakt vorhanden,
             daher hier gepinnt. -->
        <archunit.version>1.4.2</archunit.version>
        <!-- Spring AI 2.0 ist die Tech-Linie fuer arknets MCP-Layer (siehe ADR-Kandidat).
             Version konsistent zu kogn-io/kognio-memory (Schwesterprojekt) uebernommen.
             Die Spring-AI-BOM managed den kompletten MCP-Stack transitiv (u.a. mcp-core 2.0.0),
             deshalb wird die MCP-SDK-Version hier NICHT mehr separat gepinnt (loest #27:
             frueher pinnte arknet mcp-core auf 1.1.0 -> Doppelversion im Reaktor). -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <!-- Spring Boot 4.1 = Baseline von Spring AI 2.0 (arknet-mcp Composition Root). -->
        <spring-boot.version>4.1.0</spring-boot.version>
        <!-- kognio-rdf (io.kogn.rdf): embeddable RDF-Substrat hinter den Out-Ports.
             OSS auf github.com/kogn-io/rdf-core; kein BOM-Artefakt -> Version hier gepinnt.
             0.1.1 brachte kogn-io/rdf-core#18: Transaktionen oeffnen jetzt explizit mit
             IsolationLevels.SERIALIZABLE statt dem alten SNAPSHOT_READ-Default, wodurch
             echt ueberlappende Schreibtransaktionen beim commit() mit einer
             RepositoryException (Ursache SailConflictException) statt still kollidieren (#144).
             0.2.1 ist ein Release (Maven Central, kein Snapshot); Breaking Changes gegenueber
             0.1.1 und ihre arknet-seitige Migration: #173. -->
        <kognio-rdf.version>0.2.1</kognio-rdf.version>
        <spotless-maven-plugin.version>3.8.0</spotless-maven-plugin.version>
    </properties>

    <modules>
        <module>arknet-ontology</module>
        <module>arknet-mcp</module>
        <module>arknet-shared-kernel</module>
        <module>arknet-persistence-support</module>
        <module>arknet-requirements</module>
        <module>arknet-ubiquitous-language</module>
        <module>arknet-use-cases</module>
        <module>arknet-bounded-context</module>
        <module>arknet-project</module>
        <module>arknet-architecture-tests</module>
    </modules>

    <repositories>
        <repository>
            <id>central-portal-snapshots</id>
            <name>Central Portal Snapshots</name>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- Shared Kernel: von mehreren Bounded Contexts (requirements, ubiquitous-language)
                 geteilte Domain-Bausteine (WorkspaceId). Version zentral hier gemanaged. -->
            <dependency>
                <groupId>de.hauschel.arknet</groupId>
                <artifactId>arknet-shared-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Technischer Support fuer die kognio-rdf-Out-Adapter (SHACL-Write-Gate), von
                 requirements, ubiquitous-language und use-cases geteilt. Getrennt vom
                 Shared Kernel, weil hier Technik statt Domain-Vokabular wohnt (#52). -->
            <dependency>
                <groupId>de.hauschel.arknet</groupId>
                <artifactId>arknet-persistence-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- jackson-annotations ausgeschlossen: rdf4j-bom managed selbst 2.21, obwohl
                 RDF4J 6.0.0s eigene Module (z.B. rdf4j-rio-api) transitiv 2.22 anfordern;
                 RDF4J-intern-inkonsistent, niemand im Reaktor braucht das gemanagte 2.21.
                 Ohne die BOM-Bevormundung resolved jackson-annotations von selbst auf 2.22
                 (aus RDF4J 6.0.0s eigenem Transitivgraphen), was jackson-databind 3.2.0
                 (jackson3, vom Spring-AI-MCP-JsonMapper genutzt) braucht (JsonApplyView),
                 sonst NoClassDefFoundError beim ersten MCP-JSON-Response (#117). -->
            <dependency>
                <groupId>org.eclipse.rdf4j</groupId>
                <artifactId>rdf4j-bom</artifactId>
                <version>${rdf4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
                <exclusions>
                    <exclusion>
                        <groupId>com.fasterxml.jackson.core</groupId>
                        <artifactId>jackson-annotations</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- Spring AI 2.0 BOM: managed einheitliche Versionen fuer den Spring-AI-MCP-Stack
                 (u.a. spring-ai-mcp-annotations), analog zu kognio-mcp. -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Boot BOM zuletzt importiert: die zuvor deklarierten BOMs (rdf4j, junit,
                 spring-ai) gewinnen bei Ueberschneidungen, sodass die bestehenden Modul-Versionen
                 unangetastet bleiben. arknet-mcp (Spring-Boot-stdio-Server) zieht daraus die
                 einheitlichen Spring-Boot-4.1-Versionen. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- kognio-rdf: kein BOM-Artefakt vorhanden, daher die drei Module einzeln
                 auf ${kognio-rdf.version} gepinnt. -->
            <dependency>
                <groupId>io.kogn.rdf</groupId>
                <artifactId>rdf-terms</artifactId>
                <version>${kognio-rdf.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kogn.rdf</groupId>
                <artifactId>rdf-dataset</artifactId>
                <version>${kognio-rdf.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kogn.rdf</groupId>
                <artifactId>rdf-dataset-rdf4j</artifactId>
                <version>${kognio-rdf.version}</version>
            </dependency>
            <!-- 0.2.x split DatasetLifecycle/DatasetHandle/DatasetId/DatasetStoreConfig out of
                 rdf-dataset into this dedicated hosting port module (#173). -->
            <dependency>
                <groupId>io.kogn.rdf</groupId>
                <artifactId>rdf-dataset-hosting</artifactId>
                <version>${kognio-rdf.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kogn.rdf</groupId>
                <artifactId>rdf-dataset-hosting-rdf4j</artifactId>
                <version>${kognio-rdf.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kogn.rdf</groupId>
                <artifactId>rdf-shacl</artifactId>
                <version>${kognio-rdf.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kogn.rdf</groupId>
                <artifactId>rdf-shacl-rdf4j</artifactId>
                <version>${kognio-rdf.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <!-- Erhaelt die Methodenparameter-Namen im Bytecode. Spring AI leitet
                             die MCP-Tool-Argumentnamen aus @McpToolParam-Parametern ab; ohne
                             -parameters wuerden diese zu arg0/arg1 degradieren. -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.6</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- CI-friendly Versionen: loest ${revision} in den installierten/deployten
                 POMs auf, damit dort kein woertliches ${revision} landet. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.7.3</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- SPDX license header (Apache-2.0) on every .java. Headers only,
                 no formatter: deliberately NOT the full rdf-core Spotless
                 config, to avoid reformatting the whole codebase in this PR. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <java>
                        <licenseHeader>
                            <file>${maven.multiModuleProjectDirectory}/java-license-header.txt</file>
                        </licenseHeader>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
