##############################################################################
#  arknet - Architecture Knowledge Net
#  Architecture SHACL Shapes  :  Version 0.1.0
#
#  Validates arkarch:ArchitectureDecisionRecord only. The remaining
#  ISO-42010 shapes (Architecture, Stakeholder, Concern, Viewpoint, View)
#  have no active consumer yet and live in
#  parked/architecture-shapes_parked.ttl.
#  Core DDD shapes: arknet-shapes.ttl. Requirements: requirements-shapes.ttl.
#
#  Named PropertyShapes fuer RDF4J SHACL Sail Kompatibilitaet.
#  Instanzen nutzen arknet:name (Core-Reuse); ADRs zusaetzlich dcterms:identifier.
##############################################################################

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix arkarch: <https://w3id.org/arknet/architecture#> .
@prefix arknet:  <https://w3id.org/arknet/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix ashapes: <https://w3id.org/arknet/shapes/architecture#> .


##############################################################################
#  ADR SHAPES
##############################################################################

ashapes:ADRShape
    a sh:NodeShape ;
    sh:targetClass arkarch:ArchitectureDecisionRecord ;
    sh:property ashapes:ADR-identifier ;
    sh:property ashapes:ADR-name ;
    sh:property ashapes:ADR-status ;
    sh:property ashapes:ADR-context ;
    sh:property ashapes:ADR-decision ;
    sh:property ashapes:ADR-consequences ;
    sh:property ashapes:ADR-alternatives ;
    sh:property ashapes:ADR-relatedTo ;
    sh:property ashapes:ADR-supersededBy .

ashapes:ADR-identifier
    a sh:PropertyShape ;
    sh:path     dcterms:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 2 ;
    sh:message  "An ADR needs exactly one dcterms:identifier (e.g. ADR-0007)."@en , "ADR braucht genau eine dcterms:identifier (z.B. ADR-0007)."@de ;
    sh:severity sh:Violation .

ashapes:ADR-name
    a sh:PropertyShape ;
    sh:path     arknet:name ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message  "An ADR needs an arknet:name (title of the decision)."@en , "ADR braucht einen arknet:name (Titel der Entscheidung)."@de ;
    sh:severity sh:Violation .

ashapes:ADR-status
    a sh:PropertyShape ;
    sh:path     arkarch:adrStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in       ( arkarch:Proposed arkarch:Accepted arkarch:Rejected
                  arkarch:Deprecated arkarch:Superseded ) ;
    sh:message  "An ADR needs exactly one arkarch:adrStatus (Proposed | Accepted | Rejected | Deprecated | Superseded)."@en , "ADR braucht genau einen arkarch:adrStatus (Proposed | Accepted | Rejected | Deprecated | Superseded)."@de ;
    sh:severity sh:Violation .

ashapes:ADR-context
    a sh:PropertyShape ;
    sh:path     arkarch:adrContext ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 5 ;
    sh:message  "An ADR must have an arkarch:adrContext (why was the decision necessary?)."@en , "ADR muss einen arkarch:adrContext haben (warum war die Entscheidung noetig?)."@de ;
    sh:severity sh:Violation .

ashapes:ADR-decision
    a sh:PropertyShape ;
    sh:path     arkarch:adrDecision ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 5 ;
    sh:message  "An ADR must have an arkarch:adrDecision (what was decided?)."@en , "ADR muss eine arkarch:adrDecision haben (was wurde entschieden?)."@de ;
    sh:severity sh:Violation .

ashapes:ADR-consequences
    a sh:PropertyShape ;
    sh:path     arkarch:adrConsequences ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message  "Best practice: An ADR should document arkarch:adrConsequences (consequences of the decision)."@en , "Best Practice: ADR sollte arkarch:adrConsequences dokumentieren (Folgen der Entscheidung)."@de ;
    sh:severity sh:Warning .

ashapes:ADR-alternatives
    a sh:PropertyShape ;
    sh:path     arkarch:adrAlternatives ;
    sh:datatype xsd:string ;
    sh:message  "Best practice: An ADR should document considered alternatives (arkarch:adrAlternatives)."@en , "Best Practice: ADR sollte erwogene Alternativen (arkarch:adrAlternatives) dokumentieren."@de ;
    sh:severity sh:Warning .

# Zero or more: a decision may relate to any number of peers, and most relate to
# none - hence no sh:minCount and no sh:maxCount. Only the forward edge is ever
# asserted, even though arkarch:relatedTo is an owl:SymmetricProperty.
ashapes:ADR-relatedTo
    a sh:PropertyShape ;
    sh:path     arkarch:relatedTo ;
    sh:nodeKind sh:IRI ;
    sh:class    arkarch:ArchitectureDecisionRecord ;
    sh:message  "An arkarch:relatedTo edge must point at another ADR (arkarch:ArchitectureDecisionRecord) identified by an IRI."@en , "Eine arkarch:relatedTo-Kante muss auf ein anderes ADR (arkarch:ArchitectureDecisionRecord) mit IRI zeigen."@de ;
    sh:severity sh:Violation .

# At most one successor: a decision is superseded by exactly one newer decision
# (kogn-io/arknet#357). Written on the superseded decision itself, together with
# its status transitioning to Superseded - see ashapes:ADR-supersededByImpliesSupersededStatus
# below for the bi-implication between the two.
ashapes:ADR-supersededBy
    a sh:PropertyShape ;
    sh:path     arkarch:supersededBy ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class    arkarch:ArchitectureDecisionRecord ;
    sh:message  "An arkarch:supersededBy edge must point at exactly one other ADR (arkarch:ArchitectureDecisionRecord) identified by an IRI."@en , "Eine arkarch:supersededBy-Kante muss auf genau ein anderes ADR (arkarch:ArchitectureDecisionRecord) mit IRI zeigen."@de ;
    sh:severity sh:Violation .

# Bi-implication: an ADR's status is Superseded if and only if its arkarch:supersededBy edge is
# set - the two are written together in one call (adr_supersede) and must never be found apart.
# Expressed as an anonymous sh:or/sh:not combination rather than the named PropertyShapes this
# file otherwise sticks to: SHACL has no named-shape equivalent for a logical combinator, and the
# nesting is exactly what expresses "both together, or neither" (verified against the real RDF4J
# SHACL engine this project's write gate runs, kogn-io/arknet#357).
# The violation this raises is reported against the ADR node itself (path=null in the report,
# since sh:or has no single property to blame), so the message below is written to stand on its
# own without a property name for context.
ashapes:ADR-supersededByImpliesSupersededStatus
    a sh:NodeShape ;
    sh:targetClass arkarch:ArchitectureDecisionRecord ;
    sh:or (
        [
            sh:property [ sh:path arkarch:supersededBy ; sh:maxCount 0 ] ;
            sh:not [ sh:property [ sh:path arkarch:adrStatus ; sh:hasValue arkarch:Superseded ] ]
        ]
        [
            sh:property [ sh:path arkarch:supersededBy ; sh:minCount 1 ] ;
            sh:property [ sh:path arkarch:adrStatus ; sh:hasValue arkarch:Superseded ]
        ]
    ) ;
    sh:message  "An ADR's status must be Superseded exactly when its arkarch:supersededBy edge is set - both together, or neither."@en , "Der Status einer ADR muss genau dann Superseded sein, wenn ihre arkarch:supersededBy-Kante gesetzt ist -- entweder beide zusammen oder keins von beiden."@de ;
    sh:severity sh:Violation .

# END OF ARCHITECTURE SHAPES
