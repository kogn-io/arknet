##############################################################################
#  arknet – Architecture Knowledge Net
#  SHACL Validation Shapes  ·  Version 0.3.0
#
#  Prinzip: Closed-World-Assumption.
#  Fehlende Pflichtfelder = Fehler in CI/CD, nicht "vielleicht woanders".
#
#  Validates arkddd:BoundedContext and arkddd:ContextRelationship. The
#  Aggregate shape lives in parked/arknet-ddd-shapes.ttl (no active
#  consumer yet).
#
#  Named PropertyShapes fuer RDF4J SHACL Sail Kompatibilitaet.
##############################################################################

@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix arknet: <https://w3id.org/arknet/core#> .
@prefix arkddd: <https://w3id.org/arknet/ddd#> .
@prefix shapes: <https://w3id.org/arknet/shapes#> .


##############################################################################
#  BOUNDED CONTEXT SHAPES
##############################################################################

shapes:BoundedContextShape
    a sh:NodeShape ;
    sh:targetClass arkddd:BoundedContext ;
    sh:property shapes:BoundedContext-name ;
    sh:property shapes:BoundedContext-domainVision ;
    sh:property shapes:BoundedContext-hasAggregate ;
    sh:property shapes:BoundedContext-partOf ;
    sh:property shapes:BoundedContext-ownedBy .

shapes:BoundedContext-name
    a sh:PropertyShape ;
    sh:path     arknet:name ;
    sh:minCount 1 ;
    sh:minLength 2 ;
    sh:uniqueLang true ;
    sh:message  "A BoundedContext needs at least one 'arknet:name' (min. 2 characters) - the context's human-readable name, e.g. 'OrderManagement'. sh:uniqueLang allows at most one arknet:name per non-empty language tag - two names sharing the same tag are not allowed, but DIFFERENT language tags are (a context may be named in several languages)."@en , "Ein BoundedContext braucht mindestens einen 'arknet:name' (min. 2 Zeichen) - den menschenlesbaren Namen des Contexts, z.B. 'OrderManagement'. sh:uniqueLang erlaubt hoechstens einen arknet:name je nicht-leerem Sprach-Tag - zwei Namen mit demselben Tag sind nicht erlaubt, VERSCHIEDENE Sprach-Tags dagegen schon (ein Context darf mehrsprachig benannt sein)."@de ;
    sh:severity sh:Violation .

shapes:BoundedContext-domainVision
    a sh:PropertyShape ;
    sh:path     arkddd:domainVision ;
    sh:minCount 1 ;
    sh:minLength 10 ;
    sh:uniqueLang true ;
    sh:message  "A BoundedContext needs at least one 'arkddd:domainVision' (min. 10 characters) - one sentence: What does this context do? sh:uniqueLang allows at most one arkddd:domainVision per non-empty language tag - two visions sharing the same tag are not allowed, but DIFFERENT language tags are (a context's vision may be stated in several languages)."@en , "Ein BoundedContext braucht mindestens eine 'arkddd:domainVision' (min. 10 Zeichen) - ein Satz: Was leistet dieser Context? sh:uniqueLang erlaubt hoechstens eine arkddd:domainVision je nicht-leerem Sprach-Tag - zwei Visionen mit demselben Tag sind nicht erlaubt, VERSCHIEDENE Sprach-Tags dagegen schon (die Vision eines Contexts darf mehrsprachig formuliert sein)."@de ;
    sh:severity sh:Violation .

shapes:BoundedContext-hasAggregate
    a sh:PropertyShape ;
    sh:path     arkddd:hasAggregate ;
    sh:minCount 1 ;
    sh:class    arkddd:Aggregate ;
    sh:message  "A BoundedContext should have at least one 'arkddd:hasAggregate' (whose value is of type arkddd:Aggregate)."@en , "BoundedContext sollte mindestens ein 'arkddd:hasAggregate' haben (dessen Wert vom Typ arkddd:Aggregate ist)."@de ;
    sh:severity sh:Warning .

shapes:BoundedContext-partOf
    a sh:PropertyShape ;
    sh:path     arkddd:partOf ;
    sh:maxCount 1 ;
    sh:or       ( [ sh:class arkddd:Domain ] [ sh:class arkddd:Subdomain ] ) ;
    sh:message  "A BoundedContext should have 'arkddd:partOf' (a Domain or Subdomain)."@en , "BoundedContext sollte 'arkddd:partOf' (eine Domain oder Subdomain) haben."@de ;
    sh:severity sh:Warning .

shapes:BoundedContext-ownedBy
    a sh:PropertyShape ;
    sh:path     arkddd:ownedBy ;
    sh:message  "A BoundedContext should have 'arkddd:ownedBy' (team name)."@en , "BoundedContext sollte 'arkddd:ownedBy' (Team-Name) haben."@de ;
    sh:severity sh:Warning .


##############################################################################
#  CONTEXT RELATIONSHIP SHAPES
##############################################################################

shapes:ContextRelationshipShape
    a sh:NodeShape ;
    sh:targetClass arkddd:ContextRelationship ;
    sh:property shapes:ContextRelationship-upstream ;
    sh:property shapes:ContextRelationship-downstream ;
    sh:property shapes:ContextRelationship-relationshipType .

shapes:ContextRelationship-upstream
    a sh:PropertyShape ;
    sh:path     arkddd:upstream ;
    sh:minCount 1 ; sh:maxCount 1 ; sh:class arkddd:BoundedContext ;
    sh:message  "ContextRelationship must have exactly one 'arkddd:upstream' BoundedContext."@en , "ContextRelationship muss genau einen 'arkddd:upstream' BoundedContext haben."@de ;
    sh:severity sh:Violation .

shapes:ContextRelationship-downstream
    a sh:PropertyShape ;
    sh:path     arkddd:downstream ;
    sh:minCount 1 ; sh:maxCount 1 ; sh:class arkddd:BoundedContext ;
    sh:message  "ContextRelationship must have exactly one 'arkddd:downstream' BoundedContext."@en , "ContextRelationship muss genau einen 'arkddd:downstream' BoundedContext haben."@de ;
    sh:severity sh:Violation .

shapes:ContextRelationship-relationshipType
    a sh:PropertyShape ;
    sh:path     arkddd:relationshipType ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in       ( arkddd:Partnership arkddd:SharedKernel arkddd:CustomerSupplier
                  arkddd:Conformist arkddd:AnticorruptionLayer
                  arkddd:OpenHostService arkddd:PublishedLanguage
                  arkddd:SeparateWays ) ;
    sh:message  "ContextRelationship must have a valid 'arkddd:relationshipType'."@en , "ContextRelationship muss einen gueltigen 'arkddd:relationshipType' haben."@de ;
    sh:severity sh:Violation .

# END OF SHAPES
