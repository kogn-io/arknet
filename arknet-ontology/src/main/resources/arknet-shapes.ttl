##############################################################################
#  doc42 – Semantische Architekturplattform
#  SHACL-Validierungsregeln  ·  Version 0.1.0
#
#  Prinzip: Closed-World-Assumption.
#  Fehlende Pflichtfelder = Fehler in CI/CD, nicht "vielleicht woanders".
#
#  Named PropertyShapes fuer RDF4J SHACL Sail Kompatibilitaet.
##############################################################################

@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix doc42:  <https://doc42.ddd-forge.dev/ontology#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix shapes: <https://doc42.ddd-forge.dev/shapes#> .


##############################################################################
#  SCHICHT 2 – DDD SHAPES
##############################################################################

# ── BoundedContext ──────────────────────────────────────────────────────────

shapes:BoundedContextShape
    a sh:NodeShape ;
    sh:targetClass doc42:BoundedContext ;
    sh:property shapes:BoundedContext-name ;
    sh:property shapes:BoundedContext-domainVision ;
    sh:property shapes:BoundedContext-hasAggregate ;
    sh:property shapes:BoundedContext-subdomain ;
    sh:property shapes:BoundedContext-ownedBy .

shapes:BoundedContext-name
    a sh:PropertyShape ;
    sh:path     doc42:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 2 ;
    sh:message  "BoundedContext muss genau einen 'doc42:name' haben (min. 2 Zeichen)."@de ;
    sh:severity sh:Violation .

shapes:BoundedContext-domainVision
    a sh:PropertyShape ;
    sh:path     doc42:domainVision ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 10 ;
    sh:message  "BoundedContext muss eine 'doc42:domainVision' haben (min. 10 Zeichen). Formuliere in einem Satz: Was leistet dieser Context?"@de ;
    sh:severity sh:Violation .

shapes:BoundedContext-hasAggregate
    a sh:PropertyShape ;
    sh:path     doc42:hasAggregate ;
    sh:minCount 1 ;
    sh:class    doc42:Aggregate ;
    sh:message  "BoundedContext muss mindestens ein 'doc42:hasAggregate' haben."@de ;
    sh:severity sh:Violation .

shapes:BoundedContext-subdomain
    a sh:PropertyShape ;
    sh:path     doc42:subdomain ;
    sh:maxCount 1 ;
    sh:in       ( doc42:CoreDomain doc42:SupportingDomain doc42:GenericDomain ) ;
    sh:message  "BoundedContext sollte 'doc42:subdomain' (CoreDomain | SupportingDomain | GenericDomain) haben."@de ;
    sh:severity sh:Warning .

shapes:BoundedContext-ownedBy
    a sh:PropertyShape ;
    sh:path     doc42:ownedBy ;
    sh:message  "BoundedContext sollte 'doc42:ownedBy' (Team-Name) haben."@de ;
    sh:severity sh:Warning .


# ── Aggregate ────────────────────────────────────────────────────────────────

shapes:AggregateShape
    a sh:NodeShape ;
    sh:targetClass doc42:Aggregate ;
    sh:property shapes:Aggregate-name ;
    sh:property shapes:Aggregate-aggregateRoot ;
    sh:property shapes:Aggregate-hasCommand ;
    sh:property shapes:Aggregate-hasEvent .

shapes:Aggregate-name
    a sh:PropertyShape ;
    sh:path     doc42:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message  "Aggregate muss einen 'doc42:name' haben."@de ;
    sh:severity sh:Violation .

shapes:Aggregate-aggregateRoot
    a sh:PropertyShape ;
    sh:path     doc42:aggregateRoot ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class    doc42:AggregateRoot ;
    sh:message  "Aggregate muss GENAU EINEN 'doc42:aggregateRoot' haben."@de ;
    sh:severity sh:Violation .

shapes:Aggregate-hasCommand
    a sh:PropertyShape ;
    sh:path     doc42:hasCommand ;
    sh:minCount 1 ;
    sh:message  "Aggregate sollte mindestens einen 'doc42:hasCommand' haben."@de ;
    sh:severity sh:Warning .

shapes:Aggregate-hasEvent
    a sh:PropertyShape ;
    sh:path     doc42:hasEvent ;
    sh:minCount 1 ;
    sh:message  "Aggregate sollte mindestens ein 'doc42:hasEvent' haben."@de ;
    sh:severity sh:Warning .


# ── ContextRelationship ──────────────────────────────────────────────────────

shapes:ContextRelationshipShape
    a sh:NodeShape ;
    sh:targetClass doc42:ContextRelationship ;
    sh:property shapes:ContextRelationship-upstream ;
    sh:property shapes:ContextRelationship-downstream ;
    sh:property shapes:ContextRelationship-relationshipType .

shapes:ContextRelationship-upstream
    a sh:PropertyShape ;
    sh:path     doc42:upstream ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class    doc42:BoundedContext ;
    sh:message  "ContextRelationship muss genau einen 'doc42:upstream' BoundedContext haben."@de ;
    sh:severity sh:Violation .

shapes:ContextRelationship-downstream
    a sh:PropertyShape ;
    sh:path     doc42:downstream ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class    doc42:BoundedContext ;
    sh:message  "ContextRelationship muss genau einen 'doc42:downstream' BoundedContext haben."@de ;
    sh:severity sh:Violation .

shapes:ContextRelationship-relationshipType
    a sh:PropertyShape ;
    sh:path     doc42:relationshipType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in       ( doc42:Partnership doc42:SharedKernel doc42:CustomerSupplier
                  doc42:Conformist doc42:AnticorruptionLayer
                  doc42:OpenHostService doc42:PublishedLanguage ) ;
    sh:message  "ContextRelationship muss einen gueltigen 'doc42:relationshipType' haben."@de ;
    sh:severity sh:Violation .


# ── Architecture (Wurzel) ────────────────────────────────────────────────────

shapes:ArchitectureShape
    a sh:NodeShape ;
    sh:targetClass doc42:Architecture ;
    sh:property shapes:Architecture-name ;
    sh:property shapes:Architecture-description .

shapes:Architecture-name
    a sh:PropertyShape ;
    sh:path     doc42:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message  "Architecture muss einen 'doc42:name' haben."@de ;
    sh:severity sh:Violation .

shapes:Architecture-description
    a sh:PropertyShape ;
    sh:path     doc42:description ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message  "Architecture sollte eine 'doc42:description' haben."@de ;
    sh:severity sh:Warning .


##############################################################################
#  SCHICHT 3 – TECHNISCHE SHAPES
##############################################################################

shapes:APIContractShape
    a sh:NodeShape ;
    sh:targetClass doc42:APIContract ;
    sh:property shapes:APIContract-name ;
    sh:property shapes:APIContract-apiType .

shapes:APIContract-name
    a sh:PropertyShape ;
    sh:path     doc42:name ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message  "APIContract muss einen Namen haben."@de ;
    sh:severity sh:Violation .

shapes:APIContract-apiType
    a sh:PropertyShape ;
    sh:path     doc42:apiType ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:in       ( "REST" "GraphQL" "gRPC" "AsyncAPI" "CommandBus" "QueryBus" "EventBus" ) ;
    sh:message  "APIContract muss einen gueltigen 'doc42:apiType' haben."@de ;
    sh:severity sh:Violation .


shapes:ADRShape
    a sh:NodeShape ;
    sh:targetClass doc42:ArchitectureDecisionRecord ;
    sh:property shapes:ADR-name ;
    sh:property shapes:ADR-adrStatus ;
    sh:property shapes:ADR-adrContext ;
    sh:property shapes:ADR-adrDecision .

shapes:ADR-name
    a sh:PropertyShape ;
    sh:path     doc42:name ;
    sh:minCount 1 ;
    sh:message  "ADR muss einen Namen haben."@de ;
    sh:severity sh:Violation .

shapes:ADR-adrStatus
    a sh:PropertyShape ;
    sh:path     doc42:adrStatus ;
    sh:minCount 1 ;
    sh:in       ( "proposed" "accepted" "deprecated" "superseded" ) ;
    sh:message  "ADR-Status muss proposed | accepted | deprecated | superseded sein."@de ;
    sh:severity sh:Violation .

shapes:ADR-adrContext
    a sh:PropertyShape ;
    sh:path     doc42:adrContext ;
    sh:minCount 1 ;
    sh:message  "ADR muss einen 'doc42:adrContext' haben (Warum musste diese Entscheidung getroffen werden?)."@de ;
    sh:severity sh:Violation .

shapes:ADR-adrDecision
    a sh:PropertyShape ;
    sh:path     doc42:adrDecision ;
    sh:minCount 1 ;
    sh:message  "ADR muss eine 'doc42:adrDecision' haben."@de ;
    sh:severity sh:Violation .

# END OF SHAPES
