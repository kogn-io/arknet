##############################################################################
#  arknet – Architecture Knowledge Net
#  SHACL Validation Shapes  ·  Version 0.2.0
#
#  Prinzip: Closed-World-Assumption.
#  Fehlende Pflichtfelder = Fehler in CI/CD, nicht "vielleicht woanders".
#
#  Validates arkddd:BoundedContext only. Aggregate and ContextRelationship
#  shapes live in parked/arknet-ddd-shapes.ttl (no active consumer yet).
#
#  Named PropertyShapes fuer RDF4J SHACL Sail Kompatibilitaet.
##############################################################################

@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix arknet: <https://w3id.org/arknet/core#> .
@prefix arkddd: <https://w3id.org/arknet/ddd#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix shapes: <https://w3id.org/arknet/shapes#> .


##############################################################################
#  BOUNDED CONTEXT SHAPES
##############################################################################

shapes:BoundedContextShape
    a sh:NodeShape ;
    sh:targetClass arkddd:BoundedContext ;
    sh:property shapes:BoundedContext-name ;
    sh:property shapes:BoundedContext-domainVision ;
    sh:property shapes:BoundedContext-hasAggregate ;
    sh:property shapes:BoundedContext-partOf ;
    sh:property shapes:BoundedContext-ownedBy .

shapes:BoundedContext-name
    a sh:PropertyShape ;
    sh:path     arknet:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 2 ;
    sh:message  "BoundedContext muss genau einen 'arknet:name' haben (min. 2 Zeichen)."@de ;
    sh:severity sh:Violation .

shapes:BoundedContext-domainVision
    a sh:PropertyShape ;
    sh:path     arkddd:domainVision ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 10 ;
    sh:message  "BoundedContext muss eine 'arkddd:domainVision' haben (min. 10 Zeichen). Formuliere in einem Satz: Was leistet dieser Context?"@de ;
    sh:severity sh:Violation .

shapes:BoundedContext-hasAggregate
    a sh:PropertyShape ;
    sh:path     arkddd:hasAggregate ;
    sh:minCount 1 ;
    sh:class    arkddd:Aggregate ;
    sh:message  "BoundedContext sollte mindestens ein 'arkddd:hasAggregate' haben (dessen Wert vom Typ arkddd:Aggregate ist)."@de ;
    sh:severity sh:Warning .

shapes:BoundedContext-partOf
    a sh:PropertyShape ;
    sh:path     arkddd:partOf ;
    sh:maxCount 1 ;
    sh:class    arkddd:Domain ;
    sh:message  "BoundedContext sollte 'arkddd:partOf' (eine Domain oder Subdomain) haben."@de ;
    sh:severity sh:Warning .

shapes:BoundedContext-ownedBy
    a sh:PropertyShape ;
    sh:path     arkddd:ownedBy ;
    sh:message  "BoundedContext sollte 'arkddd:ownedBy' (Team-Name) haben."@de ;
    sh:severity sh:Warning .

# END OF SHAPES
