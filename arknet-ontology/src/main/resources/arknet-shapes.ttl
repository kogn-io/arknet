##############################################################################
#  arknet – Architecture Knowledge Net
#  SHACL Validation Shapes  ·  Version 0.1.0
#
#  Prinzip: Closed-World-Assumption.
#  Fehlende Pflichtfelder = Fehler in CI/CD, nicht "vielleicht woanders".
#
#  Named PropertyShapes fuer RDF4J SHACL Sail Kompatibilitaet.
##############################################################################

@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix arknet: <https://w3id.org/arknet/core#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix shapes: <https://w3id.org/arknet/shapes#> .


##############################################################################
#  DDD SHAPES
##############################################################################

# ── BoundedContext ──────────────────────────────────────────────────────────

shapes:BoundedContextShape
    a sh:NodeShape ;
    sh:targetClass arknet:BoundedContext ;
    sh:property shapes:BoundedContext-name ;
    sh:property shapes:BoundedContext-domainVision ;
    sh:property shapes:BoundedContext-hasAggregate ;
    sh:property shapes:BoundedContext-subdomain ;
    sh:property shapes:BoundedContext-ownedBy .

shapes:BoundedContext-name
    a sh:PropertyShape ;
    sh:path     arknet:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 2 ;
    sh:message  "BoundedContext muss genau einen 'arknet:name' haben (min. 2 Zeichen)."@de ;
    sh:severity sh:Violation .

shapes:BoundedContext-domainVision
    a sh:PropertyShape ;
    sh:path     arknet:domainVision ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 10 ;
    sh:message  "BoundedContext muss eine 'arknet:domainVision' haben (min. 10 Zeichen). Formuliere in einem Satz: Was leistet dieser Context?"@de ;
    sh:severity sh:Violation .

shapes:BoundedContext-hasAggregate
    a sh:PropertyShape ;
    sh:path     arknet:hasAggregate ;
    sh:minCount 1 ;
    sh:class    arknet:Aggregate ;
    sh:message  "BoundedContext muss mindestens ein 'arknet:hasAggregate' haben."@de ;
    sh:severity sh:Violation .

shapes:BoundedContext-subdomain
    a sh:PropertyShape ;
    sh:path     arknet:subdomain ;
    sh:maxCount 1 ;
    sh:in       ( arknet:CoreDomain arknet:SupportingDomain arknet:GenericDomain ) ;
    sh:message  "BoundedContext sollte 'arknet:subdomain' (CoreDomain | SupportingDomain | GenericDomain) haben."@de ;
    sh:severity sh:Warning .

shapes:BoundedContext-ownedBy
    a sh:PropertyShape ;
    sh:path     arknet:ownedBy ;
    sh:message  "BoundedContext sollte 'arknet:ownedBy' (Team-Name) haben."@de ;
    sh:severity sh:Warning .


# ── Aggregate ──────────────────────────────────────────────────────────────

shapes:AggregateShape
    a sh:NodeShape ;
    sh:targetClass arknet:Aggregate ;
    sh:property shapes:Aggregate-name ;
    sh:property shapes:Aggregate-aggregateRoot ;
    sh:property shapes:Aggregate-hasCommand ;
    sh:property shapes:Aggregate-hasEvent .

shapes:Aggregate-name
    a sh:PropertyShape ;
    sh:path     arknet:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message  "Aggregate muss einen 'arknet:name' haben."@de ;
    sh:severity sh:Violation .

shapes:Aggregate-aggregateRoot
    a sh:PropertyShape ;
    sh:path     arknet:aggregateRoot ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class    arknet:AggregateRoot ;
    sh:message  "Aggregate muss GENAU EINEN 'arknet:aggregateRoot' haben."@de ;
    sh:severity sh:Violation .

shapes:Aggregate-hasCommand
    a sh:PropertyShape ;
    sh:path     arknet:hasCommand ;
    sh:minCount 1 ;
    sh:message  "Aggregate sollte mindestens einen 'arknet:hasCommand' haben."@de ;
    sh:severity sh:Warning .

shapes:Aggregate-hasEvent
    a sh:PropertyShape ;
    sh:path     arknet:hasEvent ;
    sh:minCount 1 ;
    sh:message  "Aggregate sollte mindestens ein 'arknet:hasEvent' haben."@de ;
    sh:severity sh:Warning .


# ── ContextRelationship ────────────────────────────────────────────────────

shapes:ContextRelationshipShape
    a sh:NodeShape ;
    sh:targetClass arknet:ContextRelationship ;
    sh:property shapes:ContextRelationship-upstream ;
    sh:property shapes:ContextRelationship-downstream ;
    sh:property shapes:ContextRelationship-relationshipType .

shapes:ContextRelationship-upstream
    a sh:PropertyShape ;
    sh:path     arknet:upstream ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class    arknet:BoundedContext ;
    sh:message  "ContextRelationship muss genau einen 'arknet:upstream' BoundedContext haben."@de ;
    sh:severity sh:Violation .

shapes:ContextRelationship-downstream
    a sh:PropertyShape ;
    sh:path     arknet:downstream ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class    arknet:BoundedContext ;
    sh:message  "ContextRelationship muss genau einen 'arknet:downstream' BoundedContext haben."@de ;
    sh:severity sh:Violation .

shapes:ContextRelationship-relationshipType
    a sh:PropertyShape ;
    sh:path     arknet:relationshipType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in       ( arknet:Partnership arknet:SharedKernel arknet:CustomerSupplier
                  arknet:Conformist arknet:AnticorruptionLayer
                  arknet:OpenHostService arknet:PublishedLanguage
                  arknet:SeparateWays ) ;
    sh:message  "ContextRelationship muss einen gueltigen 'arknet:relationshipType' haben."@de ;
    sh:severity sh:Violation .

# END OF SHAPES
