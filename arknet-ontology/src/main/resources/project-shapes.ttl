##############################################################################
#  arknet - Architecture Knowledge Net
#  Project SHACL Shapes  :  Version 0.1.0
#
#  Validates the registered-project vocabulary (arknet-project.ttl): a
#  project is identified by a unique dcterms:identifier and reachable only
#  through the anchors it carries. A dataset holds the data of exactly one
#  project, so nothing here filters by project - the store boundary already
#  is the project boundary.
#
#  arkprj:Project-anchor has no upper bound and no default: a project
#  without at least one anchor is unfindable, and the registered-anchor model rules out
#  both a default anchor and a fallback to a server-local guess.
#
#  Named PropertyShapes fuer RDF4J SHACL Sail Kompatibilitaet.
##############################################################################

@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix arkprj:   <https://w3id.org/arknet/project#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix prjshapes: <https://w3id.org/arknet/shapes/project#> .


##############################################################################
#  PROJECT SHAPE
##############################################################################

prjshapes:ProjectShape
    a sh:NodeShape ;
    sh:targetClass arkprj:Project ;
    sh:property prjshapes:Project-identifier ;
    sh:property prjshapes:Project-anchor ;
    sh:property prjshapes:Project-description ;
    sh:property prjshapes:Project-defaultLanguage ;
    sh:property prjshapes:Project-maintainedLanguage .

prjshapes:Project-identifier
    a sh:PropertyShape ;
    sh:path     dcterms:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:minLength 1 ;
    sh:message  "A Project needs exactly one non-empty dcterms:identifier - this IS the project's human-readable name and must be unique across all projects."@en , "Ein Project braucht genau einen nicht-leeren dcterms:identifier - das IST der menschenlesbare Name des Projekts und muss projektuebergreifend eindeutig sein."@de ;
    sh:severity sh:Violation .

prjshapes:Project-anchor
    a sh:PropertyShape ;
    sh:path     arkprj:anchor ;
    sh:minCount 1 ;
    sh:message  "A Project needs at least one arkprj:anchor. There is no default anchor and no fallback - a project without an anchor cannot be reached by any client."@en , "Ein Project braucht mindestens einen arkprj:anchor. Es gibt keinen Default-Anker und keinen Fallback - ein Projekt ohne Anker ist von keinem Client erreichbar."@de ;
    sh:severity sh:Violation .

prjshapes:Project-description
    a sh:PropertyShape ;
    sh:path     dcterms:description ;
    sh:uniqueLang true ;
    sh:message  "At most one dcterms:description per language tag - several untagged or same-language-tagged descriptions on one project are not allowed, but several DIFFERENT language tags are (a project's description may be written in several languages). dcterms:description itself is optional."@en , "Hoechstens eine dcterms:description je Sprach-Tag - mehrere untagged oder gleichsprachige Beschreibungen an einem Projekt sind nicht erlaubt, mehrere VERSCHIEDENE Sprach-Tags dagegen schon (die Beschreibung eines Projekts darf mehrsprachig sein). dcterms:description selbst ist optional."@de ;
    sh:severity sh:Violation .

prjshapes:Project-defaultLanguage
    a sh:PropertyShape ;
    sh:path     arkprj:defaultLanguage ;
    sh:maxCount 1 ;
    sh:message  "At most one arkprj:defaultLanguage - a project has a single default display/write language, not several. arkprj:defaultLanguage itself is optional."@en , "Hoechstens ein arkprj:defaultLanguage - ein Projekt hat eine einzelne Standard-Anzeige-/Schreibsprache, nicht mehrere. arkprj:defaultLanguage selbst ist optional."@de ;
    sh:severity sh:Violation .

prjshapes:Project-maintainedLanguage
    a sh:PropertyShape ;
    sh:path     arkprj:maintainedLanguage ;
    sh:pattern  "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$" ;
    sh:message  "Every arkprj:maintainedLanguage must be a well-formed BCP-47 language tag (e.g. 'de', 'en', 'pt-BR'). The property is multi-valued and optional: a project may maintain several languages, or none at all - deliberately no sh:maxCount and no sh:minCount, unlike the single-valued arkprj:defaultLanguage."@en , "Jedes arkprj:maintainedLanguage muss ein wohlgeformtes BCP-47-Sprach-Tag sein (z.B. 'de', 'en', 'pt-BR'). Die Property ist mehrwertig und optional: ein Projekt darf mehrere Sprachen fuehren oder gar keine - bewusst kein sh:maxCount und kein sh:minCount, anders als beim einwertigen arkprj:defaultLanguage."@de ;
    sh:severity sh:Violation .


##############################################################################
#  ANCHOR SHAPE
##############################################################################

prjshapes:AnchorShape
    a sh:NodeShape ;
    sh:targetClass arkprj:Anchor ;
    sh:property prjshapes:Anchor-value ;
    sh:property prjshapes:Anchor-type .

prjshapes:Anchor-value
    a sh:PropertyShape ;
    sh:path     arkprj:anchorValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:minLength 1 ;
    sh:message  "An Anchor needs exactly one non-empty arkprj:anchorValue - the opaque string the server looks up, never interprets."@en , "Ein Anchor braucht genau einen nicht-leeren arkprj:anchorValue - die opake Zeichenkette, die der Server nachschlaegt, niemals interpretiert."@de ;
    sh:severity sh:Violation .

prjshapes:Anchor-type
    a sh:PropertyShape ;
    sh:path     arkprj:anchorType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in       ( arkprj:PathAnchor arkprj:UrlAnchor arkprj:UuidAnchor ) ;
    sh:message  "An Anchor needs exactly one arkprj:anchorType, one of PathAnchor, UrlAnchor, or UuidAnchor."@en , "Ein Anchor braucht genau einen arkprj:anchorType, einen von PathAnchor, UrlAnchor oder UuidAnchor."@de ;
    sh:severity sh:Violation .

# END OF PROJECT SHAPES
