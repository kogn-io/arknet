##############################################################################
#  arknet - Architecture Knowledge Net
#  Requirements Ontology  :  Version 0.2.0
#
#  Namespace  : https://w3id.org/arknet/requirements#
#  License    : CC-BY-4.0
#
#  Scope: Requirements Engineering (ISO/IEC/IEEE 29148) als Metamodell.
#         Goals, funktionale und nicht-funktionale Requirements, Constraints,
#         Use Cases (Cockburn) sowie Release-/Milestone-Planung. Verknuepft
#         Requirements ueber Use Cases mit der taktischen DDD-Schicht
#         (Command -> Aggregate -> BoundedContext).
#
#  GENERISCH: Allgemeines RE-Metamodell fuer JEDES Projekt. Keine
#             projektspezifischen Kategorien oder IDs.
#
#  Standard-Alignment (analog zum DPV-Alignment des Privacy-Moduls):
#    - arkreq:Requirement rdfs:subClassOf oslc_rm:Requirement (OASIS OSLC RM).
#    - OSLC-RM-Trace-Properties werden WIEDERVERWENDET statt neu erfunden:
#      oslc_rm:constrainedBy, oslc_rm:satisfies/satisfiedBy,
#      oslc_rm:decomposedBy/decomposes, oslc_rm:implementedBy.
#    - Identitaet/Text ueber Dublin Core: dcterms:identifier / title / description
#      (NICHT arknet:name -- bewusste Abweichung fuer OSLC-Interop; Projektionen,
#      die Requirements rendern, muessen dcterms lesen).
#    - arkreq: definiert NUR, was OSLC RM fehlt: Goal, UseCase (Cockburn),
#      FR/NFR-Unterscheidung, MoSCoW-Priority, Status-Lifecycle, Quality-Kategorie,
#      Release/Milestone (an doap:Version angelehnt).
#
#  Traceability-Kette:
#    Goal -> Requirement -> UseCase -> Command -> Aggregate -> BoundedContext
#    Requirement -> plannedFor -> Milestone -> deliveredIn -> Release
#
#  Imports: arknet-ddd (BoundedContext), arknet-process (Actor), OSLC RM, DOAP.
##############################################################################

@prefix arkreq:  <https://w3id.org/arknet/requirements#> .
@prefix arkddd:  <https://w3id.org/arknet/ddd#> .
@prefix arkproc: <https://w3id.org/arknet/process#> .
@prefix oslc_rm: <http://open-services.net/ns/rm#> .
@prefix doap:    <http://usefulinc.com/ns/doap#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .


# ============================================================
#  Ontology Metadata
# ============================================================

<https://w3id.org/arknet/requirements>
    a owl:Ontology ;
    owl:imports      <https://w3id.org/arknet/ddd> ;
    owl:imports      <https://w3id.org/arknet/process> ;
    owl:imports      <http://open-services.net/ns/rm#> ;
    owl:imports      <http://usefulinc.com/ns/doap#> ;
    dcterms:title    "arknet Requirements Ontology"@en ;
    dcterms:description "Requirements Engineering nach ISO 29148: Goals, Requirements, Constraints, Use Cases und Release-Planung; OSLC-RM-aligned und mit der DDD-Schicht verknuepft."@de ;
    dcterms:version  "0.2.0" ;
    dcterms:created  "2026-07-11"^^xsd:date ;
    dcterms:rights   "CC-BY-4.0" ;
    vann:preferredNamespacePrefix "arkreq" ;
    vann:preferredNamespaceUri    "https://w3id.org/arknet/requirements#" ;
    owl:versionInfo  "0.2.0" .


##############################################################################
#  1. GOALS
#     (kein OSLC-RM-Aequivalent -- arkreq-eigen)
##############################################################################

arkreq:Goal a owl:Class ;
    rdfs:label   "Goal"@en , "Ziel"@de ;
    rdfs:comment "Ein uebergeordnetes Stakeholder- oder Geschaeftsziel, das Requirements motiviert. Beschreibt das WARUM, nicht das WAS."@de ;
    skos:example "Time-to-Market senken, Betrugsrate reduzieren, Self-Service ermoeglichen"@de .

arkreq:goalStatement a owl:DatatypeProperty ;
    rdfs:domain arkreq:Goal ;
    rdfs:range  xsd:string ;
    rdfs:label  "goal statement"@en ;
    rdfs:comment "Die Zielformulierung in einem Satz."@de .

arkreq:subGoalOf a owl:ObjectProperty ;
    rdfs:domain arkreq:Goal ;
    rdfs:range  arkreq:Goal ;
    a owl:TransitiveProperty ;
    rdfs:label  "sub-goal of"@en ;
    rdfs:comment "Zielhierarchie: dieses Ziel verfeinert ein uebergeordnetes Ziel."@de .


##############################################################################
#  2. REQUIREMENTS
#     Basis = oslc_rm:Requirement (OASIS OSLC RM). arkreq verfeinert.
#     ID/Text ueber dcterms:identifier / dcterms:title / dcterms:description.
##############################################################################

arkreq:Requirement a owl:Class ;
    rdfs:subClassOf oslc_rm:Requirement ;
    rdfs:label   "Requirement"@en , "Anforderung"@de ;
    rdfs:comment "Eine dokumentierte Faehigkeit oder Eigenschaft, die das System erfuellen muss (ISO 29148). Spezialisierung von oslc_rm:Requirement. Abstrakte Basisklasse."@de .

arkreq:FunctionalRequirement a owl:Class ;
    rdfs:subClassOf arkreq:Requirement ;
    rdfs:label   "Functional Requirement"@en , "Funktionale Anforderung"@de ;
    rdfs:comment "Beschreibt WAS das System tun soll (Funktion, Verhalten, Ergebnis)."@de ;
    skos:example "Das System soll Bestellungen stornieren koennen."@de .

arkreq:NonFunctionalRequirement a owl:Class ;
    rdfs:subClassOf arkreq:Requirement ;
    rdfs:label   "Non-Functional Requirement"@en , "Nicht-funktionale Anforderung"@de ;
    rdfs:comment "Beschreibt eine Qualitaetseigenschaft (WIE gut), z.B. Performance, Sicherheit, Verfuegbarkeit (vgl. ISO 25010)."@de ;
    skos:example "95% aller Anfragen in unter 200ms."@de .

# -- Requirement Properties (arkreq-eigen; ID/Text via dcterms, s.u.) ---------

arkreq:rationale a owl:DatatypeProperty ;
    rdfs:domain arkreq:Requirement ;
    rdfs:range  rdfs:Literal ;
    rdfs:label  "rationale"@en ;
    rdfs:comment "Begruendung, warum diese Anforderung existiert -- das WARUM, das verlorengeht, wenn Personen wechseln (issue #321). Optional: anders als dcterms:description traegt rshapes:Requirement-rationale kein sh:minCount. Mehrsprachig: rdfs:Literal statt xsd:string, weil rshapes:Requirement-rationale je Sprach-Tag ein eigenes (dann rdf:langString-) Literal erlaubt (sh:uniqueLang)."@de .

arkreq:acceptanceCriterion a owl:ObjectProperty ;
    rdfs:domain arkreq:Requirement ;
    rdfs:range  arkreq:AcceptanceCriterion ;
    rdfs:label  "acceptance criterion"@en ;
    rdfs:comment "Ein testbares, positioniertes Kriterium (Done when ...) dieser Anforderung. Kann mehrfach vorkommen -- eigene Ressource statt Freitext-Literal, analog zu arkreq:mainStep/arkreq:Step (issue #266)."@de .

arkreq:AcceptanceCriterion a owl:Class ;
    rdfs:label   "Acceptance Criterion"@en , "Akzeptanzkriterium"@de ;
    rdfs:comment "Ein einzelnes, positioniertes testbares Kriterium (Done when ...) einer Anforderung. Bewusst reiner Freitext -- kein Given/When/Then, keine Unterfelder (issue #266). Keine eigene realises-Kante wie arkreq:Step: ein Akzeptanzkriterium ist Erfuellungsnachweis der eigenen Requirement, nicht Traceability zu anderen."@de .

arkreq:criterionText a owl:DatatypeProperty ;
    rdfs:domain arkreq:AcceptanceCriterion ;
    rdfs:range  rdfs:Literal ;
    rdfs:label  "criterion text"@en ;
    rdfs:comment "The testable criterion text (Done when ...). Multilingual: rdfs:Literal instead of xsd:string, because rshapes:AcceptanceCriterion-text allows one own (then rdf:langString) literal per language tag (sh:uniqueLang)."@en ,
                 "Der testbare Kriterientext (Done when ...). Mehrsprachig: rdfs:Literal statt xsd:string, weil rshapes:AcceptanceCriterion-text je Sprach-Tag ein eigenes (dann rdf:langString-) Literal erlaubt (sh:uniqueLang)."@de .

arkreq:qualityCategory a owl:DatatypeProperty ;
    rdfs:domain arkreq:NonFunctionalRequirement ;
    rdfs:range  xsd:string ;
    rdfs:label  "quality category"@en ;
    rdfs:comment "Qualitaetsmerkmal nach ISO 25010, z.B. performance, security, reliability, usability, maintainability."@de .

# -- Requirement Relationships -----------------------------------------------
#    Reused from OSLC RM:
#      oslc_rm:constrainedBy  (Requirement -> Constraint; auch UseCase -> Constraint, Issue #329)
#      oslc_rm:satisfiedBy    (Requirement -> UseCase)   inverse: oslc_rm:satisfies
#      oslc_rm:decomposedBy   (Requirement -> Requirement) inverse: oslc_rm:decomposes
#    arkreq adds only what OSLC lacks:

arkreq:motivatedBy a owl:ObjectProperty ;
    rdfs:domain arkreq:Requirement ;
    rdfs:range  arkreq:Goal ;
    rdfs:label  "motivated by"@en ;
    rdfs:comment "Diese Anforderung dient dem angegebenen Ziel."@de .

arkreq:motivates a owl:ObjectProperty ;
    rdfs:domain arkreq:Goal ;
    rdfs:range  arkreq:Requirement ;
    owl:inverseOf arkreq:motivatedBy ;
    rdfs:label  "motivates"@en ;
    rdfs:comment "Inverse of motivatedBy: this goal motivates the given requirement."@en ,
                 "Inverse von motivatedBy: dieses Ziel motiviert die angegebene Anforderung."@de .

arkreq:dependsOn a owl:ObjectProperty ;
    rdfs:domain arkreq:Requirement ;
    rdfs:range  arkreq:Requirement ;
    rdfs:label  "depends on"@en ;
    rdfs:comment "Diese Anforderung setzt eine andere Anforderung voraus (kein direktes OSLC-Aequivalent; naeher als affectedBy)."@de .

arkreq:scopedTo a owl:ObjectProperty ;
    rdfs:domain arkreq:Requirement ;
    rdfs:range  arkddd:BoundedContext ;
    rdfs:label  "scoped to"@en ;
    rdfs:comment "Der Bounded Context, in dem diese Anforderung realisiert wird."@de .

arkreq:usesTerm a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( arkreq:Requirement arkreq:UseCase ) ] ;
    rdfs:range  skos:Concept ;
    rdfs:label  "uses term"@en ;
    rdfs:comment "Ein Requirement oder ein UseCase verwendet einen Begriff der Ubiquitous Language (skos:Concept aus dem Glossar). Kann mehrfach vorkommen -- ein Triple pro Begriff. Zeigt auf die Term-Identitaet (dcterms:identifier, z.B. TERM-1), nicht auf das skos:prefLabel: die Kante bleibt damit stabil, wenn der Begriff umbenannt wird. Die Kante gehoert weiterhin der requirements-BC (UseCase wohnt im selben arkreq-Namespace), damit die Ubiquitous-Language-BC unabhaengig bleibt (Issue #329)."@de .


##############################################################################
#  3. CONSTRAINTS
#     (Ziel von oslc_rm:constrainedBy; arkreq typisiert die Randbedingung)
##############################################################################

arkreq:Constraint a owl:Class ;
    rdfs:label   "Constraint"@en , "Randbedingung"@de ;
    rdfs:comment "A boundary on the solution space that is imposed on the project from outside - by law, contract, customer, platform, budget or organisation - and that the project cannot change by itself (ISO 29148, IREB). Not negotiable within the project. The test is 'could we decide otherwise?': if yes, it is a decision (arkarch:ArchitectureDecisionRecord) or a requirement, not a constraint - a self-chosen scope, convention or modelling rule never is. The statement names who or what imposes it. Attached to requirements or use cases via oslc_rm:constrainedBy (issue #329)."@en ,
                 "Eine von aussen auferlegte Einschraenkung des Loesungsraums - durch Gesetz, Vertrag, Kunde, Plattform, Budget oder Organisation -, die das Projekt nicht selbst aendern kann (ISO 29148, IREB). Im Projekt nicht verhandelbar. Die Testfrage lautet 'koennten wir anders entscheiden?': wenn ja, ist es eine Entscheidung (arkarch:ArchitectureDecisionRecord) oder eine Anforderung, keine Randbedingung - ein selbst gewaehlter Scope, eine Konvention oder eine Modellierungsregel ist es nie. Das Statement benennt, wer oder was sie auferlegt. Wird ueber oslc_rm:constrainedBy an Requirements oder UseCases gehaengt (Issue #329)."@de .

# oslc_rm:constrainedBy is reused, not redefined (see file header) - but its range is asserted
# here, mirroring arkreq:primaryActor/arkproc:Actor above, so a delete-guard architecture test
# can discover every property pointing at a Constraint via rdfs:range the same way it already
# does for arkproc:Actor and skos:Concept (kogn-io/arknet#481).
oslc_rm:constrainedBy rdfs:range arkreq:Constraint .

arkreq:TechnicalConstraint a owl:Class ;
    rdfs:subClassOf arkreq:Constraint ;
    rdfs:label   "Technical Constraint"@en , "Technische Randbedingung"@de ;
    rdfs:comment "A constraint arising from technology, platform, or infrastructure choices."@en ,
                 "Eine Randbedingung, die sich aus Technologie-, Plattform- oder Infrastrukturvorgaben ergibt."@de ;
    skos:example "Muss auf der JVM laufen; nur PostgreSQL erlaubt."@de .

arkreq:BusinessConstraint a owl:Class ;
    rdfs:subClassOf arkreq:Constraint ;
    rdfs:label   "Business Constraint"@en , "Geschaeftliche Randbedingung"@de ;
    rdfs:comment "A constraint arising from business, budget, or organizational decisions."@en ,
                 "Eine Randbedingung, die sich aus geschaeftlichen, budgetaeren oder organisatorischen Entscheidungen ergibt."@de ;
    skos:example "Budget-Deckel; Go-Live vor Quartalsende."@de .

arkreq:RegulatoryConstraint a owl:Class ;
    rdfs:subClassOf arkreq:Constraint ;
    rdfs:label   "Regulatory Constraint"@en , "Regulatorische Randbedingung"@de ;
    rdfs:comment "Vorgabe aus Gesetz, Norm oder Vertrag."@de ;
    skos:example "DSGVO-Konformitaet; Aufbewahrungspflicht 10 Jahre."@de .

arkreq:constraintStatement a owl:DatatypeProperty ;
    rdfs:domain arkreq:Constraint ;
    rdfs:range  rdfs:Literal ;
    rdfs:label  "constraint statement"@en ;
    rdfs:comment "Die Randbedingung in einem Satz. Mehrsprachig: rdfs:Literal statt xsd:string, weil rshapes:Constraint-statement je Sprach-Tag ein eigenes (dann rdf:langString-) Literal erlaubt (sh:uniqueLang)."@de .


##############################################################################
#  4. USE CASES  (Cockburn)
#     (kein OSLC-RM-Aequivalent -- arkreq-eigen. UseCase satisfies Requirement
#      via oslc_rm:satisfies.)
##############################################################################

arkreq:UseCase a owl:Class ;
    rdfs:label   "Use Case"@en , "Anwendungsfall"@de ;
    rdfs:comment "Ein Interaktionsszenario zwischen Akteuren und System, das ein Ziel erreicht (Cockburn). Erfuellt Requirements ueber oslc_rm:satisfies."@de ;
    skos:example "Bestellung aufgeben, Passwort zuruecksetzen"@de .

arkreq:useCaseGoal a owl:DatatypeProperty ;
    rdfs:domain arkreq:UseCase ;
    rdfs:range  rdfs:Literal ;
    rdfs:label  "use case goal"@en ;
    rdfs:comment "The goal in context (goal-in-context per Cockburn). Multilingual: rdfs:Literal instead of xsd:string, because rshapes:UseCase-goal-uniqueLang allows one own (then rdf:langString) literal per language tag (sh:uniqueLang)."@en ,
                 "Das Ziel im Kontext (goal-in-context nach Cockburn). Mehrsprachig: rdfs:Literal statt xsd:string, weil rshapes:UseCase-goal-uniqueLang je Sprach-Tag ein eigenes (dann rdf:langString-) Literal erlaubt (sh:uniqueLang)."@de .

arkreq:designScope a owl:DatatypeProperty ;
    rdfs:domain arkreq:UseCase ;
    rdfs:range  rdfs:Literal ;
    rdfs:label  "design scope"@en ;
    rdfs:comment "The system scope this use case considers (design scope per Cockburn). Multilingual: rdfs:Literal instead of xsd:string, because rshapes:UseCase-scope-uniqueLang allows one own (then rdf:langString) literal per language tag (sh:uniqueLang)."@en ,
                 "Der Systemumfang, den dieser Use Case betrachtet (Design Scope nach Cockburn). Mehrsprachig: rdfs:Literal statt xsd:string, weil rshapes:UseCase-scope-uniqueLang je Sprach-Tag ein eigenes (dann rdf:langString-) Literal erlaubt (sh:uniqueLang)."@de .

arkreq:trigger a owl:DatatypeProperty ;
    rdfs:domain arkreq:UseCase ;
    rdfs:range  rdfs:Literal ;
    rdfs:label  "trigger"@en ;
    rdfs:comment "The event that triggers the use case (Cockburn trigger). Multilingual: rdfs:Literal instead of xsd:string, because rshapes:UseCase-trigger-uniqueLang allows one own (then rdf:langString) literal per language tag (sh:uniqueLang)."@en ,
                 "Das Ereignis, das den Use Case ausloest (Cockburn trigger). Mehrsprachig: rdfs:Literal statt xsd:string, weil rshapes:UseCase-trigger-uniqueLang je Sprach-Tag ein eigenes (dann rdf:langString-) Literal erlaubt (sh:uniqueLang)."@de .

# Haupt- und Ausnahmeablaeufe sind strukturiert (arkreq:mainStep / arkreq:extensionStep
# auf arkreq:Step), nicht mehr Freitext -- siehe Abschnitt 4b.

arkreq:useCasePrecondition a owl:DatatypeProperty ;
    rdfs:domain arkreq:UseCase ;
    rdfs:range  rdfs:Literal ;
    rdfs:label  "precondition"@en ;
    rdfs:comment "State that must hold before the use case. Multilingual: rdfs:Literal instead of xsd:string, because rshapes:UseCase-precondition-uniqueLang allows one own (then rdf:langString) literal per language tag (sh:uniqueLang)."@en ,
                 "Zustand, der vor dem Use Case gelten muss. Mehrsprachig: rdfs:Literal statt xsd:string, weil rshapes:UseCase-precondition-uniqueLang je Sprach-Tag ein eigenes (dann rdf:langString-) Literal erlaubt (sh:uniqueLang)."@de .

arkreq:useCasePostcondition a owl:DatatypeProperty ;
    rdfs:domain arkreq:UseCase ;
    rdfs:range  rdfs:Literal ;
    rdfs:label  "postcondition"@en ;
    rdfs:comment "Guaranteed state after a successful use case (success guarantee). Multilingual: rdfs:Literal instead of xsd:string, because rshapes:UseCase-postcondition-uniqueLang allows one own (then rdf:langString) literal per language tag (sh:uniqueLang)."@en ,
                 "Garantierter Zustand nach erfolgreichem Use Case (success guarantee). Mehrsprachig: rdfs:Literal statt xsd:string, weil rshapes:UseCase-postcondition-uniqueLang je Sprach-Tag ein eigenes (dann rdf:langString-) Literal erlaubt (sh:uniqueLang)."@de .

# -- Use Case Relationships --------------------------------------------------
#    UseCase oslc_rm:satisfies Requirement  (reused; siehe Requirement-Block)

arkreq:primaryActor a owl:ObjectProperty ;
    rdfs:domain arkreq:UseCase ;
    rdfs:range  arkproc:Actor ;
    rdfs:label  "primary actor"@en ;
    rdfs:comment "Der Akteur, dessen Ziel der Use Case erfuellt."@de .

arkreq:supportingActor a owl:ObjectProperty ;
    rdfs:domain arkreq:UseCase ;
    rdfs:range  arkproc:Actor ;
    rdfs:label  "supporting actor"@en ;
    rdfs:comment "Ein unterstuetzender (sekundaerer) Akteur, den das System aufruft."@de .

arkreq:realizedBy a owl:ObjectProperty ;
    rdfs:subPropertyOf oslc_rm:implementedBy ;
    rdfs:domain arkreq:UseCase ;
    rdfs:range  <https://w3id.org/arknet/ddd#Command> ;
    rdfs:label  "realized by"@en ;
    rdfs:comment "Bruecke zur taktischen DDD-Schicht: dieser Use Case wird durch das angegebene Command umgesetzt. Sub-Property von oslc_rm:implementedBy. Sein Wertebereich, arkddd:Command, lebt in der geparkten, noch nicht implementierten parked/arknet-ddd_parked.ttl."@de .

arkreq:includesUseCase a owl:ObjectProperty ;
    rdfs:domain arkreq:UseCase ;
    rdfs:range  arkreq:UseCase ;
    rdfs:label  "includes"@en ;
    rdfs:comment "UML include-Beziehung: dieser Use Case bindet einen anderen ein."@de .

arkreq:extendsUseCase a owl:ObjectProperty ;
    rdfs:domain arkreq:UseCase ;
    rdfs:range  arkreq:UseCase ;
    rdfs:label  "extends"@en ;
    rdfs:comment "UML extend-Beziehung: dieser Use Case erweitert einen anderen optional."@de .


##############################################################################
#  4b. FLOW STEPS  (strukturierter Ablauf statt Freitext)
#      Haupt- und Extension-Schritte sind Step-Ressourcen; Ordnung ueber
#      arkreq:position. Ein Schritt kann einzelne Requirements realisieren
#      (arkreq:stepRealises, feiner als die grobe UseCase-satisfies-Kante).
##############################################################################

arkreq:mainStep a owl:ObjectProperty ;
    rdfs:domain arkreq:UseCase ;
    rdfs:range  arkreq:Step ;
    rdfs:label  "main step"@en ;
    rdfs:comment "Ein Schritt des Hauptablaufs (main success scenario). Reihenfolge ueber arkreq:position."@de .

arkreq:extensionStep a owl:ObjectProperty ;
    rdfs:domain arkreq:UseCase ;
    rdfs:range  arkreq:Step ;
    rdfs:label  "extension step"@en ;
    rdfs:comment "Ein Schritt eines alternativen Ablaufs oder Ausnahmefalls (Cockburn extension). Traegt typischerweise arkreq:stepLabel (A1, E1) und arkreq:stepOutcome."@de .

arkreq:Step a owl:Class ;
    rdfs:label   "Use Case Step"@en , "Anwendungsfall-Schritt"@de ;
    rdfs:comment "Ein einzelner Schritt in einem Use-Case-Ablauf -- Hauptablauf (arkreq:mainStep) oder Ausnahme/Alternative (arkreq:extensionStep)."@de .

arkreq:position a owl:DatatypeProperty ;
    rdfs:range  xsd:integer ;
    a owl:FunctionalProperty ;
    rdfs:label  "position"@en ;
    rdfs:comment "1-basierte Ordnungsposition innerhalb einer geordneten Liste -- geteilt von arkreq:Step (Ablaufschritt) und arkreq:AcceptanceCriterion (issue #266). Bewusst keine rdf:List -- Ordnung ueber eine ganzzahlige Position (einfacher zu schreiben und per SPARQL zu sortieren)."@de .

arkreq:stepText a owl:DatatypeProperty ;
    rdfs:domain arkreq:Step ;
    rdfs:range  rdfs:Literal ;
    rdfs:label  "step text"@en ;
    rdfs:comment "Description of what happens in this step. Multilingual: rdfs:Literal instead of xsd:string, because rshapes:Step-text allows one own (then rdf:langString) literal per language tag (sh:uniqueLang)."@en ,
                 "Beschreibung dessen, was in diesem Schritt geschieht. Mehrsprachig: rdfs:Literal statt xsd:string, weil rshapes:Step-text je Sprach-Tag ein eigenes (dann rdf:langString-) Literal erlaubt (sh:uniqueLang)."@de .

arkreq:stepLabel a owl:DatatypeProperty ;
    rdfs:domain arkreq:Step ;
    rdfs:range  xsd:string ;
    rdfs:label  "step label"@en ;
    rdfs:comment "Optionale Kennung eines Extension-Schritts nach Cockburn (z.B. A1, E2). Fuer Hauptablauf-Schritte i.d.R. leer."@de .

arkreq:stepOutcome a owl:DatatypeProperty ;
    rdfs:domain arkreq:Step ;
    rdfs:range  xsd:string ;
    rdfs:label  "step outcome"@en ;
    rdfs:comment "Optionales Ergebnis eines Extension-Schritts (was passiert, wenn der Ausnahmefall eintritt)."@de .

arkreq:stepRealises a owl:ObjectProperty ;
    rdfs:subPropertyOf oslc_rm:satisfies ;
    rdfs:domain arkreq:Step ;
    rdfs:range  arkreq:Requirement ;
    rdfs:label  "step realises"@en ;
    rdfs:comment "Dieser Schritt realisiert die angegebene Anforderung (feingranular). Sub-Property von oslc_rm:satisfies; die grobe UseCase-Ebene bleibt separat ueber oslc_rm:satisfies erhalten."@de .


##############################################################################
#  5. PRIORITY  (MoSCoW, as Individuals -- kein OSLC-Aequivalent)
##############################################################################

arkreq:Priority a owl:Class ;
    rdfs:label "Priority"@en , "Prioritaet"@de ;
    rdfs:comment "Priorisierung nach MoSCoW."@de .

arkreq:MustHave a owl:NamedIndividual , arkreq:Priority ;
    rdfs:label "Must have"@en ;
    rdfs:comment "Zwingend fuer den Release; ohne diese Anforderung ist das Ergebnis wertlos."@de .

arkreq:ShouldHave a owl:NamedIndividual , arkreq:Priority ;
    rdfs:label "Should have"@en ;
    rdfs:comment "Wichtig, aber nicht release-kritisch; es gibt einen Workaround."@de .

arkreq:CouldHave a owl:NamedIndividual , arkreq:Priority ;
    rdfs:label "Could have"@en ;
    rdfs:comment "Wuenschenswert; wird nur bei ausreichender Kapazitaet umgesetzt."@de .

arkreq:WontHave a owl:NamedIndividual , arkreq:Priority ;
    rdfs:label "Won't have (this time)"@en ;
    rdfs:comment "Bewusst fuer diesen Zyklus ausgeschlossen."@de .

arkreq:priority a owl:ObjectProperty ;
    rdfs:domain arkreq:Requirement ;
    rdfs:range  arkreq:Priority ;
    a owl:FunctionalProperty ;
    rdfs:label  "priority"@en ;
    rdfs:comment "The MoSCoW priority assigned to this requirement."@en ,
                 "Die MoSCoW-Prioritaet dieser Anforderung."@de .


##############################################################################
#  6. STATUS  (Lifecycle, as Individuals -- kein OSLC-Aequivalent)
##############################################################################

arkreq:RequirementStatus a owl:Class ;
    rdfs:label "Requirement Status"@en , "Anforderungsstatus"@de ;
    rdfs:comment "Lebenszyklus-Status einer Anforderung."@de .

arkreq:Proposed a owl:NamedIndividual , arkreq:RequirementStatus ;
    rdfs:label "Proposed"@en ;
    rdfs:comment "Erfasst, aber noch nicht abgestimmt."@de .

arkreq:Accepted a owl:NamedIndividual , arkreq:RequirementStatus ;
    rdfs:label "Accepted"@en ;
    rdfs:comment "Abgestimmt und fuer die Umsetzung freigegeben."@de .

arkreq:Implemented a owl:NamedIndividual , arkreq:RequirementStatus ;
    rdfs:label "Implemented"@en ;
    rdfs:comment "Umgesetzt, aber noch nicht verifiziert."@de .

arkreq:Verified a owl:NamedIndividual , arkreq:RequirementStatus ;
    rdfs:label "Verified"@en ;
    rdfs:comment "Umgesetzt und gegen die Akzeptanzkriterien geprueft."@de .

arkreq:Rejected a owl:NamedIndividual , arkreq:RequirementStatus ;
    rdfs:label "Rejected"@en ;
    rdfs:comment "Verworfen; wird nicht umgesetzt."@de .

arkreq:Deprecated a owl:NamedIndividual , arkreq:RequirementStatus ;
    rdfs:label "Deprecated"@en ;
    rdfs:comment "War gueltig, ist aber nicht mehr relevant."@de .

# The status is a non-binding maturity signal for the human reader and
# enforces nothing: no validation rule, no coupling to fulfilment or
# decomposition edges, no ordering between a requirement's status and that of
# its neighbours, settable in both directions. An enforced status would need a
# model of what "fulfilled" means, which does not exist and would be a process
# decision imposed on other teams (see FR-5 in arknet's own store). Real
# consequences later are a new decision, not an extension of this one.
# (DE: Der Status ist ein unverbindliches Reifegrad-Signal ohne Durchsetzung,
# in beide Richtungen setzbar; ein durchgesetzter Status braeuchte ein
# Erfuellungsmodell, das es nicht gibt.)
arkreq:status a owl:ObjectProperty ;
    rdfs:domain arkreq:Requirement ;
    rdfs:range  arkreq:RequirementStatus ;
    a owl:FunctionalProperty ;
    rdfs:label  "status"@en ;
    rdfs:comment "The current lifecycle status of this requirement."@en ,
                 "Der aktuelle Lebenszyklus-Status dieser Anforderung."@de .


##############################################################################
#  7. RELEASE & MILESTONE PLANNING
#     arkreq:Release ist an doap:Version angelehnt (Projekt-Release/Version).
#     Milestone = datierter Planungs-Bucket, der Requirements buendelt.
##############################################################################

arkreq:Milestone a owl:Class ;
    rdfs:label   "Milestone"@en , "Meilenstein"@de ;
    rdfs:comment "Ein datiertes Planungsziel, das Requirements buendelt (vgl. Issue-Tracker-Milestone). Wird typischerweise als ein Release ausgeliefert."@de ;
    skos:example "v0.3.0 Projektionen, MVP-Launch"@de .

arkreq:milestoneTitle a owl:DatatypeProperty ;
    rdfs:domain arkreq:Milestone ;
    rdfs:range  xsd:string ;
    rdfs:label  "milestone title"@en ;
    rdfs:comment "The name of the milestone."@en ,
                 "Der Name des Meilensteins."@de .

arkreq:dueDate a owl:DatatypeProperty ;
    rdfs:domain arkreq:Milestone ;
    rdfs:range  xsd:date ;
    rdfs:label  "due date"@en ;
    rdfs:comment "Geplantes Zieldatum des Meilensteins."@de .

arkreq:MilestoneState a owl:Class ;
    rdfs:label "Milestone State"@en ;
    rdfs:comment "Zustand eines Meilensteins."@de .

arkreq:Open a owl:NamedIndividual , arkreq:MilestoneState ;
    rdfs:label "Open"@en ;
    rdfs:comment "The milestone is still in progress; not all planned requirements have been delivered."@en ,
                 "Der Meilenstein ist noch in Arbeit; nicht alle geplanten Anforderungen sind ausgeliefert."@de .

arkreq:Closed a owl:NamedIndividual , arkreq:MilestoneState ;
    rdfs:label "Closed"@en ;
    rdfs:comment "The milestone is complete; all planned requirements have been delivered or removed from scope."@en ,
                 "Der Meilenstein ist abgeschlossen; alle geplanten Anforderungen wurden ausgeliefert oder aus dem Umfang entfernt."@de .

arkreq:milestoneState a owl:ObjectProperty ;
    rdfs:domain arkreq:Milestone ;
    rdfs:range  arkreq:MilestoneState ;
    a owl:FunctionalProperty ;
    rdfs:label  "milestone state"@en ;
    rdfs:comment "The current lifecycle state of this milestone."@en ,
                 "Der aktuelle Lebenszyklus-Zustand dieses Meilensteins."@de .

arkreq:Release a owl:Class ;
    rdfs:subClassOf doap:Version ;
    rdfs:label   "Release"@en , "Release"@de ;
    rdfs:comment "Eine ausgelieferte Version des Systems (Semantic Versioning). Spezialisierung von doap:Version."@de ;
    skos:example "0.3.0, 1.0.0"@de .

arkreq:releaseVersion a owl:DatatypeProperty ;
    rdfs:domain arkreq:Release ;
    rdfs:range  xsd:string ;
    a owl:FunctionalProperty ;
    rdfs:label  "release version"@en ;
    rdfs:comment "Versionsnummer nach Semantic Versioning, z.B. 1.4.2."@de .

arkreq:releaseDate a owl:DatatypeProperty ;
    rdfs:domain arkreq:Release ;
    rdfs:range  xsd:date ;
    rdfs:label  "release date"@en ;
    rdfs:comment "Datum der Auslieferung."@de .

# -- Planning Relationships --------------------------------------------------

arkreq:plannedFor a owl:ObjectProperty ;
    rdfs:domain arkreq:Requirement ;
    rdfs:range  arkreq:Milestone ;
    rdfs:label  "planned for"@en ;
    rdfs:comment "Diese Anforderung ist fuer den angegebenen Meilenstein eingeplant."@de .

arkreq:deliveredIn a owl:ObjectProperty ;
    rdfs:domain arkreq:Milestone ;
    rdfs:range  arkreq:Release ;
    a owl:FunctionalProperty ;
    rdfs:label  "delivered in"@en ;
    rdfs:comment "Der Release, mit dem dieser Meilenstein ausgeliefert wurde."@de .


##############################################################################
#  8. OWL RESTRICTIONS
#     Identitaet/Text via dcterms (OSLC-konform):
#       dcterms:identifier  -> stabile Requirement-ID (z.B. FR-12)
#       dcterms:title       -> kurzer Name
#       dcterms:description -> die normative Aussage (Das System soll ...)
##############################################################################

# Every Requirement has exactly one dcterms:identifier
arkreq:Requirement rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty dcterms:identifier ;
    owl:cardinality 1
] .

# Every Requirement has at least one dcterms:description (the statement)
arkreq:Requirement rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty dcterms:description ;
    owl:minCardinality 1
] .

# Every UseCase has exactly one dcterms:identifier
arkreq:UseCase rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty dcterms:identifier ;
    owl:cardinality 1
] .

# END OF REQUIREMENTS ONTOLOGY
