##############################################################################
#  arknet – Architecture Knowledge Net
#  DDD SHACL Shapes (parked)  ·  Version 0.1.0
#
#  AggregateShape validates arkddd:Aggregate (parked/arknet-ddd_parked.ttl) -
#  not active until a bounded context consumes that module. ContextRelationshipShape
#  has an active consumer and moved to the live arknet-shapes.ttl.
#
#  Named PropertyShapes fuer RDF4J SHACL Sail Kompatibilitaet.
##############################################################################

@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix arkddd: <https://w3id.org/arknet/ddd#> .
@prefix arknet: <https://w3id.org/arknet/core#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix shapes: <https://w3id.org/arknet/shapes/ddd#> .


##############################################################################
#  AGGREGATE SHAPES
##############################################################################

shapes:AggregateShape
    a sh:NodeShape ;
    sh:targetClass arkddd:Aggregate ;
    sh:property shapes:Aggregate-name ;
    sh:property shapes:Aggregate-aggregateRoot ;
    sh:property shapes:Aggregate-hasCommand ;
    sh:property shapes:Aggregate-hasEvent .

shapes:Aggregate-name
    a sh:PropertyShape ;
    sh:path     arknet:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message  "Aggregate must have an 'arknet:name'."@en , "Aggregate muss einen 'arknet:name' haben."@de ;
    sh:severity sh:Violation .

shapes:Aggregate-aggregateRoot
    a sh:PropertyShape ;
    sh:path     arkddd:aggregateRoot ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class    arkddd:AggregateRoot ;
    sh:message  "Aggregate must have EXACTLY ONE 'arkddd:aggregateRoot'."@en , "Aggregate muss GENAU EINEN 'arkddd:aggregateRoot' haben."@de ;
    sh:severity sh:Violation .

shapes:Aggregate-hasCommand
    a sh:PropertyShape ;
    sh:path     arkddd:hasCommand ;
    sh:minCount 1 ;
    sh:message  "Aggregate should have at least one 'arkddd:hasCommand'."@en , "Aggregate sollte mindestens einen 'arkddd:hasCommand' haben."@de ;
    sh:severity sh:Warning .

shapes:Aggregate-hasEvent
    a sh:PropertyShape ;
    sh:path     arkddd:hasEvent ;
    sh:minCount 1 ;
    sh:message  "Aggregate should have at least one 'arkddd:hasEvent'."@en , "Aggregate sollte mindestens ein 'arkddd:hasEvent' haben."@de ;
    sh:severity sh:Warning .

# END OF DDD SHAPES (parked)
