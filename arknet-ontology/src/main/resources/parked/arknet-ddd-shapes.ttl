##############################################################################
#  arknet – Architecture Knowledge Net
#  DDD SHACL Shapes (parked)  ·  Version 0.1.0
#
#  Split out of arknet-shapes.ttl together with parked/arknet-ddd.ttl:
#  AggregateShape and ContextRelationshipShape target classes
#  (arkddd:Aggregate, arkddd:ContextRelationship) that no BC ever creates,
#  so neither shape has ever fired - moving them here changes documentation,
#  not runtime SHACL-gate behaviour. Not loaded by any *RepositoryFactory
#  today; wire it in alongside parked/arknet-ddd.ttl once a BC consumes
#  that module.
#
#  Named PropertyShapes fuer RDF4J SHACL Sail Kompatibilitaet.
##############################################################################

@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix arkddd: <https://w3id.org/arknet/ddd#> .
@prefix arknet: <https://w3id.org/arknet/core#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix shapes: <https://w3id.org/arknet/shapes/ddd#> .


##############################################################################
#  AGGREGATE SHAPES
##############################################################################

shapes:AggregateShape
    a sh:NodeShape ;
    sh:targetClass arkddd:Aggregate ;
    sh:property shapes:Aggregate-name ;
    sh:property shapes:Aggregate-aggregateRoot ;
    sh:property shapes:Aggregate-hasCommand ;
    sh:property shapes:Aggregate-hasEvent .

shapes:Aggregate-name
    a sh:PropertyShape ;
    sh:path     arknet:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message  "Aggregate muss einen 'arknet:name' haben."@de ;
    sh:severity sh:Violation .

shapes:Aggregate-aggregateRoot
    a sh:PropertyShape ;
    sh:path     arkddd:aggregateRoot ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class    arkddd:AggregateRoot ;
    sh:message  "Aggregate muss GENAU EINEN 'arkddd:aggregateRoot' haben."@de ;
    sh:severity sh:Violation .

shapes:Aggregate-hasCommand
    a sh:PropertyShape ;
    sh:path     arkddd:hasCommand ;
    sh:minCount 1 ;
    sh:message  "Aggregate sollte mindestens einen 'arkddd:hasCommand' haben."@de ;
    sh:severity sh:Warning .

shapes:Aggregate-hasEvent
    a sh:PropertyShape ;
    sh:path     arkddd:hasEvent ;
    sh:minCount 1 ;
    sh:message  "Aggregate sollte mindestens ein 'arkddd:hasEvent' haben."@de ;
    sh:severity sh:Warning .


##############################################################################
#  CONTEXT RELATIONSHIP SHAPES
##############################################################################

shapes:ContextRelationshipShape
    a sh:NodeShape ;
    sh:targetClass arkddd:ContextRelationship ;
    sh:property shapes:ContextRelationship-upstream ;
    sh:property shapes:ContextRelationship-downstream ;
    sh:property shapes:ContextRelationship-relationshipType .

shapes:ContextRelationship-upstream
    a sh:PropertyShape ;
    sh:path     arkddd:upstream ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class    arknet:BoundedContext ;
    sh:message  "ContextRelationship muss genau einen 'arkddd:upstream' BoundedContext haben."@de ;
    sh:severity sh:Violation .

shapes:ContextRelationship-downstream
    a sh:PropertyShape ;
    sh:path     arkddd:downstream ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class    arknet:BoundedContext ;
    sh:message  "ContextRelationship muss genau einen 'arkddd:downstream' BoundedContext haben."@de ;
    sh:severity sh:Violation .

shapes:ContextRelationship-relationshipType
    a sh:PropertyShape ;
    sh:path     arkddd:relationshipType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in       ( arkddd:Partnership arkddd:SharedKernel arkddd:CustomerSupplier
                  arkddd:Conformist arkddd:AnticorruptionLayer
                  arkddd:OpenHostService arkddd:PublishedLanguage
                  arkddd:SeparateWays ) ;
    sh:message  "ContextRelationship muss einen gueltigen 'arkddd:relationshipType' haben."@de ;
    sh:severity sh:Violation .

# END OF DDD SHAPES (parked)
