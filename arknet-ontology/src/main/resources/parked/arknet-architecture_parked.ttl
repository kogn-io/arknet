##############################################################################
#  arknet - Architecture Knowledge Net
#  Architecture Ontology (parked)  :  Version 0.1.0
#
#  Namespace  : https://w3id.org/arknet/architecture#
#  License    : CC-BY-4.0
#
#  Scope: Die Architekturbeschreibung nach ISO/IEC/IEEE 42010 -- Architecture,
#  ArchitectureDescription, Stakeholder, Concern, Viewpoint, View. Not
#  currently in active use, and not published under w3id.org/arknet/.
#  ArchitectureDecisionRecord und der ADR-Lebenszyklus teilen sich diesen
#  Namespace, haben aber einen aktiven Konsumenten -- siehe
#  arknet-architecture.ttl.
#
#  Cross-Modul-Mehrwert:
#    Viewpoint = formales Rueckgrat von arknets Projektion
#                (SPARQL-Query + Template + Rolle).
#
#  Konvention: Instanzen nutzen arknet:name / arknet:description (Core-Reuse,
#              Hausstil).
#
#  Imports: arknet-ddd (Domain), arknet-core (name, description via arknet-ddd),
#           arknet-requirements (Requirement).
##############################################################################

@prefix arkarch: <https://w3id.org/arknet/architecture#> .
@prefix arkreq:  <https://w3id.org/arknet/requirements#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .


# ============================================================
#  Ontology Metadata
# ============================================================

<https://w3id.org/arknet/architecture>
    a owl:Ontology ;
    owl:imports      <https://w3id.org/arknet/ddd> ;
    owl:imports      <https://w3id.org/arknet/requirements> ;
    dcterms:title    "arknet Architecture Ontology (parked)"@en ;
    dcterms:description "Architecture description per ISO/IEC/IEEE 42010: Architecture, ArchitectureDescription, Stakeholder, Concern, View and Viewpoint."@en ;
    dcterms:version  "0.1.0" ;
    dcterms:created  "2026-07-11"^^xsd:date ;
    dcterms:rights   "CC-BY-4.0" ;
    vann:preferredNamespacePrefix "arkarch" ;
    vann:preferredNamespaceUri    "https://w3id.org/arknet/architecture#" ;
    owl:versionInfo  "0.1.0" .


##############################################################################
#  1. ARCHITECTURE & ARCHITECTURE DESCRIPTION
##############################################################################

arkarch:Architecture a owl:Class ;
    rdfs:label   "Architecture"@en , "Architektur"@de ;
    rdfs:comment "Die Architektur eines konkreten Softwaresystems (ISO 42010). Wurzel des Modells."@de ;
    skos:example "Die Architektur von 'MyShop'."@de .

arkarch:ArchitectureDescription a owl:Class ;
    rdfs:label   "Architecture Description"@en , "Architekturbeschreibung"@de ;
    rdfs:comment "Eine formale Beschreibung der Architektur, bestehend aus Views, Modellen und ADRs (ISO 42010)."@de .

arkarch:describes a owl:ObjectProperty ;
    rdfs:domain arkarch:ArchitectureDescription ;
    rdfs:range  arkarch:Architecture ;
    a owl:FunctionalProperty ;
    rdfs:label  "describes"@en ;
    rdfs:comment "The architecture this architecture description describes."@en ,
                 "Die Architektur, die diese Architekturbeschreibung beschreibt."@de .

arkarch:hasDomain a owl:ObjectProperty ;
    rdfs:domain arkarch:Architecture ;
    rdfs:range  <https://w3id.org/arknet/ddd#Domain> ;
    rdfs:label  "has domain"@en ;
    rdfs:comment "Verwurzelt die Architektur in der strategischen DDD-Schicht (Core)."@de .

arkarch:hasStakeholder a owl:ObjectProperty ;
    rdfs:domain arkarch:Architecture ;
    rdfs:range  arkarch:Stakeholder ;
    rdfs:label  "has stakeholder"@en ;
    rdfs:comment "A stakeholder with an interest in this architecture."@en ,
                 "Ein Stakeholder mit Interesse an dieser Architektur."@de .

arkarch:hasView a owl:ObjectProperty ;
    rdfs:domain arkarch:ArchitectureDescription ;
    rdfs:range  arkarch:View ;
    rdfs:label  "has view"@en ;
    rdfs:comment "A view that is part of this architecture description."@en ,
                 "Eine View, die Teil dieser Architekturbeschreibung ist."@de .

arkarch:hasADR a owl:ObjectProperty ;
    rdfs:domain arkarch:Architecture ;
    rdfs:range  <https://w3id.org/arknet/architecture#ArchitectureDecisionRecord> ;
    rdfs:label  "has ADR"@en ;
    rdfs:comment "An architecture decision record made for this architecture. Its range, arkarch:ArchitectureDecisionRecord, is defined in the active arknet-architecture.ttl."@en ,
                 "Eine Architekturentscheidung, die fuer diese Architektur getroffen wurde."@de .


##############################################################################
#  2. STAKEHOLDERS & CONCERNS
##############################################################################

arkarch:Stakeholder a owl:Class ;
    rdfs:label   "Stakeholder"@en , "Stakeholder"@de ;
    rdfs:comment "Eine Person oder Gruppe mit Interesse an der Architektur (Architekt, Entwickler, Product Owner, ...)."@de .

arkarch:stakeholderRole a owl:DatatypeProperty ;
    rdfs:domain arkarch:Stakeholder ;
    rdfs:range  xsd:string ;
    rdfs:label  "stakeholder role"@en ;
    rdfs:comment "Die Rolle des Stakeholders, z.B. Architekt, Product Owner, Betrieb."@de .

arkarch:Concern a owl:Class ;
    rdfs:label   "Concern"@en , "Anliegen"@de ;
    rdfs:comment "Ein spezifisches Interesse eines Stakeholders an der Architektur (Skalierbarkeit, Sicherheit, Wartbarkeit, ...)."@de .

arkarch:hasConcern a owl:ObjectProperty ;
    rdfs:domain arkarch:Stakeholder ;
    rdfs:range  arkarch:Concern ;
    rdfs:label  "has concern"@en ;
    rdfs:comment "A concern held by this stakeholder."@en ,
                 "Ein Anliegen, das dieser Stakeholder hat."@de .

arkarch:concernMotivates a owl:ObjectProperty ;
    rdfs:domain arkarch:Concern ;
    rdfs:range  arkreq:Requirement ;
    rdfs:label  "motivates requirement"@en ;
    rdfs:comment "Ein Concern (42010) kann als Anforderung (RE) formalisiert werden."@de .


##############################################################################
#  3. VIEWS & VIEWPOINTS
#     Viewpoint = formales Rueckgrat der arknet-Projektion
#                 (SPARQL-Query + Template + Rolle).
##############################################################################

arkarch:Viewpoint a owl:Class ;
    rdfs:label   "Viewpoint"@en , "Sichtpunkt"@de ;
    rdfs:comment "Eine Vorlage/Konvention fuer Views (ISO 42010). Definiert Zweck, Zielgruppe, Notation und -- in arknet -- die SPARQL-Query samt Template, die eine Projektion erzeugen."@de .

arkarch:viewpointPurpose a owl:DatatypeProperty ;
    rdfs:domain arkarch:Viewpoint ;
    rdfs:range  xsd:string ;
    rdfs:label  "viewpoint purpose"@en ;
    rdfs:comment "Wozu dient dieser Sichtpunkt? Welche Concerns rahmt er?"@de .

arkarch:forStakeholder a owl:ObjectProperty ;
    rdfs:domain arkarch:Viewpoint ;
    rdfs:range  arkarch:Stakeholder ;
    rdfs:label  "for stakeholder"@en ;
    rdfs:comment "Die Zielgruppe (Rolle) dieses Sichtpunkts."@de .

arkarch:sparqlQuery a owl:DatatypeProperty ;
    rdfs:domain arkarch:Viewpoint ;
    rdfs:range  xsd:anyURI ;
    rdfs:label  "SPARQL query"@en ;
    rdfs:comment "Verweis auf die .sparql-Datei, die die Daten fuer diese Projektion selektiert."@de .

arkarch:template a owl:DatatypeProperty ;
    rdfs:domain arkarch:Viewpoint ;
    rdfs:range  xsd:anyURI ;
    rdfs:label  "template"@en ;
    rdfs:comment "Verweis auf die Template-Datei (z.B. Mustache), die aus dem Query-Ergebnis das Artefakt rendert."@de .

arkarch:notation a owl:DatatypeProperty ;
    rdfs:domain arkarch:Viewpoint ;
    rdfs:range  xsd:string ;
    rdfs:label  "notation"@en ;
    rdfs:comment "Verwendete Notation/Ausgabe, z.B. AsciiDoc, PlantUML, C4, Mermaid."@de .

arkarch:View a owl:Class ;
    rdfs:label   "View"@en , "Sicht"@de ;
    rdfs:comment "Eine rollenspezifische Projektion des Architekturmodells; entsteht aus einem Viewpoint (ISO 42010)."@de .

arkarch:conformsToViewpoint a owl:ObjectProperty ;
    rdfs:domain arkarch:View ;
    rdfs:range  arkarch:Viewpoint ;
    a owl:FunctionalProperty ;
    rdfs:label  "conforms to viewpoint"@en ;
    rdfs:comment "The viewpoint this view conforms to."@en ,
                 "Der Viewpoint, dem diese View entspricht."@de .

arkarch:addresses a owl:ObjectProperty ;
    rdfs:domain arkarch:View ;
    rdfs:range  arkarch:Concern ;
    rdfs:label  "addresses concern"@en ;
    rdfs:comment "Diese View adressiert das angegebene Concern."@de .

arkarch:renderedAs a owl:DatatypeProperty ;
    rdfs:domain arkarch:View ;
    rdfs:range  xsd:anyURI ;
    rdfs:label  "rendered as"@en ;
    rdfs:comment "Verweis auf das erzeugte Artefakt (HTML/PDF/PlantUML)."@de .

# END OF ARCHITECTURE ONTOLOGY (PARKED)
