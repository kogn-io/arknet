##############################################################################
#  arknet – Architecture Knowledge Net
#  Core Ontology  ·  Version 0.2.0
#
#  Namespace  : https://w3id.org/arknet/core#
#  License    : CC-BY-4.0
#
#  Scope: generic, domain-agnostic utility vocabulary, reusable across every
#  arknet module.
#
#  NOT included here (separate modules):
#    - BoundedContext, Domain, Subdomain → arknet-ddd.ttl
#    - ContextMap, tactical DDD          → parked/arknet-ddd_parked.ttl
#    - Actors                            → arknet-actor.ttl
#    - Processes, Steps, State Machines  → parked/arknet-process.ttl
#    - Architecture Decision Records     → arknet-architecture.ttl (live, arknet-adr)
#    - remaining ISO 42010 (Views, ...)  → parked/arknet-architecture_parked.ttl
#    - Technical layer (Service, API)    → arknet-tech.ttl
#    - GDPR / Privacy                   → parked/arknet-privacy.ttl
##############################################################################

@prefix arknet: <https://w3id.org/arknet/core#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .


# ============================================================
#  Ontology Metadata
# ============================================================

<https://w3id.org/arknet/core>
    a owl:Ontology ;
    dcterms:title       "arknet Core Ontology"@en ;
    dcterms:description "Generic, domain-agnostic utility vocabulary, reusable across every arknet module."@en ;
    dcterms:version     "0.2.0" ;
    dcterms:created     "2026-03-23"^^xsd:date ;
    dcterms:rights      "CC-BY-4.0" ;
    vann:preferredNamespacePrefix "arknet" ;
    vann:preferredNamespaceUri    "https://w3id.org/arknet/core#" ;
    owl:versionInfo     "0.2.0" .


##############################################################################
#  GENERIC UTILITY VOCABULARY
##############################################################################

arknet:name
    a owl:DatatypeProperty ;
    rdfs:range   rdfs:Literal ;
    rdfs:label   "name"@en ;
    rdfs:comment "Der menschenlesbare Name eines Konzepts. rdfs:Literal statt xsd:string, da manche Konsumenten (z.B. arkarch:ConsideredOption) mehrsprachig sprachgetaggte Literale schreiben; ein einzelnes ungetaggtes xsd:string bleibt ein legales rdfs:Literal, die Weitung ist rueckwaertskompatibel."@de .

arknet:description
    a owl:DatatypeProperty ;
    rdfs:range   xsd:string ;
    rdfs:label   "description"@en ;
    rdfs:comment "A free-text description of a concept."@en ,
                 "Eine Freitext-Beschreibung eines Konzepts."@de .

arknet:since
    a owl:DatatypeProperty ;
    rdfs:range   xsd:string ;
    rdfs:label   "since"@en ;
    rdfs:comment "Version oder Datum, ab der dieses Konzept gilt."@de .

arknet:deprecated
    a owl:DatatypeProperty ;
    rdfs:range   xsd:boolean ;
    rdfs:label   "deprecated"@en ;
    rdfs:comment "Marks this concept as deprecated."@en ,
                 "Markiert dieses Konzept als veraltet."@de .

arknet:externalDoc
    a owl:DatatypeProperty ;
    rdfs:range   xsd:anyURI ;
    rdfs:label   "external documentation"@en ;
    rdfs:comment "A link to external documentation for this concept."@en ,
                 "Ein Verweis auf externe Dokumentation zu diesem Konzept."@de .

arknet:qualityAttribute
    a owl:DatatypeProperty ;
    rdfs:range   xsd:string ;
    rdfs:label   "quality attribute"@en ;
    rdfs:comment "Qualitaetsattribut (z.B. availability:99.9, latency:<50ms)."@de .

arknet:position
    a owl:DatatypeProperty ;
    rdfs:range   xsd:integer ;
    rdfs:label   "position"@en , "Position"@de ;
    rdfs:comment "The 1-based, gap-free technical ordering of a child resource within its parent's list (never a caller-facing business identity). Deliberately carries no rdfs:domain, the same domain-agnostic shape arkreq:position already had as the only property of the requirements module without one -- this is that property's honest namespace, moved (kogn-io/arknet#357). arkreq:position itself is untouched and stays in place until the target-cut migration (issue #352); new child resources (e.g. arkarch:Consequence, arkarch:ConsideredOption) use this one instead."@en , "Die 1-basierte, luecken- und duplikatfreie technische Reihenfolge einer Kind-Ressource innerhalb der Liste ihres Elternteils (nie eine vom Aufrufer sichtbare Business-Identitaet). Bewusst ohne rdfs:domain, dieselbe domaenen-agnostische Form, die arkreq:position als einzige Property des Requirements-Moduls ohne eine solche bereits hatte -- dies ist deren ehrlicher Namespace, umgezogen (kogn-io/arknet#357). arkreq:position selbst bleibt unangetastet, bis der Zielschnitt (Issue #352) es nachzieht; neue Kind-Ressourcen (z.B. arkarch:Consequence, arkarch:ConsideredOption) nutzen stattdessen dieses hier."@de .

# END OF CORE ONTOLOGY
