##############################################################################
#  arknet - Architecture Knowledge Net
#  Requirements SHACL Shapes  :  Version 0.3.0
#
#  Validates requirements-specific concepts (arkreq:).
#  Core DDD shapes are in arknet-shapes.ttl, process shapes in process-shapes.ttl.
#
#  Named PropertyShapes fuer RDF4J SHACL Sail Kompatibilitaet.
#  targetClass zeigt auf arkreq-Klassen (Instanzen sind so typisiert),
#  Identitaet/Text wird gegen dcterms geprueft (OSLC-RM-Alignment).
##############################################################################

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix arkreq:  <https://w3id.org/arknet/requirements#> .
@prefix arkproc: <https://w3id.org/arknet/process#> .
@prefix oslc_rm: <http://open-services.net/ns/rm#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rshapes: <https://w3id.org/arknet/shapes/requirements#> .


##############################################################################
#  REQUIREMENT SHAPES
##############################################################################

rshapes:RequirementShape
    a sh:NodeShape ;
    sh:targetClass arkreq:Requirement ;
    sh:property rshapes:Requirement-identifier ;
    sh:property rshapes:Requirement-title ;
    sh:property rshapes:Requirement-description ;
    sh:property rshapes:Requirement-rationale ;
    sh:property rshapes:Requirement-priority ;
    sh:property rshapes:Requirement-status ;
    sh:property rshapes:Requirement-motivatedBy ;
    sh:property rshapes:Requirement-motivatedBy-count ;
    sh:property rshapes:Requirement-usesTerm ;
    sh:property rshapes:Requirement-acceptanceCriterion ;
    sh:property rshapes:Requirement-constrainedBy .

rshapes:Requirement-identifier
    a sh:PropertyShape ;
    sh:path     dcterms:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 2 ;
    sh:pattern  "^[A-Za-z][A-Za-z0-9_.-]*$" ;
    sh:message  "A Requirement needs exactly one dcterms:identifier (e.g. FR-12), format: a letter followed by letters/digits/_.-"@en , "Requirement braucht genau eine dcterms:identifier (z.B. FR-12), Format: Buchstabe gefolgt von Buchstaben/Ziffern/_.-"@de ;
    sh:severity sh:Violation .

rshapes:Requirement-title
    a sh:PropertyShape ;
    sh:path     dcterms:title ;
    sh:minCount 1 ;
    sh:minLength 2 ;
    sh:uniqueLang true ;
    sh:message  "A Requirement needs at least one dcterms:title. sh:uniqueLang allows at most one dcterms:title per non-empty language tag - two titles sharing the same tag (e.g. both @en) are not allowed, but DIFFERENT language tags are (a requirement may be titled in several languages)."@en , "Requirement braucht mindestens eine dcterms:title. sh:uniqueLang erlaubt hoechstens eine dcterms:title je nicht-leerem Sprach-Tag - zwei Titel mit demselben Tag (z.B. beide @en) sind nicht erlaubt, VERSCHIEDENE Sprach-Tags dagegen schon (eine Requirement darf mehrsprachig betitelt sein)."@de ;
    sh:severity sh:Violation .

rshapes:Requirement-description
    a sh:PropertyShape ;
    sh:path     dcterms:description ;
    sh:minCount 1 ;
    sh:minLength 5 ;
    sh:uniqueLang true ;
    sh:message  "A Requirement needs at least one dcterms:description (the normative statement, min. 5 characters). sh:uniqueLang allows at most one dcterms:description per non-empty language tag - two descriptions sharing the same tag are not allowed, but DIFFERENT language tags are (the normative statement may be given in several languages)."@en , "Requirement braucht mindestens eine dcterms:description (die normative Aussage, min. 5 Zeichen). sh:uniqueLang erlaubt hoechstens eine dcterms:description je nicht-leerem Sprach-Tag - zwei Beschreibungen mit demselben Tag sind nicht erlaubt, VERSCHIEDENE Sprach-Tags dagegen schon (die normative Aussage darf mehrsprachig vorliegen)."@de ;
    sh:severity sh:Violation .

rshapes:Requirement-rationale
    a sh:PropertyShape ;
    sh:path     arkreq:rationale ;
    sh:minLength 5 ;
    sh:uniqueLang true ;
    sh:message  "A Requirement may carry arkreq:rationale (WHY it exists, min. 5 characters). Deliberately optional - unlike dcterms:description it has no sh:minCount, so a requirement without a recorded reason stays legal (issue #321). sh:uniqueLang allows at most one arkreq:rationale per non-empty language tag - two rationales sharing the same tag are not allowed, but DIFFERENT language tags are (the reason may be given in several languages)."@en , "Requirement darf eine arkreq:rationale tragen (das WARUM, min. 5 Zeichen). Bewusst optional - anders als dcterms:description ohne sh:minCount, ein Requirement ohne festgehaltene Begruendung bleibt also legal (issue #321). sh:uniqueLang erlaubt hoechstens eine arkreq:rationale je nicht-leerem Sprach-Tag - zwei Begruendungen mit demselben Tag sind nicht erlaubt, VERSCHIEDENE Sprach-Tags dagegen schon (die Begruendung darf mehrsprachig vorliegen)."@de ;
    sh:severity sh:Violation .

rshapes:Requirement-priority
    a sh:PropertyShape ;
    sh:path     arkreq:priority ;
    sh:maxCount 1 ;
    sh:in       ( arkreq:MustHave arkreq:ShouldHave arkreq:CouldHave arkreq:WontHave ) ;
    sh:message  "A Requirement should have an arkreq:priority (MoSCoW: MustHave | ShouldHave | CouldHave | WontHave)."@en , "Requirement sollte eine arkreq:priority (MoSCoW: MustHave | ShouldHave | CouldHave | WontHave) haben."@de ;
    sh:severity sh:Warning .

rshapes:Requirement-status
    a sh:PropertyShape ;
    sh:path     arkreq:status ;
    sh:maxCount 1 ;
    sh:in       ( arkreq:Proposed arkreq:Accepted arkreq:Implemented
                  arkreq:Verified arkreq:Rejected arkreq:Deprecated ) ;
    sh:message  "arkreq:status must be one of the valid lifecycle values (Proposed | Accepted | Implemented | Verified | Rejected | Deprecated)."@en , "arkreq:status muss einer der gueltigen Lifecycle-Werte sein (Proposed | Accepted | Implemented | Verified | Rejected | Deprecated)."@de ;
    sh:severity sh:Violation .

rshapes:Requirement-motivatedBy
    a sh:PropertyShape ;
    sh:path     arkreq:motivatedBy ;
    sh:class    arkreq:Goal ;
    sh:message  "Best practice: link the requirement to a Goal via arkreq:motivatedBy (traceability to the WHY)."@en , "Best Practice: Verknuepfe die Anforderung ueber arkreq:motivatedBy mit einem Goal (Traceability zum WARUM)."@de ;
    sh:severity sh:Warning .

rshapes:Requirement-motivatedBy-count
    a sh:PropertyShape ;
    sh:path     arkreq:motivatedBy ;
    sh:maxCount 1 ;
    sh:message  "A Requirement may have at most one arkreq:motivatedBy (the domain field is single-valued)."@en , "Requirement darf hoechstens ein arkreq:motivatedBy haben (Domain-Feld ist einwertig)."@de ;
    sh:severity sh:Violation .

rshapes:Requirement-usesTerm
    a sh:PropertyShape ;
    sh:path     arkreq:usesTerm ;
    sh:nodeKind sh:IRI ;
    sh:class    skos:Concept ;
    sh:message  "arkreq:usesTerm must reference a glossary term (skos:Concept, IRI) -- create it first with term_add."@en , "arkreq:usesTerm muss auf einen Glossar-Begriff (skos:Concept, IRI) verweisen -- lege ihn zuerst mit term_add an."@de ;
    sh:severity sh:Violation .

rshapes:Requirement-acceptanceCriterion
    a sh:PropertyShape ;
    sh:path     arkreq:acceptanceCriterion ;
    sh:minCount 1 ;
    sh:class    arkreq:AcceptanceCriterion ;
    sh:message  "A Requirement needs at least one arkreq:acceptanceCriterion (a testable done-when, its own arkreq:AcceptanceCriterion resource)."@en , "Requirement braucht mindestens ein arkreq:acceptanceCriterion (testbares Done-when, eigene arkreq:AcceptanceCriterion-Ressource)."@de ;
    sh:severity sh:Violation .

rshapes:Requirement-constrainedBy
    a sh:PropertyShape ;
    sh:path     oslc_rm:constrainedBy ;
    sh:nodeKind sh:IRI ;
    sh:class    arkreq:Constraint ;
    sh:message  "oslc_rm:constrainedBy must reference a constraint (arkreq:Constraint, IRI) -- create it first with constraint_add."@en , "oslc_rm:constrainedBy muss auf eine Randbedingung (arkreq:Constraint, IRI) verweisen -- lege sie zuerst mit constraint_add an."@de ;
    sh:severity sh:Violation .


##############################################################################
#  NON-FUNCTIONAL REQUIREMENT SHAPES
##############################################################################

rshapes:NonFunctionalRequirementShape
    a sh:NodeShape ;
    sh:targetClass arkreq:NonFunctionalRequirement ;
    sh:property rshapes:NFR-qualityCategory .

rshapes:NFR-qualityCategory
    a sh:PropertyShape ;
    sh:path     arkreq:qualityCategory ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message  "A Non-Functional Requirement should state an arkreq:qualityCategory (e.g. performance, security, reliability)."@en , "Non-Functional Requirement sollte eine arkreq:qualityCategory nennen (z.B. performance, security, reliability)."@de ;
    sh:severity sh:Warning .


##############################################################################
#  GOAL SHAPES
##############################################################################

rshapes:GoalShape
    a sh:NodeShape ;
    sh:targetClass arkreq:Goal ;
    sh:property rshapes:Goal-statement .

rshapes:Goal-statement
    a sh:PropertyShape ;
    sh:path     arkreq:goalStatement ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 5 ;
    sh:message  "A Goal needs an arkreq:goalStatement (min. 5 characters)."@en , "Goal braucht eine arkreq:goalStatement (min. 5 Zeichen)."@de ;
    sh:severity sh:Violation .


##############################################################################
#  CONSTRAINT SHAPES
##############################################################################

rshapes:ConstraintShape
    a sh:NodeShape ;
    sh:targetClass arkreq:Constraint ;
    sh:property rshapes:Constraint-title ;
    sh:property rshapes:Constraint-statement .

rshapes:Constraint-title
    a sh:PropertyShape ;
    sh:path     dcterms:title ;
    sh:minCount 1 ;
    sh:minLength 2 ;
    sh:uniqueLang true ;
    sh:message  "A Constraint needs at least one dcterms:title. sh:uniqueLang allows at most one dcterms:title per non-empty language tag - two titles sharing the same tag (e.g. both @en) are not allowed, but DIFFERENT language tags are (a constraint may be titled in several languages)."@en , "Constraint braucht mindestens eine dcterms:title. sh:uniqueLang erlaubt hoechstens eine dcterms:title je nicht-leerem Sprach-Tag - zwei Titel mit demselben Tag (z.B. beide @en) sind nicht erlaubt, VERSCHIEDENE Sprach-Tags dagegen schon (eine Constraint darf mehrsprachig betitelt sein)."@de ;
    sh:severity sh:Violation .

rshapes:Constraint-statement
    a sh:PropertyShape ;
    sh:path     arkreq:constraintStatement ;
    sh:minCount 1 ;
    sh:minLength 5 ;
    sh:uniqueLang true ;
    sh:message  "A Constraint needs at least one arkreq:constraintStatement (min. 5 characters). sh:uniqueLang allows at most one arkreq:constraintStatement per non-empty language tag - two statements sharing the same tag are not allowed, but DIFFERENT language tags are (a constraint may be stated in several languages)."@en , "Constraint braucht mindestens eine arkreq:constraintStatement (min. 5 Zeichen). sh:uniqueLang erlaubt hoechstens eine arkreq:constraintStatement je nicht-leerem Sprach-Tag - zwei Statements mit demselben Tag sind nicht erlaubt, VERSCHIEDENE Sprach-Tags dagegen schon (eine Constraint darf mehrsprachig formuliert sein)."@de ;
    sh:severity sh:Violation .


##############################################################################
#  USE CASE SHAPES
##############################################################################

rshapes:UseCaseShape
    a sh:NodeShape ;
    sh:targetClass arkreq:UseCase ;
    sh:property rshapes:UseCase-identifier ;
    sh:property rshapes:UseCase-title ;
    sh:property rshapes:UseCase-goal ;
    sh:property rshapes:UseCase-goal-uniqueLang ;
    sh:property rshapes:UseCase-scope-uniqueLang ;
    sh:property rshapes:UseCase-trigger-uniqueLang ;
    sh:property rshapes:UseCase-precondition-uniqueLang ;
    sh:property rshapes:UseCase-postcondition-uniqueLang ;
    sh:property rshapes:UseCase-primaryActor ;
    sh:property rshapes:UseCase-satisfies ;
    sh:property rshapes:UseCase-mainStep .

rshapes:UseCase-identifier
    a sh:PropertyShape ;
    sh:path     dcterms:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 2 ;
    sh:message  "A Use Case needs exactly one dcterms:identifier (e.g. UC-3)."@en , "Use Case braucht genau eine dcterms:identifier (z.B. UC-3)."@de ;
    sh:severity sh:Violation .

rshapes:UseCase-title
    a sh:PropertyShape ;
    sh:path     dcterms:title ;
    sh:minCount 1 ;
    sh:minLength 2 ;
    sh:uniqueLang true ;
    sh:message  "A Use Case needs at least one dcterms:title. sh:uniqueLang allows at most one dcterms:title per non-empty language tag - two titles sharing the same tag are not allowed, but DIFFERENT language tags are (a use case may be titled in several languages)."@en , "Use Case braucht mindestens eine dcterms:title. sh:uniqueLang erlaubt hoechstens eine dcterms:title je nicht-leerem Sprach-Tag - zwei Titel mit demselben Tag sind nicht erlaubt, VERSCHIEDENE Sprach-Tags dagegen schon (ein Use Case darf mehrsprachig betitelt sein)."@de ;
    sh:severity sh:Violation .

rshapes:UseCase-goal
    a sh:PropertyShape ;
    sh:path     arkreq:useCaseGoal ;
    sh:minCount 1 ;
    sh:message  "A Use Case should state an arkreq:useCaseGoal (goal-in-context)."@en , "Use Case sollte ein arkreq:useCaseGoal (goal-in-context) nennen."@de ;
    sh:severity sh:Warning .

rshapes:UseCase-goal-uniqueLang
    a sh:PropertyShape ;
    sh:path     arkreq:useCaseGoal ;
    sh:uniqueLang true ;
    sh:message  "sh:uniqueLang allows at most one arkreq:useCaseGoal per non-empty language tag - two goals sharing the same tag are not allowed, but DIFFERENT language tags are (the goal may be stated in several languages). Formerly a plain sh:maxCount 1 (the domain field is single-valued)."@en , "sh:uniqueLang erlaubt hoechstens ein arkreq:useCaseGoal je nicht-leerem Sprach-Tag - zwei Goals mit demselben Tag sind nicht erlaubt, VERSCHIEDENE Sprach-Tags dagegen schon (das Goal darf mehrsprachig formuliert sein). Vormals ein einfaches sh:maxCount 1 (Domain-Feld ist einwertig)."@de ;
    sh:severity sh:Violation .

rshapes:UseCase-scope-uniqueLang
    a sh:PropertyShape ;
    sh:path     arkreq:designScope ;
    sh:uniqueLang true ;
    sh:message  "sh:uniqueLang allows at most one arkreq:designScope per non-empty language tag - two scope statements sharing the same tag are not allowed, but DIFFERENT language tags are (the design scope, itself optional, may be stated in several languages)."@en , "sh:uniqueLang erlaubt hoechstens eine arkreq:designScope je nicht-leerem Sprach-Tag - zwei Scope-Angaben mit demselben Tag sind nicht erlaubt, VERSCHIEDENE Sprach-Tags dagegen schon (der optionale Design Scope darf mehrsprachig formuliert sein)."@de ;
    sh:severity sh:Violation .

rshapes:UseCase-trigger-uniqueLang
    a sh:PropertyShape ;
    sh:path     arkreq:trigger ;
    sh:uniqueLang true ;
    sh:message  "sh:uniqueLang allows at most one arkreq:trigger per non-empty language tag - two triggers sharing the same tag are not allowed, but DIFFERENT language tags are (the triggering event, itself optional, may be stated in several languages)."@en , "sh:uniqueLang erlaubt hoechstens einen arkreq:trigger je nicht-leerem Sprach-Tag - zwei Trigger mit demselben Tag sind nicht erlaubt, VERSCHIEDENE Sprach-Tags dagegen schon (das optionale ausloesende Ereignis darf mehrsprachig formuliert sein)."@de ;
    sh:severity sh:Violation .

rshapes:UseCase-precondition-uniqueLang
    a sh:PropertyShape ;
    sh:path     arkreq:useCasePrecondition ;
    sh:uniqueLang true ;
    sh:message  "sh:uniqueLang allows at most one arkreq:useCasePrecondition per non-empty language tag - two preconditions sharing the same tag are not allowed, but DIFFERENT language tags are (the precondition, itself optional, may be stated in several languages)."@en , "sh:uniqueLang erlaubt hoechstens eine arkreq:useCasePrecondition je nicht-leerem Sprach-Tag - zwei Preconditions mit demselben Tag sind nicht erlaubt, VERSCHIEDENE Sprach-Tags dagegen schon (die optionale Precondition darf mehrsprachig formuliert sein)."@de ;
    sh:severity sh:Violation .

rshapes:UseCase-postcondition-uniqueLang
    a sh:PropertyShape ;
    sh:path     arkreq:useCasePostcondition ;
    sh:uniqueLang true ;
    sh:message  "sh:uniqueLang allows at most one arkreq:useCasePostcondition per non-empty language tag - two postconditions sharing the same tag are not allowed, but DIFFERENT language tags are (the postcondition, itself optional, may be stated in several languages)."@en , "sh:uniqueLang erlaubt hoechstens eine arkreq:useCasePostcondition je nicht-leerem Sprach-Tag - zwei Postconditions mit demselben Tag sind nicht erlaubt, VERSCHIEDENE Sprach-Tags dagegen schon (die optionale Postcondition darf mehrsprachig formuliert sein)."@de ;
    sh:severity sh:Violation .

rshapes:UseCase-primaryActor
    a sh:PropertyShape ;
    sh:path     arkreq:primaryActor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class    arkproc:Actor ;
    sh:message  "A Use Case needs exactly one arkreq:primaryActor."@en , "Use Case braucht genau einen arkreq:primaryActor."@de ;
    sh:severity sh:Violation .

rshapes:UseCase-satisfies
    a sh:PropertyShape ;
    sh:path     oslc_rm:satisfies ;
    sh:minCount 1 ;
    sh:class    arkreq:Requirement ;
    sh:message  "Best practice: a Use Case should satisfy at least one requirement via oslc_rm:satisfies (traceability)."@en , "Best Practice: Use Case sollte ueber oslc_rm:satisfies mindestens eine Anforderung erfuellen (Traceability)."@de ;
    sh:severity sh:Warning .

rshapes:UseCase-mainStep
    a sh:PropertyShape ;
    sh:path     arkreq:mainStep ;
    sh:minCount 1 ;
    sh:class    arkreq:Step ;
    sh:message  "A Use Case should have a main flow of arkreq:mainStep steps."@en , "Use Case sollte einen Hauptablauf aus arkreq:mainStep-Schritten haben."@de ;
    sh:severity sh:Warning .


##############################################################################
#  FLOW STEP SHAPES
##############################################################################

rshapes:StepShape
    a sh:NodeShape ;
    sh:targetClass arkreq:Step ;
    sh:property rshapes:Step-position ;
    sh:property rshapes:Step-text ;
    sh:property rshapes:Step-realises .

rshapes:Step-position
    a sh:PropertyShape ;
    sh:path     arkreq:position ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 1 ;
    sh:message  "A Step needs exactly one arkreq:position (1-based order, >= 1)."@en , "Step braucht genau eine arkreq:position (1-basierte Ordnung, >= 1)."@de ;
    sh:severity sh:Violation .

rshapes:Step-text
    a sh:PropertyShape ;
    sh:path     arkreq:stepText ;
    sh:minCount 1 ;
    sh:minLength 3 ;
    sh:uniqueLang true ;
    sh:message  "A Step needs at least one arkreq:stepText (min. 3 characters). sh:uniqueLang allows at most one arkreq:stepText per non-empty language tag - two step texts sharing the same tag are not allowed, but DIFFERENT language tags are (a step's wording may be given in several languages)."@en , "Step braucht mindestens einen arkreq:stepText (min. 3 Zeichen). sh:uniqueLang erlaubt hoechstens einen arkreq:stepText je nicht-leerem Sprach-Tag - zwei Step-Texte mit demselben Tag sind nicht erlaubt, VERSCHIEDENE Sprach-Tags dagegen schon (der Wortlaut eines Steps darf mehrsprachig vorliegen)."@de ;
    sh:severity sh:Violation .

rshapes:Step-realises
    a sh:PropertyShape ;
    sh:path     arkreq:stepRealises ;
    sh:class    arkreq:Requirement ;
    sh:message  "arkreq:stepRealises must point to an arkreq:Requirement."@en , "arkreq:stepRealises muss auf ein arkreq:Requirement zeigen."@de ;
    sh:severity sh:Violation .


##############################################################################
#  ACCEPTANCE CRITERION SHAPES  (issue #266 -- own resource instead of a
#  flat, untagged xsd:string multiset; mirrors the STEP SHAPES above)
##############################################################################

rshapes:AcceptanceCriterionShape
    a sh:NodeShape ;
    sh:targetClass arkreq:AcceptanceCriterion ;
    sh:property rshapes:AcceptanceCriterion-position ;
    sh:property rshapes:AcceptanceCriterion-text .

rshapes:AcceptanceCriterion-position
    a sh:PropertyShape ;
    sh:path     arkreq:position ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 1 ;
    sh:message  "An AcceptanceCriterion needs exactly one arkreq:position (1-based order, >= 1)."@en , "AcceptanceCriterion braucht genau eine arkreq:position (1-basierte Ordnung, >= 1)."@de ;
    sh:severity sh:Violation .

rshapes:AcceptanceCriterion-text
    a sh:PropertyShape ;
    sh:path     arkreq:criterionText ;
    sh:minCount 1 ;
    sh:minLength 5 ;
    sh:uniqueLang true ;
    sh:message  "An AcceptanceCriterion needs at least one arkreq:criterionText (min. 5 characters). sh:uniqueLang allows at most one arkreq:criterionText per non-empty language tag - two criterion texts sharing the same tag are not allowed, but DIFFERENT language tags are (a criterion's wording may be given in several languages)."@en , "AcceptanceCriterion braucht mindestens einen arkreq:criterionText (min. 5 Zeichen). sh:uniqueLang erlaubt hoechstens einen arkreq:criterionText je nicht-leerem Sprach-Tag - zwei Kriterientexte mit demselben Tag sind nicht erlaubt, VERSCHIEDENE Sprach-Tags dagegen schon (der Wortlaut eines Kriteriums darf mehrsprachig vorliegen)."@de ;
    sh:severity sh:Violation .


##############################################################################
#  MILESTONE SHAPES
##############################################################################

rshapes:MilestoneShape
    a sh:NodeShape ;
    sh:targetClass arkreq:Milestone ;
    sh:property rshapes:Milestone-title ;
    sh:property rshapes:Milestone-dueDate ;
    sh:property rshapes:Milestone-state .

rshapes:Milestone-title
    a sh:PropertyShape ;
    sh:path     arkreq:milestoneTitle ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 2 ;
    sh:message  "A Milestone needs exactly one arkreq:milestoneTitle."@en , "Milestone braucht genau einen arkreq:milestoneTitle."@de ;
    sh:severity sh:Violation .

rshapes:Milestone-dueDate
    a sh:PropertyShape ;
    sh:path     arkreq:dueDate ;
    sh:maxCount 1 ;
    sh:datatype xsd:date ;
    sh:message  "arkreq:dueDate must be an xsd:date."@en , "arkreq:dueDate muss ein xsd:date sein."@de ;
    sh:severity sh:Violation .

rshapes:Milestone-state
    a sh:PropertyShape ;
    sh:path     arkreq:milestoneState ;
    sh:maxCount 1 ;
    sh:in       ( arkreq:Open arkreq:Closed ) ;
    sh:message  "arkreq:milestoneState must be Open or Closed."@en , "arkreq:milestoneState muss Open oder Closed sein."@de ;
    sh:severity sh:Violation .


##############################################################################
#  RELEASE SHAPES
##############################################################################

rshapes:ReleaseShape
    a sh:NodeShape ;
    sh:targetClass arkreq:Release ;
    sh:property rshapes:Release-version .

rshapes:Release-version
    a sh:PropertyShape ;
    sh:path     arkreq:releaseVersion ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern  "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" ;
    sh:message  "A Release needs exactly one arkreq:releaseVersion following Semantic Versioning (e.g. 1.4.2 or 1.0.0-rc.1)."@en , "Release braucht genau eine arkreq:releaseVersion nach Semantic Versioning (z.B. 1.4.2 oder 1.0.0-rc.1)."@de ;
    sh:severity sh:Violation .

# END OF REQUIREMENTS SHAPES
