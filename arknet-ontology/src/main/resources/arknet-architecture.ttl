##############################################################################
#  arknet - Architecture Knowledge Net
#  Architecture Ontology  :  Version 0.1.0
#
#  Namespace  : https://w3id.org/arknet/architecture#
#  License    : CC-BY-4.0
#
#  Scope: Architecture Decision Records (ADR) nach ISO/IEC/IEEE 42010 -
#  ArchitectureDecisionRecord, seine Textfelder, seine Beziehungen und der
#  ADR-Lebenszyklus als Individuen. Die uebrige 42010-Architekturbeschreibung
#  (Architecture, ArchitectureDescription, Stakeholder, Concern, Viewpoint,
#  View) hat noch keinen aktiven Konsumenten und bleibt in
#  parked/arknet-architecture_parked.ttl, teilt sich aber diesen Namespace.
#
#  GENERISCH: Allgemeines 42010-Metamodell fuer JEDES Projekt.
#
#  Standard-Situation (im Gegensatz zum Requirements-Modul):
#    Fuer ISO 42010 existiert KEIN adoptiertes, dereferenzierbares RDF-Vokabular
#    zum Wiederverwenden -- nur akademische Vorschlaege (OntolAD, OWL-2-Formal-
#    isierungen) ohne stabile publizierte Namespace. Daher arkarch-eigen.
#    Prior art: OntolAD (Formal Ontology for Architectural Descriptions, OWL 2).
#
#  Cross-Modul-Mehrwert:
#    ADR -> arkreq:Requirement (welche Anforderung adressiert die Entscheidung)
#    ADR -> arkddd:BoundedContext (welchen Teil des Systems betrifft sie)
#
#  Konvention: Instanzen nutzen arknet:name / arknet:description (Core-Reuse,
#              Hausstil). ADRs tragen zusaetzlich dcterms:identifier (Nummer),
#              da ADRs konventionell nummeriert sind (wie Requirements).
#
#  Imports: arknet-ddd (BoundedContext), arknet-core (name, description via arknet-ddd),
#           arknet-requirements (Requirement).
##############################################################################

@prefix arkarch: <https://w3id.org/arknet/architecture#> .
@prefix arkddd:  <https://w3id.org/arknet/ddd#> .
@prefix arknet:  <https://w3id.org/arknet/core#> .
@prefix arkreq:  <https://w3id.org/arknet/requirements#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .


# ============================================================
#  Ontology Metadata
# ============================================================

<https://w3id.org/arknet/architecture>
    a owl:Ontology ;
    owl:imports      <https://w3id.org/arknet/core> ;
    owl:imports      <https://w3id.org/arknet/ddd> ;
    owl:imports      <https://w3id.org/arknet/requirements> ;
    dcterms:title    "arknet Architecture Ontology"@en ;
    dcterms:description "Architecture Decision Records (ISO/IEC/IEEE 42010): context, decision, consequences, considered options, lifecycle status, and the links to requirements and the DDD layer."@en ;
    dcterms:version  "0.1.0" ;
    dcterms:created  "2026-07-11"^^xsd:date ;
    dcterms:rights   "CC-BY-4.0" ;
    vann:preferredNamespacePrefix "arkarch" ;
    vann:preferredNamespaceUri    "https://w3id.org/arknet/architecture#" ;
    owl:versionInfo  "0.1.0" .


##############################################################################
#  1. ARCHITECTURE DECISION RECORDS (ADR)
#     Kern-Link: ADR -> Requirement.
##############################################################################

arkarch:ArchitectureDecisionRecord a owl:Class ;
    rdfs:label   "Architecture Decision Record"@en , "Architekturentscheidung"@de ;
    rdfs:comment "Eine dokumentierte Architekturentscheidung mit Kontext, Entscheidung, Konsequenzen und erwogenen Alternativen (Nygard/MADR-Stil)."@de .

# -- ADR data properties -----------------------------------------------------

arkarch:adrContext a owl:DatatypeProperty ;
    rdfs:domain arkarch:ArchitectureDecisionRecord ;
    rdfs:range  rdfs:Literal ;
    rdfs:label  "context"@en ;
    rdfs:comment "Warum musste diese Entscheidung getroffen werden? Kraefte und Rahmenbedingungen. rdfs:Literal statt xsd:string, mehrsprachig (kogn-io/arknet#357)."@de .

arkarch:adrDecision a owl:DatatypeProperty ;
    rdfs:domain arkarch:ArchitectureDecisionRecord ;
    rdfs:range  rdfs:Literal ;
    rdfs:label  "decision"@en ;
    rdfs:comment "Die getroffene Entscheidung. rdfs:Literal statt xsd:string, mehrsprachig (kogn-io/arknet#357)."@de .

arkarch:adrConsequences a owl:DatatypeProperty ;
    rdfs:domain arkarch:ArchitectureDecisionRecord ;
    rdfs:range  xsd:string ;
    rdfs:label  "consequences"@en ;
    rdfs:comment "Positive und negative Folgen der Entscheidung, als einzelner Freitext. Die Schreibform vor kogn-io/arknet#357: kein Werkzeug schreibt dieses Praedikat mehr (siehe arkarch:consequence), aber ein Bestands-Record traegt es noch weiterhin lesend/bewahrend."@de .

arkarch:adrAlternatives a owl:DatatypeProperty ;
    rdfs:domain arkarch:ArchitectureDecisionRecord ;
    rdfs:range  xsd:string ;
    rdfs:label  "considered options"@en , "erwogene Alternativen"@de ;
    rdfs:comment "Erwogene, aber verworfene Optionen mit kurzer Begruendung (MADR: Considered Options), als einzelner Freitext. Die Schreibform vor kogn-io/arknet#357: kein Werkzeug schreibt dieses Praedikat mehr (siehe arkarch:consideredOption), aber ein Bestands-Record traegt es noch weiterhin lesend/bewahrend."@de .

# -- Consequence (kogn-io/arknet#357: own resource, replacing the pre-#357 flat adrConsequences) ---

arkarch:Consequence a owl:Class ;
    rdfs:label   "Consequence"@en , "Konsequenz"@de ;
    rdfs:comment "Eine einzelne positive, negative oder neutrale Folge einer Architekturentscheidung, mit technischer Position (analog arkreq:AcceptanceCriterion, issue #266)."@de .

arkarch:consequence a owl:ObjectProperty ;
    rdfs:domain arkarch:ArchitectureDecisionRecord ;
    rdfs:range  arkarch:Consequence ;
    rdfs:label  "consequence"@en , "Konsequenz"@de ;
    rdfs:comment "Verweist auf eine einzelne Konsequenz der Entscheidung. 0..n, optional (best practice, keine Pflicht)."@de .

arkarch:consequenceStatement a owl:DatatypeProperty ;
    rdfs:domain arkarch:Consequence ;
    rdfs:range  rdfs:Literal ;
    rdfs:label  "consequence statement"@en , "Konsequenz-Aussage"@de ;
    rdfs:comment "Der Text der Konsequenz. Mehrsprachig (sh:uniqueLang), rdfs:Literal statt xsd:string."@de .

arkarch:consequenceType a owl:ObjectProperty ;
    rdfs:domain arkarch:Consequence ;
    rdfs:range  arkarch:ConsequenceType ;
    a owl:FunctionalProperty ;
    rdfs:label  "consequence type"@en , "Konsequenz-Typ"@de ;
    rdfs:comment "Ob die Konsequenz positiv, negativ oder neutral ist."@de .

arkarch:ConsequenceType a owl:Class ;
    rdfs:label   "Consequence Type"@en , "Konsequenz-Typ"@de ;
    rdfs:comment "Die Art einer Konsequenz: positiv, negativ oder neutral."@de .

arkarch:Positive a owl:NamedIndividual , arkarch:ConsequenceType ;
    rdfs:label "Positive"@en , "Positiv"@de ;
    rdfs:comment "Eine vorteilhafte Konsequenz."@de .

arkarch:Negative a owl:NamedIndividual , arkarch:ConsequenceType ;
    rdfs:label "Negative"@en , "Negativ"@de ;
    rdfs:comment "Eine nachteilige Konsequenz."@de .

arkarch:Neutral a owl:NamedIndividual , arkarch:ConsequenceType ;
    rdfs:label "Neutral"@en , "Neutral"@de ;
    rdfs:comment "Weder eindeutig vorteilhaft noch nachteilig; auch der Typ, den der Lesepfad einer unklassifizierten Bestands-Konsequenz (arkarch:adrConsequences) zuweist."@de .

# -- ConsideredOption (kogn-io/arknet#357: own resource, replacing the pre-#357 flat adrAlternatives)

arkarch:ConsideredOption a owl:Class ;
    rdfs:label   "Considered Option"@en , "Erwogene Option"@de ;
    rdfs:comment "Eine einzelne waehrend der Entscheidung erwogene Option -- gewaehlt oder verworfen -- mit technischer Position (analog arkreq:AcceptanceCriterion, issue #266). Macht auch die gewaehlte Option modellierbar (MADR Decision Outcome), nicht nur die verworfenen wie die Vorgaenger-Form arkarch:adrAlternatives."@de .

arkarch:consideredOption a owl:ObjectProperty ;
    rdfs:domain arkarch:ArchitectureDecisionRecord ;
    rdfs:range  arkarch:ConsideredOption ;
    rdfs:label  "considered option"@en , "Erwogene Option"@de ;
    rdfs:comment "Verweist auf eine einzelne erwogene Option. 0..n, optional (best practice, keine Pflicht). Hoechstens eine je Entscheidung darf arkarch:optionOutcome arkarch:Chosen tragen."@de .

arkarch:optionRationale a owl:DatatypeProperty ;
    rdfs:domain arkarch:ConsideredOption ;
    rdfs:range  rdfs:Literal ;
    rdfs:label  "option rationale"@en , "Options-Begruendung"@de ;
    rdfs:comment "Die Begruendung, warum die Option gewaehlt oder verworfen wurde. Mehrsprachig (sh:uniqueLang), rdfs:Literal statt xsd:string."@de .

arkarch:optionOutcome a owl:ObjectProperty ;
    rdfs:domain arkarch:ConsideredOption ;
    rdfs:range  arkarch:OptionOutcome ;
    a owl:FunctionalProperty ;
    rdfs:label  "option outcome"@en , "Options-Ergebnis"@de ;
    rdfs:comment "Ob die Option gewaehlt oder verworfen wurde."@de .

arkarch:OptionOutcome a owl:Class ;
    rdfs:label   "Option Outcome"@en , "Options-Ergebnis"@de ;
    rdfs:comment "Das Ergebnis einer erwogenen Option: gewaehlt oder verworfen."@de .

arkarch:Chosen a owl:NamedIndividual , arkarch:OptionOutcome ;
    rdfs:label "Chosen"@en , "Gewaehlt"@de ;
    rdfs:comment "Die tatsaechlich gewaehlte Option (MADR Decision Outcome). Hoechstens eine je Entscheidung."@de .

# Named arkarch:OptionRejected, not arkarch:Rejected: that IRI already denotes the unrelated
# ADRStatus individual ("die Entscheidung selbst wurde abgelehnt") -- reusing it here would make one
# individual play two different roles under two different owl:NamedIndividual classes
# (kogn-io/arknet#357, deviation from the issue's literal "Chosen/Rejected" wording, noted in the
# PR description).
arkarch:OptionRejected a owl:NamedIndividual , arkarch:OptionOutcome ;
    rdfs:label "Rejected"@en , "Verworfen"@de ;
    rdfs:comment "Eine erwogene, aber verworfene Option."@de .

arkarch:decisionDate a owl:DatatypeProperty ;
    rdfs:domain arkarch:ArchitectureDecisionRecord ;
    rdfs:range  xsd:date ;
    rdfs:label  "decision date"@en ;
    rdfs:comment "The date on which this decision was made."@en ,
                 "Das Datum, an dem diese Entscheidung getroffen wurde."@de .

# -- ADR relationships -------------------------------------------------------

arkarch:supersedes a owl:ObjectProperty ;
    rdfs:domain arkarch:ArchitectureDecisionRecord ;
    rdfs:range  arkarch:ArchitectureDecisionRecord ;
    rdfs:label  "supersedes"@en , "loest ab"@de ;
    rdfs:comment "The pre-#357 write shape (kogn-io/arknet#357): no longer asserted by any tool, which writes arkarch:supersededBy on the superseded decision instead. Read back only, to keep a store-first record written before that change working."@en ,
                 "Die Schreibform vor #357 (kogn-io/arknet#357): wird von keinem Werkzeug mehr geschrieben, das stattdessen arkarch:supersededBy an der abgeloesten Entscheidung setzt. Nur noch lesbar, damit ein vor der Aenderung geschriebener Bestands-Record funktionsfaehig bleibt."@de .

arkarch:supersededBy a owl:ObjectProperty ;
    rdfs:domain arkarch:ArchitectureDecisionRecord ;
    rdfs:range  arkarch:ArchitectureDecisionRecord ;
    owl:inverseOf arkarch:supersedes ;
    rdfs:label  "superseded by"@en , "abgeloest durch"@de ;
    rdfs:comment "The newer decision that replaces this one. Inverse of supersedes. Written on the superseded decision itself, together with its status transitioning to Superseded, in one write (kogn-io/arknet#357)."@en ,
                 "Die neuere Entscheidung, die diese ersetzt. Inverse von supersedes. Wird an der abgeloesten Entscheidung selbst gesetzt, zusammen mit ihrem Uebergang in den Status Superseded, in einem Schreibvorgang (kogn-io/arknet#357)."@de .

arkarch:relatedTo a owl:ObjectProperty ;
    rdfs:domain arkarch:ArchitectureDecisionRecord ;
    rdfs:range  arkarch:ArchitectureDecisionRecord ;
    a owl:SymmetricProperty ;
    rdfs:label  "related to"@en ;
    rdfs:comment "Lose Querverweis-Beziehung zwischen ADRs."@de .

arkarch:addressesRequirement a owl:ObjectProperty ;
    rdfs:domain arkarch:ArchitectureDecisionRecord ;
    rdfs:range  arkreq:Requirement ;
    rdfs:label  "addresses requirement"@en ;
    rdfs:comment "Kern-Traceability: diese Entscheidung adressiert/realisiert die angegebene Anforderung."@de .

arkarch:affectsContext a owl:ObjectProperty ;
    rdfs:domain arkarch:ArchitectureDecisionRecord ;
    rdfs:range  arkddd:BoundedContext ;
    rdfs:label  "affects context"@en ;
    rdfs:comment "Welchen Bounded Context betrifft diese Entscheidung? Bruecke zur DDD-Schicht."@de .


##############################################################################
#  2. ADR STATUS  (Lifecycle, as Individuals)
##############################################################################

arkarch:ADRStatus a owl:Class ;
    rdfs:label "ADR Status"@en ;
    rdfs:comment "Lebenszyklus-Status einer Architekturentscheidung."@de .

arkarch:Proposed a owl:NamedIndividual , arkarch:ADRStatus ;
    rdfs:label "Proposed"@en ;
    rdfs:comment "Vorgeschlagen, noch nicht angenommen."@de .

arkarch:Accepted a owl:NamedIndividual , arkarch:ADRStatus ;
    rdfs:label "Accepted"@en ;
    rdfs:comment "Angenommen und gueltig."@de .

arkarch:Rejected a owl:NamedIndividual , arkarch:ADRStatus ;
    rdfs:label "Rejected"@en ;
    rdfs:comment "Abgelehnt; nicht umgesetzt."@de .

arkarch:Deprecated a owl:NamedIndividual , arkarch:ADRStatus ;
    rdfs:label "Deprecated"@en ;
    rdfs:comment "Ueberholt, aber nicht durch eine konkrete Nachfolge-Entscheidung ersetzt."@de .

arkarch:Superseded a owl:NamedIndividual , arkarch:ADRStatus ;
    rdfs:label "Superseded"@en ;
    rdfs:comment "Durch eine neuere Entscheidung ersetzt (siehe arkarch:supersededBy)."@de .

arkarch:adrStatus a owl:ObjectProperty ;
    rdfs:domain arkarch:ArchitectureDecisionRecord ;
    rdfs:range  arkarch:ADRStatus ;
    a owl:FunctionalProperty ;
    rdfs:label  "status"@en ;
    rdfs:comment "The current lifecycle status of this architecture decision record."@en ,
                 "Der aktuelle Lebenszyklus-Status dieser Architekturentscheidung."@de .


##############################################################################
#  3. OWL RESTRICTIONS
##############################################################################

# Every ADR has exactly one dcterms:identifier (its number)
arkarch:ArchitectureDecisionRecord rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty dcterms:identifier ;
    owl:cardinality 1
] .

# Every ADR has exactly one status
arkarch:ArchitectureDecisionRecord rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty arkarch:adrStatus ;
    owl:cardinality 1
] .

# END OF ARCHITECTURE ONTOLOGY
