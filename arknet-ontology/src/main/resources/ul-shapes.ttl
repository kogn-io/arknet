##############################################################################
#  arknet - Architecture Knowledge Net
#  Ubiquitous-Language SHACL Shapes  :  Version 0.1.0
#
#  Validates the ubiquitous-language bounded context: glossary terms modelled
#  as skos:Concept (W3C SKOS) instead of bare strings, grouped into per-workspace
#  glossaries (skos:ConceptScheme).
#
#  Named PropertyShapes fuer RDF4J SHACL Sail Kompatibilitaet.
##############################################################################

@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix arkddd:   <https://w3id.org/arknet/ddd#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix ulshapes: <https://w3id.org/arknet/shapes/ul#> .


##############################################################################
#  TERM (skos:Concept) SHAPES
##############################################################################

ulshapes:TermShape
    a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property ulshapes:Term-prefLabel ;
    sh:property ulshapes:Term-definition ;
    sh:property ulshapes:Term-inScheme ;
    sh:property ulshapes:Term-broader .

ulshapes:Term-prefLabel
    a sh:PropertyShape ;
    sh:path     skos:prefLabel ;
    sh:minCount 1 ;
    sh:minLength 1 ;
    sh:uniqueLang true ;
    sh:message  "A glossary term (skos:Concept) needs at least one skos:prefLabel (the term). At most one skos:prefLabel per language tag (SKOS S14) - several untagged or same-language-tagged prefLabels on one term are not allowed, but several DIFFERENT language tags are (a term may be labelled in several languages)."@en , "Ein Glossar-Begriff (skos:Concept) braucht mindestens ein skos:prefLabel (der Fachbegriff). Hoechstens ein skos:prefLabel je Sprach-Tag (SKOS S14) - mehrere untagged oder gleichsprachige prefLabels an einem Begriff sind nicht erlaubt, mehrere VERSCHIEDENE Sprach-Tags dagegen schon (ein Begriff darf mehrsprachig benannt sein)."@de ;
    sh:severity sh:Violation .

ulshapes:Term-definition
    a sh:PropertyShape ;
    sh:path     skos:definition ;
    sh:uniqueLang true ;
    sh:message  "At most one skos:definition per language tag (SKOS S14) - several untagged or same-language-tagged definitions on one term are not allowed, but several DIFFERENT language tags are (a term's meaning may be explained in several languages)."@en , "Hoechstens ein skos:definition je Sprach-Tag (SKOS S14) - mehrere untagged oder gleichsprachige Definitionen an einem Begriff sind nicht erlaubt, mehrere VERSCHIEDENE Sprach-Tags dagegen schon (die Bedeutung eines Begriffs darf mehrsprachig erklaert sein)."@de ;
    sh:severity sh:Violation .

ulshapes:Term-inScheme
    a sh:PropertyShape ;
    sh:path     skos:inScheme ;
    sh:minCount 1 ;
    sh:class    skos:ConceptScheme ;
    sh:message  "Best practice: A term should be placed in a glossary (skos:ConceptScheme) via skos:inScheme."@en , "Best Practice: Ein Begriff sollte via skos:inScheme in einem Glossar (skos:ConceptScheme) liegen."@de ;
    sh:severity sh:Warning .

ulshapes:Term-broader
    a sh:PropertyShape ;
    sh:path     skos:broader ;
    sh:maxCount 1 ;
    sh:class    skos:Concept ;
    sh:nodeKind sh:IRI ;
    sh:message  "skos:broader is optional but, if present, must reference exactly one other skos:Concept (IRI) - the term's single broader (superordinate) term."@en , "skos:broader ist optional, muss aber, falls vorhanden, genau einen anderen skos:Concept (IRI) referenzieren - den einen uebergeordneten (broader) Begriff des Begriffs."@de ;
    sh:severity sh:Violation .


##############################################################################
#  BOUNDED-CONTEXT LINK SHAPE
#
#  arkddd:ubiquitousLanguageTerm verweist jetzt auf einen skos:Concept
#  (breaking: frueher xsd:string). Eigene NodeShape auf arkddd:BoundedContext,
#  damit die Kern-BoundedContext-Shape (arknet-shapes.ttl) unangetastet bleibt.
##############################################################################

ulshapes:BoundedContextTermsShape
    a sh:NodeShape ;
    sh:targetClass arkddd:BoundedContext ;
    sh:property ulshapes:BoundedContext-ubiquitousLanguageTerm .

ulshapes:BoundedContext-ubiquitousLanguageTerm
    a sh:PropertyShape ;
    sh:path     arkddd:ubiquitousLanguageTerm ;
    sh:nodeKind sh:IRI ;
    sh:class    skos:Concept ;
    sh:message  "arkddd:ubiquitousLanguageTerm must reference a skos:Concept (IRI), not a string."@en , "arkddd:ubiquitousLanguageTerm muss auf einen skos:Concept (IRI) verweisen, nicht auf einen String."@de ;
    sh:severity sh:Violation .

# END OF UL SHAPES
