##############################################################################
#  arknet - Architecture Knowledge Net
#  Provenance (Revision) Ontology  :  Version 0.1.0
#
#  Namespace  : https://w3id.org/arknet/provenance#
#  License    : Apache-2.0
#
#  Scope: arknet's PROV-O-based revision vocabulary. Every write through the
#         shared write funnel records - atomically with the model write, in
#         the named graph https://w3id.org/arknet/model/provenance - one
#         immutable revision and rewrites the resource's head pointer:
#
#           <activity> a prov:Activity .
#           <revision> a prov:Entity , arkprov:Revision ;
#                      prov:specializationOf <resource> ;
#                      prov:wasGeneratedBy   <activity> ;
#                      prov:generatedAtTime  "..."^^xsd:dateTime ;
#                      prov:wasRevisionOf    <previous head, if any> .
#           <resource> arkprov:head <revision> .
#
#         Exactly one arkprov:head triple per resource, rewritten with every
#         write THROUGH THE FUNNEL, and each revision chains to the head it
#         superseded via prov:wasRevisionOf. The write activity intentionally
#         carries no resolved agent yet; agent attribution
#         (prov:wasAssociatedWith) is an additive, later extension.
#
#  WHAT THE HEAD PROMISES: every guarded write runs through the funnel, so
#         revision and head move with each of them. Where the caller uses the
#         funnel's compare-and-update variant, the head additionally serves as
#         an optimistic-concurrency token - the expected head is compared
#         inside the write transaction and a stale caller is rejected
#         (ADR-014 decisions 3 and 4). Where the caller uses the unconditional
#         update variant, the head still moves but guards nothing: two
#         concurrent read-modify-writes can lose one of the two changes.
#
#         The head is a funnel-internal token, not a fingerprint of a
#         resource's state. A write issued directly against the store
#         (store-first, ADR-005) changes that state without moving the head,
#         and the next write through the funnel then overwrites it silently.
#
#  NOT A STATE ARCHIVE: a revision records THAT a resource was written, with
#         its instant and its predecessor - not what the resource looked like
#         afterwards. The model graph is still replaced in place, so an
#         earlier state cannot be recovered and two revisions cannot be
#         compared against each other. Whether historical states become
#         queryable is open; ADR-014 defers it, together with the compaction
#         strategy the resulting growth would need.
#
#  NOT VALIDATED BY SHACL: the write gate validates the candidate model graph
#         before the write transaction opens, whereas the revision is written
#         after that, inside the transaction, into the provenance graph - for
#         which arknet ships no shapes. The gate therefore validates a
#         resource's new state, never its revision chain.
#
#  REUSES PROV-O: arkprov: defines only what PROV-O lacks - the Revision
#         subclass and the head pointer. Everything else (Activity, Entity,
#         wasGeneratedBy, generatedAtTime, specializationOf, wasRevisionOf)
#         is plain PROV-O, reused, not reinvented.
#
#  Imports: W3C PROV-O.
##############################################################################

@prefix arkprov: <https://w3id.org/arknet/provenance#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

# ============================================================
#  Ontology Metadata
# ============================================================

<https://w3id.org/arknet/provenance>
    a owl:Ontology ;
    owl:imports      <http://www.w3.org/ns/prov-o#> ;
    dcterms:title    "arknet Provenance Ontology"@en ;
    dcterms:description "arknet's PROV-O-based revision vocabulary: every model write through the shared write funnel produces one immutable revision and moves the resource's head pointer. The head doubles as the optimistic-concurrency token of a conditional write. A revision records that a resource was written, not the state that write produced."@en ;
    dcterms:version  "0.1.0" ;
    dcterms:created  "2026-07-26"^^xsd:date ;
    dcterms:rights   "CC-BY-4.0" ;
    vann:preferredNamespacePrefix "arkprov" ;
    vann:preferredNamespaceUri    "https://w3id.org/arknet/provenance#" ;
    owl:versionInfo  "0.1.0" .

##############################################################################
#  1. REVISION
##############################################################################

arkprov:Revision a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label   "Revision"@en ;
    rdfs:comment "One immutable revision of an arknet model resource, generated by exactly one write through the shared write funnel. Linked to the evolving resource via prov:specializationOf, to the write via prov:wasGeneratedBy, and to the revision it superseded via prov:wasRevisionOf. It records that the resource was written, not the state that write produced - see the coverage note in the file header."@en .

arkprov:head a owl:ObjectProperty ;
    rdfs:range   arkprov:Revision ;
    rdfs:label   "head revision"@en ;
    rdfs:comment "Points from a model resource to its most recent revision. Exactly one head per resource; rewritten atomically with every write that runs through the shared write funnel. It doubles as the optimistic-concurrency token of a conditional write (compare-and-set on the expected head), which is what makes it queryable rather than internal. A write issued directly against the store bypasses the funnel and leaves the head where it is - see the coverage note in the file header. The domain is deliberately open: any arknet model resource can carry a head."@en .
