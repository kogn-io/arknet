##############################################################################
#  arknet - Architecture Knowledge Net
#  Provenance (Revision) Ontology  :  Version 0.1.0
#
#  Namespace  : https://w3id.org/arknet/provenance#
#  License    : Apache-2.0
#
#  Scope: arknet's PROV-O-based revision vocabulary. Every write through the
#         shared write funnel records - atomically with the model write, in
#         the named graph https://w3id.org/arknet/model/provenance - one
#         immutable revision and rewrites the resource's head pointer:
#
#           <activity> a prov:Activity .
#           <revision> a prov:Entity , arkprov:Revision ;
#                      prov:specializationOf <resource> ;
#                      prov:wasGeneratedBy   <activity> ;
#                      prov:generatedAtTime  "..."^^xsd:dateTime ;
#                      prov:wasRevisionOf    <previous head, if any> .
#           <resource> arkprov:head <revision> .
#
#         Exactly one arkprov:head triple per resource, rewritten with every
#         write THROUGH THE FUNNEL, and each revision chains to the head it
#         superseded via prov:wasRevisionOf. The write activity intentionally
#         carries no resolved agent yet; agent attribution
#         (prov:wasAssociatedWith) is an additive, later extension.
#
#  COVERAGE TODAY - the head is not yet a complete history of every write.
#         Four write paths still bypass the funnel and therefore produce
#         NEITHER a revision NOR a head movement: req_update, req_set_status
#         and req_link_term (all three via the requirements context's
#         compare-and-update path) and term_update (the glossary's patch
#         path). Their resolution into the funnel is ADR-014 decision 4. Until
#         then a resource's head marks its last funnel write, not necessarily
#         its last state change - which is also why the head cannot yet serve
#         as a concurrency token for those resources (compare-and-set on the
#         expected head, ADR-014 decision 3, is not implemented and must not
#         be built before those paths are resolved).
#
#  REUSES PROV-O: arkprov: defines only what PROV-O lacks - the Revision
#         subclass and the head pointer. Everything else (Activity, Entity,
#         wasGeneratedBy, generatedAtTime, specializationOf, wasRevisionOf)
#         is plain PROV-O, reused, not reinvented.
#
#  Imports: W3C PROV-O.
##############################################################################

@prefix arkprov: <https://w3id.org/arknet/provenance#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

# ============================================================
#  Ontology Metadata
# ============================================================

<https://w3id.org/arknet/provenance>
    a owl:Ontology ;
    owl:imports      <http://www.w3.org/ns/prov-o#> ;
    dcterms:title    "arknet Provenance Ontology"@en ;
    dcterms:description "arknet's PROV-O-based revision vocabulary: every model write through the shared write funnel produces one immutable revision and moves the resource's head pointer. The head is intended to double as the optimistic-concurrency token once the write paths still bypassing the funnel are resolved."@en ;
    dcterms:version  "0.1.0" ;
    dcterms:created  "2026-07-26"^^xsd:date ;
    dcterms:rights   "Apache-2.0" ;
    vann:preferredNamespacePrefix "arkprov" ;
    vann:preferredNamespaceUri    "https://w3id.org/arknet/provenance#" ;
    owl:versionInfo  "0.1.0" .

##############################################################################
#  1. REVISION
##############################################################################

arkprov:Revision a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label   "Revision"@en ;
    rdfs:comment "One immutable revision of an arknet model resource, generated by exactly one write through the shared write funnel. Linked to the evolving resource via prov:specializationOf, to the write via prov:wasGeneratedBy, and to the revision it superseded via prov:wasRevisionOf. Not every state change produces one yet - see the coverage note in the file header."@en .

arkprov:head a owl:ObjectProperty ;
    rdfs:range   arkprov:Revision ;
    rdfs:label   "head revision"@en ;
    rdfs:comment "Points from a model resource to its most recent revision. Exactly one head per resource; rewritten atomically with every write that runs through the shared write funnel. Write paths bypassing the funnel (see the coverage note in the file header) leave the head where it is, so it is not yet a usable optimistic-concurrency token - being that token is its intent (compare-and-set on the expected head), not yet its guarantee. The domain is deliberately open: any arknet model resource can carry a head."@en .
