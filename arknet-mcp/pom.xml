<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.hauschel.arknet</groupId>
        <artifactId>arknet-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>arknet-mcp</artifactId>
    <description>Composition Root: Spring-Boot-MCP-Server (Streamable HTTP, Loopback), buendelt die Tools der hexagonalen BCs (requirements, ubiquitous-language, use-cases) ueber einen geteilten DatasetLifecycle sowie den generischen Store-Lesepfad (store_overview/resource_get)</description>

    <!-- Lokale Versions-Anhebungen fuer diese (einzige) Spring-Boot-Anwendung. Die rdf4j-BOM
         wird im arknet-parent zuerst importiert und zieht ueber ihren rdf4j-Parent veraltete
         Transitiv-Versionen herein, die den Spring-Boot-4.1-Stack sprengen:
         - SLF4J 1.7.36 / Logback 1.2.13 -> NoClassDefFoundError StatusPrinter2 beim Log-Start.
         jackson-annotations ist NICHT mehr Teil dieser Liste: die rdf4j-bom-Exclusion im
         arknet-parent (#117) laesst die Version von selbst auf die von RDF4J 6.0.0 und
         jackson-databind (jackson3) gemeinsam getragene resolven, kein Hand-Pin mehr noetig.
         Nur dieses Modul ist eine Spring-Boot-Anwendung, deshalb bleiben die Anhebungen lokal. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>2.0.18</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>1.5.38</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-core</artifactId>
                <version>1.5.38</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Requirements-Hexagon: In-Adapter (MCP-Tools) + Out-Adapter (Repository).
             Als Composition Root verdrahtet arknet-mcp das komplette Hexagon zu Beans;
             die Spring-AI-Annotation-Scanner-AutoConfig sammelt die @McpTool-Methoden
             des In-Adapters automatisch ein (kein manuelles Tool-Provider-Bridging mehr). -->
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-requirements-adapter-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-requirements-adapter-kogniordf</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Ubiquitous-Language-Hexagon: zweite hexagonale BC, gleiche Verdrahtung wie
             requirements (In-Adapter mit @McpTool-Beans + Out-Adapter Repository). -->
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-ubiquitous-language-adapter-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-ubiquitous-language-adapter-kogniordf</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Use-Cases-Hexagon: dritte hexagonale BC, gleiche Verdrahtung. Out-Adapter loest
             beim Schreiben Requirement-/Actor-Label-Referenzen gegen DENSELBEN geteilten
             DatasetLifecycle auf, ueber den auch requirements und ubiquitous-language schreiben
             (Cross-BC-Lookup im gemeinsamen Workspace-Store). -->
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-use-cases-adapter-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-use-cases-adapter-kogniordf</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Bounded-Context-Hexagon: vierte hexagonale BC, gleiche Verdrahtung wie die uebrigen
             (In-Adapter mit @McpTool-Beans + Out-Adapter Repository) ueber den geteilten
             DatasetLifecycle. bc_link_term loest Term-Referenzen gegen denselben Workspace-Store
             auf (Cross-BC-Lookup), die Anzeige-Rueckrichtung nutzt den ul-In-Port ResolveTerms. -->
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-bounded-context-adapter-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-bounded-context-adapter-kogniordf</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Persistence-Support: RDF4J-freie Technik-Bausteine. Der generische Store-Lesepfad
             nutzt SparqlTerms (IRIREF-Serialisierung), der Traceability-Lesepfad zusaetzlich
             ArkreqVocabulary (die geteilten arkreq:-Praedikat-IRIs, gemeinsame Quelle mit den
             Out-Adaptern). Bislang nur transitiv ueber die *-adapter-kogniordf gezogen; hier
             explizit deklariert, weil arknet-mcp direkt dagegen compiliert. -->
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-persistence-support</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- kognio-rdf: nur die technologieneutralen Ports (terms + dataset). Der generische
             Store-Report-Lesepfad (store-Paket) fuehrt eine SELECT ?s ?p ?o gegen den geteilten
             DatasetLifecycle aus und liest BindingSet/RDFTerm - ohne direkte RDF4J-Abhaengigkeit.
             Den persistenten Lifecycle-Bean baut die Adapter-Factory (RDF4J bleibt dort gekapselt). -->
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-terms</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-dataset</artifactId>
        </dependency>

        <!-- Spring AI 2.0 MCP-Server ueber Streamable HTTP (webmvc), gebunden auf Loopback
             (issue #137: ein langlebiger, vom Admin gestarteter Prozess pro Workspace statt
             ein stdio-Spawn pro Claude-Code-Session, letzteres kollidierte am
             NativeStore-Verzeichnis-Lock, sobald mehrere Sessions/Worktrees denselben
             Workspace teilen). Version aus spring-ai-bom. Zieht spring-boot-starter-web
             (eingebetteter Tomcat) transitiv. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>de.hauschel.arknet.mcp.ArknetMcpApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
