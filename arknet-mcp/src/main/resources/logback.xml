<?xml version="1.0" encoding="UTF-8"?>
<!--
  stdio MCP server: stdout is the transport channel, so every log line must go
  to stderr instead. A single ConsoleAppender targeting System.err achieves that.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
