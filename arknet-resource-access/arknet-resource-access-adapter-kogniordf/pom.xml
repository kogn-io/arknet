<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.hauschel.arknet</groupId>
        <artifactId>arknet-resource-access</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>arknet-resource-access-adapter-kogniordf</artifactId>
    <description>Out-adapter of generic resource access against the kognio-rdf store.</description>

    <dependencies>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-resource-access-core</artifactId>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-persistence-support</artifactId>
        </dependency>
        <!-- The vocabulary of generic access itself (arknet-resource.ttl) and the core vocabulary
             the model ontologies build on; no module of a bounded context. -->
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-ontology</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-terms</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-dataset</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-dataset-rdf4j</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-dataset-hosting</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-dataset-hosting-rdf4j</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-shacl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-shacl-rdf4j</artifactId>
        </dependency>
        <!-- The ontologies and shapes of the bounded contexts are found at runtime through their
             META-INF/arknet/ontology.index, never named in code and never on the compile
             classpath (ADR-69, consequence 8); the tests put them on the classpath the way the
             composition root does. -->
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-product-requirements-ontology</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-domain-modelling-ontology</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-architecture-decisions-ontology</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-actor-ontology</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
