# One valid resource of every resource type the shipped shapes describe, wired to each other the
# way the typed tools wire them. Children are fragment IRIs of their parent (ADR-64).

@prefix m:       <https://w3id.org/arknet/model/> .
@prefix arknet:  <https://w3id.org/arknet/core#> .
@prefix arkreq:  <https://w3id.org/arknet/requirements#> .
@prefix arkarch: <https://w3id.org/arknet/architecture#> .
@prefix arkddd:  <https://w3id.org/arknet/ddd#> .
@prefix arkproc: <https://w3id.org/arknet/process#> .
@prefix oslc_rm: <http://open-services.net/ns/rm#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

m:term1 a skos:Concept ;
    dcterms:identifier "TERM-1" ;
    skos:prefLabel "Resource"@en ;
    skos:definition "Something the store keeps under an identity."@en ;
    skos:inScheme <https://w3id.org/arknet/model/glossary> .

m:term2 a skos:Concept ;
    dcterms:identifier "TERM-2" ;
    skos:prefLabel "Revision"@en ;
    skos:inScheme <https://w3id.org/arknet/model/glossary> ;
    skos:broader m:term1 ;
    skos:related m:term1 .

m:con1 a arkreq:TechnicalConstraint ;
    dcterms:identifier "TCON-1" ;
    dcterms:title "Java 25"@en ;
    arkreq:constraintStatement "The service runs on Java 25."@en .

m:fr1 a arkreq:FunctionalRequirement ;
    dcterms:identifier "FR-1" ;
    dcterms:title "Write a resource"@en ;
    dcterms:description "The user writes a resource of any type."@en ;
    arkreq:status arkreq:Proposed ;
    arkreq:usesTerm m:term1 ;
    oslc_rm:constrainedBy m:con1 ;
    arkreq:acceptanceCriterion <https://w3id.org/arknet/model/fr1#criterion-1> .

<https://w3id.org/arknet/model/fr1#criterion-1> a arkreq:AcceptanceCriterion ;
    arkreq:position 1 ;
    arkreq:criterionText "The resource is readable afterwards."@en .

m:nfr1 a arkreq:NonFunctionalRequirement ;
    dcterms:identifier "NFR-1" ;
    dcterms:title "Fast writes"@en ;
    dcterms:description "A write completes within a second."@en ;
    arkreq:qualityCategory "performance" ;
    arkreq:acceptanceCriterion <https://w3id.org/arknet/model/nfr1#criterion-1> .

<https://w3id.org/arknet/model/nfr1#criterion-1> a arkreq:AcceptanceCriterion ;
    arkreq:position 1 ;
    arkreq:criterionText "Measured below one second."@en .

m:actor1 a arkproc:HumanActor ;
    dcterms:identifier "ACTOR-1" ;
    arknet:name "Architect"@en .

m:role1 a arkproc:Role ;
    dcterms:identifier "ROLE-1" ;
    arknet:name "Modeller"@en ;
    arkproc:filledBy m:actor1 .

m:uc1 a arkreq:UseCase ;
    dcterms:identifier "UC1" ;
    dcterms:title "Model a decision"@en ;
    arkreq:useCaseGoal "A decision is recorded."@en ;
    arkreq:primaryRole m:role1 ;
    oslc_rm:satisfies m:fr1 ;
    arkreq:usesTerm m:term2 ;
    arkreq:mainStep <https://w3id.org/arknet/model/uc1#step-1> .

<https://w3id.org/arknet/model/uc1#step-1> a arkreq:Step ;
    arkreq:position 1 ;
    arkreq:stepText "The modeller writes the decision."@en ;
    arkreq:stepRealises m:fr1 .

m:bc1 a arkddd:BoundedContext ;
    dcterms:identifier "BC-1" ;
    arknet:name "Modelling"@en ;
    arkddd:domainVision "Keeps the architecture model consistent."@en ;
    arkddd:ubiquitousLanguageTerm m:term1 .

m:bc2 a arkddd:BoundedContext ;
    dcterms:identifier "BC-2" ;
    arknet:name "Export"@en ;
    arkddd:domainVision "Turns the model into documents."@en .

m:rel1 a arkddd:ContextRelationship ;
    arkddd:upstream m:bc1 ;
    arkddd:downstream m:bc2 ;
    arkddd:relationshipType arkddd:CustomerSupplier .

m:adr1 a arkarch:ArchitectureDecisionRecord ;
    dcterms:identifier "ADR-1" ;
    arknet:name "Store resources as RDF"@en ;
    arkarch:adrStatus arkarch:Accepted ;
    arkarch:adrContext "Resources need identities and links."@en ;
    arkarch:adrDecision "Every resource is an RDF resource."@en ;
    arkarch:addressesRequirement m:fr1 ;
    arkarch:affectsContext m:bc1 ;
    arkarch:usesTerm m:term1 ;
    arkarch:consequence <https://w3id.org/arknet/model/adr1#consequence-1> ;
    arkarch:consideredOption <https://w3id.org/arknet/model/adr1#option-1> .

<https://w3id.org/arknet/model/adr1#consequence-1> a arkarch:Consequence ;
    arknet:position 1 ;
    arkarch:consequenceStatement "Links are first-class."@en ;
    arkarch:consequenceType arkarch:Positive .

<https://w3id.org/arknet/model/adr1#option-1> a arkarch:ConsideredOption ;
    arknet:name "RDF"@en ;
    arknet:position 1 ;
    arkarch:optionRationale "Links are first-class."@en ;
    arkarch:optionOutcome arkarch:Chosen .

m:adr2 a arkarch:ArchitectureDecisionRecord ;
    dcterms:identifier "ADR-2" ;
    arknet:name "Keep a history"@en ;
    arkarch:adrStatus arkarch:Proposed ;
    arkarch:adrContext "Changes must be traceable."@en ;
    arkarch:adrDecision "Every write publishes a revision."@en ;
    arkarch:relatedTo m:adr1 .
