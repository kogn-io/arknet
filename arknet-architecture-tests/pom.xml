<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.hauschel.arknet</groupId>
        <artifactId>arknet-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>arknet-architecture-tests</artifactId>

    <name>arknet - Architecture Tests</name>
    <description>
        ArchUnit rules for the dependency invariants that the Maven module cut can NOT
        enforce and that would otherwise rest on reviewer attention alone (#60).
        Deliberately NO production code: the module has only src/test and nobody
        consumes it. It depends (test scope) on the modules it makes claims about.
        That is the price of its own module cut; the alternative would have been to
        put the rules into arknet-mcp, which as the composition root depends broadly
        anyway, but hosts wiring rather than architectural control.
    </description>

    <dependencies>
        <!-- Regel 1: das persistence-support-Modul, dessen RDF4J-Freiheit diese Regel prueft. -->
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-persistence-support</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Regel 2: die Out-Adapter, in denen nur die Repository-Factory RDF4J nennen darf.
             Sie ziehen die *-core transitiv mit, die Regel 3 prueft. Diese sind unten trotzdem
             explizit deklariert: ein Architektur-Test-Modul soll benennen, worueber es urteilt,
             statt sich auf Transitivitaet zu verlassen. -->
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-requirements-adapter-kogniordf</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-ubiquitous-language-adapter-kogniordf</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-use-cases-adapter-kogniordf</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-bounded-context-adapter-kogniordf</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-project-adapter-kogniordf</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-adr-adapter-kogniordf</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-actor-adapter-kogniordf</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Regel 3: die technologieneutralen Hexagon-Inneren. -->
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-requirements-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-ubiquitous-language-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-use-cases-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-bounded-context-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-project-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-adr-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-actor-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Regel 4: die In-Adapter (MCP), die trotz der Borrowed-In-Port-Erlaubnis
             keine RDF-Technologie sehen duerfen. -->
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-requirements-adapter-mcp</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-ubiquitous-language-adapter-mcp</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-use-cases-adapter-mcp</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-bounded-context-adapter-mcp</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-project-adapter-mcp</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-adr-adapter-mcp</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-actor-adapter-mcp</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Regel 5: die Composition Root (arknet-mcp), die laut eigenem Javadoc frei von
             direktem RDF4J bleibt, ohne dass ein Test das je geprueft haette (#185). -->
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-mcp</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Die Vokabular-/Ontologie-Regel ist ein gewoehnlicher JUnit-Test, kein ArchUnit-
             Regelfeld: archunit-junit5 bringt nur die Platform-Engine mit, nicht die
             Jupiter-Engine, die ein @Test zum Laufen braucht. Die Ontologie-Ressourcen und
             der Turtle-Parser kommen transitiv ueber die oben deklarierten Out-Adapter. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
