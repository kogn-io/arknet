<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.hauschel.arknet</groupId>
        <artifactId>arknet-actor</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>arknet-actor-adapter-kogniordf</artifactId>
    <description>Out-adapter: implements ActorRepository on top of kognio-rdf (embeddable RDF substrate). Actors are persisted as arkproc:HumanActor/SystemActor/LegalActor/GroupActor.</description>

    <dependencies>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-actor-core</artifactId>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-persistence-support</artifactId>
        </dependency>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-ontology</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-terms</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-dataset</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-dataset-rdf4j</artifactId>
        </dependency>
        <!-- DatasetLifecycle/DatasetHandle/DatasetId/DatasetStoreConfig and their RDF4J
             implementation live in these dedicated hosting port/adapter modules since
             kognio-rdf 0.2.x (#173). -->
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-dataset-hosting</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-dataset-hosting-rdf4j</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-shacl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.kogn.rdf</groupId>
            <artifactId>rdf-shacl-rdf4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-rio-turtle</artifactId>
        </dependency>
        <!-- Explizit statt nur transitiv (ueber rdf4j) - #81-Muster: WARN-Log bei mehrwertigen,
             stillschweigend auf den ersten Wert reduzierten Feldern. SHACL gated nur Writes, ein
             store-first geschriebener Actor kann also mehrere arknet:name/
             arknet:description/rdf:type-Tripel tragen, obwohl actor-shapes.ttl sie einwertig
             fordert. Version aus dem rdf4j-bom gemanaged. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Test-only: the shared DatasetLifecycle/DatasetHandle/DatasetTx decorators
             ActorServiceRealStoreConcurrencyTest uses to pin the interleaving of two writers
             against a real on-disk store (#117). A normal main-scope artifact consumed at test
             scope - this codebase uses no test-jar classifier anywhere. -->
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-persistence-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test-only: no SLF4J binding is otherwise on this module's classpath (WARN calls are
             silent NOP-logger no-ops without it), so the row-multiplication regression test needs a
             real backend to attach a ListAppender to and assert the WARN was actually logged, not
             merely that the picked value happens to be valid. Version matches the bounded-context
             adapter's (the pattern this one follows). -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.6.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
