##############################################################################
#  arknet - Architecture Knowledge Net
#  Ubiquitous-Language SHACL Shapes  :  Version 0.1.0
#
#  Validates the ubiquitous-language bounded context: glossary terms modelled
#  as skos:Concept (W3C SKOS) instead of bare strings, grouped into per-workspace
#  glossaries (skos:ConceptScheme).
#
#  Named PropertyShapes fuer RDF4J SHACL Sail Kompatibilitaet.
##############################################################################

@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix arkddd:   <https://w3id.org/arknet/ddd#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix arkres:  <https://w3id.org/arknet/resource#> .
@prefix ulshapes: <https://w3id.org/arknet/shapes/ul#> .


##############################################################################
#  TERM (skos:Concept) SHAPES
##############################################################################

ulshapes:TermShape
    a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property ulshapes:Term-prefLabel ;
    sh:property ulshapes:Term-definition ;
    sh:property ulshapes:Term-inScheme ;
    sh:property ulshapes:Term-broader ;
    sh:property ulshapes:Term-related ;
    sh:sparql   ulshapes:Term-broader-notSelf ,
                ulshapes:Term-related-notSelf ,
                ulshapes:Term-broader-noCycle ,
                ulshapes:Term-prefLabel-oneWord .

# Not blank: at least one character that is no white space, no separator (incl. the no-break
# space) and no control character - stricter than, never looser than, Java's String.isBlank().
ulshapes:Term-prefLabel
    a sh:PropertyShape ;
    sh:path     skos:prefLabel ;
    sh:minCount 1 ;
    sh:minLength 1 ;
    sh:pattern  "[^\\s\\p{Z}\\p{Cc}]" ;
    sh:uniqueLang true ;
    sh:message  "A glossary term (skos:Concept) needs at least one skos:prefLabel (the term), and none of them may be blank. At most one skos:prefLabel per language tag (SKOS S14) - several untagged or same-language-tagged prefLabels on one term are not allowed, but several DIFFERENT language tags are (a term may be labelled in several languages)."@en , "Ein Glossar-Begriff (skos:Concept) braucht mindestens ein skos:prefLabel (der Fachbegriff), und keines davon darf leer sein. Hoechstens ein skos:prefLabel je Sprach-Tag (SKOS S14) - mehrere untagged oder gleichsprachige prefLabels an einem Begriff sind nicht erlaubt, mehrere VERSCHIEDENE Sprach-Tags dagegen schon (ein Begriff darf mehrsprachig benannt sein)."@de ;
    sh:severity sh:Violation .

ulshapes:Term-definition
    a sh:PropertyShape ;
    sh:path     skos:definition ;
    sh:minCount 1 ;
    sh:minLength 1 ;
    sh:pattern  "[^\\s\\p{Z}\\p{Cc}]" ;
    sh:uniqueLang true ;
    sh:message  "A glossary term needs at least one skos:definition, and none of them may be blank. At most one skos:definition per language tag (SKOS S14) - several untagged or same-language-tagged definitions on one term are not allowed, but several DIFFERENT language tags are (a term's meaning may be explained in several languages)."@en , "Hoechstens ein skos:definition je Sprach-Tag (SKOS S14) - mehrere untagged oder gleichsprachige Definitionen an einem Begriff sind nicht erlaubt, mehrere VERSCHIEDENE Sprach-Tags dagegen schon (die Bedeutung eines Begriffs darf mehrsprachig erklaert sein)."@de ;
    sh:severity sh:Violation .

ulshapes:Term-inScheme
    a sh:PropertyShape ;
    sh:path     skos:inScheme ;
    sh:minCount 1 ;
    sh:class    skos:ConceptScheme ;
    sh:message  "Best practice: A term should be placed in a glossary (skos:ConceptScheme) via skos:inScheme."@en , "Best Practice: Ein Begriff sollte via skos:inScheme in einem Glossar (skos:ConceptScheme) liegen."@de ;
    sh:severity sh:Warning .

ulshapes:Term-broader
    a sh:PropertyShape ;
    sh:path     skos:broader ;
    sh:maxCount 1 ;
    sh:class    skos:Concept ;
    sh:nodeKind sh:IRI ;
    sh:message  "skos:broader is optional but, if present, must reference exactly one other skos:Concept (IRI) - the term's single broader (superordinate) term."@en , "skos:broader ist optional, muss aber, falls vorhanden, genau einen anderen skos:Concept (IRI) referenzieren - den einen uebergeordneten (broader) Begriff des Begriffs."@de ;
    sh:severity sh:Violation .

ulshapes:Term-related
    a sh:PropertyShape ;
    sh:path     skos:related ;
    sh:class    skos:Concept ;
    sh:nodeKind sh:IRI ;
    sh:message  "skos:related is optional and may name several terms, but every value must be another skos:Concept (IRI) - an associative, non-hierarchical relation between two terms. Use skos:broader instead when one term specializes the other."@en , "skos:related ist optional und darf mehrere Begriffe nennen, jeder Wert muss aber ein anderer skos:Concept (IRI) sein - eine assoziative, nicht-hierarchische Beziehung zwischen zwei Begriffen. Wenn ein Begriff den anderen spezialisiert, gehoert dorthin skos:broader."@de ;
    sh:severity sh:Violation .

# SPARQL-based constraints ($this-scoped, one focus node at a time - the same form as
# ashapes:ADR-consideredOption-atMostOneChosen): SHACL Core has no "value is not the focus node" and
# no transitive path check that reports a cycle.

ulshapes:Term-broader-notSelf
    a sh:SPARQLConstraint ;
    sh:message  "A glossary term must not be its own broader term (skos:broader)."@en , "Ein Glossar-Begriff darf nicht sein eigener uebergeordneter Begriff sein (skos:broader)."@de ;
    sh:severity sh:Violation ;
    sh:select   """
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        SELECT $this
        WHERE { $this skos:broader $this . }
    """ .

ulshapes:Term-related-notSelf
    a sh:SPARQLConstraint ;
    sh:message  "A glossary term must not be related to itself (skos:related)."@en , "Ein Glossar-Begriff darf nicht mit sich selbst verwandt sein (skos:related)."@de ;
    sh:severity sh:Violation ;
    sh:select   """
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        SELECT $this
        WHERE { $this skos:related $this . }
    """ .

ulshapes:Term-broader-noCycle
    a sh:SPARQLConstraint ;
    sh:message  "The skos:broader chain of a glossary term must not lead back to the term - a cycle of broader terms is not allowed."@en , "Die skos:broader-Kette eines Glossar-Begriffs darf nicht zu ihm zurueckfuehren - ein Zyklus uebergeordneter Begriffe ist nicht erlaubt."@de ;
    sh:severity sh:Violation ;
    sh:select   """
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        SELECT $this
        WHERE { $this skos:broader ?next . ?next skos:broader+ $this . }
    """ .

# The term is one word: its skos:prefLabel carries the same lexical form under every language tag;
# only the definition is translated (kogn-io/arknet#502).
ulshapes:Term-prefLabel-oneWord
    a sh:SPARQLConstraint ;
    sh:message  "A glossary term carries one word under every language tag: all its skos:prefLabel values must have the same text, only the definition is translated."@en , "Ein Glossar-Begriff traegt unter jedem Sprach-Tag dasselbe Wort: alle seine skos:prefLabel-Werte muessen denselben Text haben, uebersetzt wird nur die Definition."@de ;
    sh:severity sh:Violation ;
    sh:select   """
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        SELECT DISTINCT $this
        WHERE {
            $this skos:prefLabel ?label1 , ?label2 .
            FILTER (STR(?label1) != STR(?label2))
        }
    """ .


##############################################################################
#  BOUNDED-CONTEXT LINK SHAPE
#
#  arkddd:ubiquitousLanguageTerm verweist jetzt auf einen skos:Concept
#  (breaking: frueher xsd:string). Eigene NodeShape auf arkddd:BoundedContext,
#  damit die Kern-BoundedContext-Shape (arknet-shapes.ttl) unangetastet bleibt.
##############################################################################

ulshapes:BoundedContextTermsShape
    a sh:NodeShape ;
    sh:targetClass arkddd:BoundedContext ;
    sh:property ulshapes:BoundedContext-ubiquitousLanguageTerm ,
                ulshapes:BoundedContext-delimitsTerm .

ulshapes:BoundedContext-ubiquitousLanguageTerm
    a sh:PropertyShape ;
    sh:path     arkddd:ubiquitousLanguageTerm ;
    sh:nodeKind sh:IRI ;
    sh:class    skos:Concept ;
    sh:message  "arkddd:ubiquitousLanguageTerm must reference a skos:Concept (IRI), not a string."@en , "arkddd:ubiquitousLanguageTerm muss auf einen skos:Concept (IRI) verweisen, nicht auf einen String."@de ;
    sh:severity sh:Violation .

ulshapes:BoundedContext-delimitsTerm
    a sh:PropertyShape ;
    sh:path     arkddd:delimitsTerm ;
    sh:nodeKind sh:IRI ;
    sh:class    skos:Concept ;
    sh:message  "arkddd:delimitsTerm must reference a skos:Concept (IRI), not a string."@en , "arkddd:delimitsTerm muss auf einen skos:Concept (IRI) verweisen, nicht auf einen String."@de ;
    sh:severity sh:Violation .

##############################################################################
#  RULE DATA FOR GENERIC RESOURCE ACCESS (arkres:, arknet-resource.ttl)
#  Not validated: says which classes are resource types, the prefix of their
#  business codes, which edges own their children and how those are ordered.
##############################################################################

skos:Concept a arkres:ResourceType ; arkres:codePrefix "TERM-" .

# END OF UL SHAPES
