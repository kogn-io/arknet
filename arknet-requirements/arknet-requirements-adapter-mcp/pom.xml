<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.hauschel.arknet</groupId>
        <artifactId>arknet-requirements</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>arknet-requirements-adapter-mcp</artifactId>
    <description>In-Adapter (driving): uebersetzt MCP-Tool-Calls auf die arknet-requirements-core In-Ports via Spring-AI @McpTool. Eine Composition Root (arknet-mcp) sammelt die Tools per Bean-Auto-Detection ein.</description>

    <!-- Kein lokales dependencyManagement-Override mehr noetig (#27): seit arknet-mcp auf
         Spring AI 2.0 migriert ist, pinnt arknet-parent mcp-core nicht mehr auf 1.1.0.
         Die spring-ai-bom managed den kompletten MCP-Stack einheitlich auf 2.0.0 (mcp-core
         transitiv ueber spring-ai-mcp-annotations -> io.modelcontextprotocol.sdk:mcp),
         inklusive einer aktuellen jackson-Linie. -->
    <dependencies>
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-requirements-core</artifactId>
        </dependency>
        <!-- In-Adapter -> fremder In-Port (issue #77 Nachtrag): der In-Adapter ist das Tor zum
             requirements-BC, nicht dessen Core - eine Abhaengigkeit hierher auf einen anderen
             BCs In-Port verletzt die Invariante "kein *-core* haengt an einem anderen BC" nicht
             (die gilt fuer die *-core-Module, siehe arknet-architecture-tests in CLAUDE.md).
             Genutzt nur fuer die read-only Anzeige-Aufloesung ResourceId -> TERM-N in
             RequirementMcpTools#format; req_link_term selbst bleibt entkoppelt (TermLookup). -->
        <dependency>
            <groupId>de.hauschel.arknet</groupId>
            <artifactId>arknet-ubiquitous-language-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-mcp-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
